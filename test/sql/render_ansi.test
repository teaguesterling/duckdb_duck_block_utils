# name: test/sql/render_ansi.test
# description: test duck_blocks_render_ansi C++ renderer (width-aware ANSI output)
# group: [sql]

require duck_block_utils

require parquet

require json

# Strip SGR escapes helper used throughout: regexp_replace(l, chr(27)||'\[[0-9;]*m', '', 'g')

# test-local generic block constructor
statement ok
CREATE MACRO tb(t, c, a) AS
  {kind: 'block', element_type: t, content: c, level: 1, encoding: 'text',
   attributes: a, element_order: 1}::duck_block;

# tb with an explicit level, for the container-shaped list tests below: a
# contentless `list` opens a scope and its `list_item` children carry the words,
# so the LEVEL is the structure and cannot be left at tb's constant 1.
statement ok
CREATE MACRO lvb(t, c, lv) AS
  {kind: 'block', element_type: t, content: c, level: lv, encoding: 'text',
   attributes: MAP{}, element_order: 1}::duck_block;

# ============================================================================
# duck_block_terminal_width
# ============================================================================

query I
SELECT duck_block_terminal_width() >= 20;
----
true

# ============================================================================
# Basic rendering
# ============================================================================

query I
SELECT r LIKE '%Hello%' AND r LIKE '%world%' AND position(chr(27) IN r) > 0
FROM (SELECT duck_blocks_render_ansi(duck_block_heading(1, 'Hello') || duck_block_paragraph('world')) AS r);
----
true

# NULL in, NULL out
query I
SELECT duck_blocks_render_ansi(NULL) IS NULL;
----
true

# Explicit width <= 0 means auto-detect (still renders)
query I
SELECT duck_blocks_render_ansi(duck_block_paragraph('hi'), 0) LIKE '%hi%';
----
true

# ============================================================================
# Structured inline elements are styled by element_type (format-agnostic)
# ============================================================================

# bold/italic/code children render with targeted SGR; link carries its href;
# content is taken literally (no markdown parsing anywhere)
query I
SELECT r LIKE '%' || chr(27) || '[1mbold' || chr(27) || '[22m%'
   AND r LIKE '%' || chr(27) || '[3mem' || chr(27) || '[23m%'
   AND r LIKE '%' || chr(27) || '[38;5;203mcode' || chr(27) || '[39m%'
   AND r LIKE '%duckdb.org%'
FROM (SELECT duck_blocks_render_ansi(duck_block_paragraph([
    duck_block_text('has '), duck_block_bold('bold'), duck_block_text(' '), duck_block_italic('em'),
    duck_block_text(' '), duck_block_inline_code('code'), duck_block_text(' '),
    duck_block_link('https://duckdb.org', 'site')])) AS r);
----
true

# a paragraph built from inline children renders (regression: previously the
# inline children were skipped and this produced empty output)
query I
SELECT length(duck_blocks_render_ansi(duck_block_paragraph([duck_block_text('x'), duck_block_bold('y')]))) > 0;
----
true

# markdown syntax sitting in a content string is rendered LITERALLY -- the
# renderer has no awareness of markdown (that is a producer's concern)
query I
SELECT r LIKE '%**not bold**%' AND position(chr(27) || '[1m' IN r) = 0
FROM (SELECT duck_blocks_render_ansi(duck_block_paragraph('**not bold**')) AS r);
----
true

# nested inlines: italic inside a link keeps both the link color and italic
query I
SELECT r LIKE '%' || chr(27) || '[4;38;5;75m%' || chr(27) || '[3mdeep' || chr(27) || '[23m%'
FROM (SELECT duck_blocks_render_ansi(duck_block_paragraph([duck_block_link('https://x.io', [duck_block_italic('deep')])])) AS r);
----
true

# ============================================================================
# Fixture: canonical structured document renders with styling, no markdown
# ============================================================================

query I
SELECT r LIKE '%Duck Blocks Fixture%'
   AND r LIKE '%' || chr(27) || '[1mbold' || chr(27) || '[22m%'
   AND r NOT LIKE '%**%'
FROM (
  SELECT duck_blocks_render_ansi(
    (SELECT list({'kind': kind, 'element_type': element_type, 'content': content,
                  'level': level, 'encoding': encoding, 'attributes': attributes,
                  'element_order': element_order}::duck_block ORDER BY element_order)
     FROM read_parquet('test/fixtures/sample_document.parquet'))
  ) AS r
);
----
true

# ============================================================================
# Word wrap honors display width
# ============================================================================

# every rendered line fits in the requested width (after stripping escapes)
query I
SELECT max(length(regexp_replace(l, chr(27) || '\[[0-9;]*m', '', 'g'))) <= 40
   AND count(*) > 1
FROM (
  SELECT unnest(string_split(duck_blocks_render_ansi(duck_block_paragraph(repeat('word ', 30)), 40), chr(10))) AS l
);
----
true

# very long unbreakable words are hard-broken rather than overflowing
query I
SELECT max(length(regexp_replace(l, chr(27) || '\[[0-9;]*m', '', 'g'))) <= 20
FROM (
  SELECT unnest(string_split(duck_blocks_render_ansi(duck_block_paragraph(repeat('x', 95)), 20), chr(10))) AS l
);
----
true

# CJK characters count as two columns: 100 display-columns of text at width 20
# must span at least 5 lines (codepoint-counting would produce ~3)
query I
SELECT count(*) >= 5
FROM (
  SELECT unnest(string_split(duck_blocks_render_ansi(duck_block_paragraph(repeat('你好 ', 20)), 20), chr(10))) AS l
)
WHERE length(l) > 0;
----
true

# ============================================================================
# SGR state survives line breaks
# ============================================================================

# a bold inline that wraps re-opens bold at the start of the continuation line
query I
SELECT lines[2] LIKE chr(27) || '[1m%'
FROM (
  SELECT string_split(duck_blocks_render_ansi(duck_block_paragraph([duck_block_bold(repeat('bold ', 20))]), 30), chr(10)) AS lines
);
----
true

# ============================================================================
# Lists: hanging indent
# ============================================================================

query I
SELECT r LIKE '%1.%' AND r LIKE '%2.%'
FROM (SELECT duck_blocks_render_ansi([tb('list', '["first", "second"]', MAP {'ordered': 'true'})], 60) AS r);
----
true

# ----------------------------------------------------------------------------
# A nested sublist must not swallow the items after it.
#
# The renderer takes a list_item's indent from `list_stack.size() - 1`, and the
# loop that closes a list whose scope a block has left used to EXCLUDE
# list_item -- so an item could never pop a list. After a sublist, the outer
# list's next item therefore kept the inner depth and rendered as a child of
# its own sibling:
#
#     - alpha            •  alpha
#       - nested one       •  nested one
#     - beta               •  beta      <-- wrong, one level too deep
#
# The parse was never at fault: `beta` comes back at level 2, a sibling of
# `alpha`. The level test alone is the right rule, because a container always
# has a LOWER level than the items it holds (a `list` at 1 holds items at 2),
# so `GetDepth(item) <= back().level` is false for an item's own list and true
# only for lists it has left. Found downstream in duckeye, where a two-item
# list with one sublist rendered three bullets at two indents instead of three.
#
# Asserted as exact indent strings rather than a LIKE, because the bug moved an
# indent by exactly two columns and a prefix match would have passed on both.
# ----------------------------------------------------------------------------

query I
SELECT regexp_replace(l, chr(27) || '\[[0-9;]*m', '', 'g') AS line FROM (
  SELECT unnest(string_split(duck_blocks_render_ansi([
    lvb('list', '', 1),
    lvb('list_item', 'alpha', 2),
    lvb('list', '', 3),
    lvb('list_item', 'nested one', 4),
    lvb('list_item', 'beta', 2)
  ], 60), chr(10))) AS l
);
----
  • alpha
    • nested one
  • beta

# Two levels deep, popping TWO lists at once: `d` leaves both the level-5 and
# the level-3 list. A fix that popped only the innermost would render `d` at
# `nested one`'s depth and pass the three-line case above.
query I
SELECT regexp_replace(l, chr(27) || '\[[0-9;]*m', '', 'g') AS line FROM (
  SELECT unnest(string_split(duck_blocks_render_ansi([
    lvb('list', '', 1),
    lvb('list_item', 'a', 2),
    lvb('list', '', 3),
    lvb('list_item', 'b', 4),
    lvb('list', '', 5),
    lvb('list_item', 'c', 6),
    lvb('list_item', 'd', 2)
  ], 60), chr(10))) AS l
);
----
  • a
    • b
      • c
  • d

# wrapped continuation lines of a bullet item are indented past the bullet
query I
SELECT regexp_replace(lines[2], chr(27) || '\[[0-9;]*m', '', 'g') LIKE '    %'
FROM (
  SELECT string_split(duck_blocks_render_ansi([tb('list', '["' || repeat('item ', 20) || '"]', MAP {'ordered': 'false'})], 30), chr(10)) AS lines
);
----
true

# ============================================================================
# Blockquote: prefix on every wrapped line
# ============================================================================

query I
SELECT length(r) - length(replace(r, '▌', '')) >= 2
FROM (SELECT duck_blocks_render_ansi([tb('blockquote', repeat('quote ', 20), MAP {}::MAP(VARCHAR, VARCHAR))], 30) AS r);
----
true

# ============================================================================
# Tables: fit to width
# ============================================================================

# a table whose natural width exceeds the budget wraps cells instead of overflowing
query I
SELECT max(length(regexp_replace(l, chr(27) || '\[[0-9;]*m', '', 'g'))) <= 40
   AND bool_or(l LIKE '%┼%')
FROM (
  SELECT unnest(string_split(duck_blocks_render_ansi(
    [tb('table', '{"headers": ["Name", "Description"], "rows": [["alpha", "' || repeat('lorem ipsum ', 8) || '"], ["beta", "short"]]}', MAP {}::MAP(VARCHAR, VARCHAR))],
    40), chr(10))) AS l
)
WHERE length(l) > 0;
----
true

# narrow table keeps natural column widths and stays aligned
query I
SELECT r LIKE '%Name%' AND r LIKE '%─┼─%' AND r LIKE '%Ada%'
FROM (SELECT duck_blocks_render_ansi(
  [tb('table', '{"headers": ["Name", "Age"], "rows": [["Ada", "36"], ["Grace", "85"]]}', MAP {}::MAP(VARCHAR, VARCHAR))],
  60) AS r);
----
true

# ============================================================================
# Inline elements are skipped, metadata suppressed
# ============================================================================

query I
SELECT duck_blocks_render_ansi([duck_block_text('loose inline')[1]], 60) = '';
----
true

query I
SELECT duck_blocks_render_ansi([tb('metadata', 'title: x', MAP {}::MAP(VARCHAR, VARCHAR))], 60) = '';
----
true

# ============================================================================
# Theme Palettes: Dark vs Light
# ============================================================================

# Dark theme uses vibrant 256 colors (H1: 219 pink, code: 203 salmon, link: 75 blue)
query I
SELECT r LIKE '%' || chr(27) || '[1;38;5;219m%'
   AND r LIKE '%' || chr(27) || '[38;5;203mcode' || chr(27) || '[39m%'
   AND r LIKE '%' || chr(27) || '[4;38;5;75m%'
FROM (SELECT duck_blocks_render_ansi(
    duck_block_heading(1, 'Title') || duck_block_paragraph([duck_block_inline_code('code'), duck_block_link('https://example.com', 'link')]),
    'dark') AS r);
----
true

# Light theme uses deep high-contrast colors (H1: 125 ruby, code: 160 crimson, link: 27 royal blue)
query I
SELECT r LIKE '%' || chr(27) || '[1;38;5;125m%'
   AND r LIKE '%' || chr(27) || '[38;5;160mcode' || chr(27) || '[39m%'
   AND r LIKE '%' || chr(27) || '[4;38;5;27m%'
FROM (SELECT duck_blocks_render_ansi(
    duck_block_heading(1, 'Title') || duck_block_paragraph([duck_block_inline_code('code'), duck_block_link('https://example.com', 'link')]),
    'light') AS r);
----
true

# Overload with width and theme: duck_blocks_render_ansi(blocks, width, theme)
query I
SELECT r LIKE '%' || chr(27) || '[1;38;5;125m%'
FROM (SELECT duck_blocks_render_ansi(duck_block_heading(1, 'Title'), 60, 'light') AS r);
----
true

# Overload with theme and width: duck_blocks_render_ansi(blocks, theme, width)
query I
SELECT r LIKE '%' || chr(27) || '[1;38;5;125m%'
FROM (SELECT duck_blocks_render_ansi(duck_block_heading(1, 'Title'), 'light', 60) AS r);
----
true

# Macro duck_blocks_render with theme
statement ok
PRAGMA duck_block_render;

query I
SELECT r LIKE '%' || chr(27) || '[1;38;5;125m%'
FROM (SELECT duck_blocks_render(duck_block_heading(1, 'Title'), theme := 'light') AS r);
----
true


# ============================================================================
# figure / caption rendering
# figure is a transparent container; caption is styled so a reader can tell it
# from the prose around it. Without this a caption renders as ordinary body text.
# ============================================================================

query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"capword"}]}]],[{"t":"Para","c":[{"t":"Str","c":"bodyword"}]}]]}]')) LIKE '%bodyword%';
----
true

query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"capword"}]}]],[{"t":"Para","c":[{"t":"Str","c":"bodyword"}]}]]}]')) LIKE '%capword%';
----
true

# the caption is dimmed (SGR 2); the body paragraph is not
query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"capword"}]}]],[{"t":"Para","c":[{"t":"Str","c":"bodyword"}]}]]}]')) LIKE '%' || chr(27) || '[2m%capword%';
----
true

query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"capword"}]}]],[{"t":"Para","c":[{"t":"Str","c":"bodyword"}]}]]}]')) LIKE '%' || chr(27) || '[2m%bodyword%';
----
false

# A caption may precede its content as well as follow it. `figure` emits
# content-then-caption because an image's caption belongs below it; a
# <details>/<summary> label belongs above the body. The caption scope opens at
# the marker and closes at the first block back at its own level, so position
# is the emitter's choice and not a property of `caption`.
query I
SELECT duck_blocks_render_ansi([
  {'kind':'block','element_type':'section','content':'','level':1,'encoding':'text','attributes':MAP{'role':'group'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'caption','content':'','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'SUMMARY','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'BODY','level':2,'encoding':'text','attributes':MAP{},'element_order':3}::duck_block
]) LIKE '%' || chr(27) || '[2m%SUMMARY%';
----
true

# ...and the content that follows the caption scope is NOT dimmed.
# NOTE the assertion shape: '%<dim>%BODY%' would MATCH here, because the dim
# code appears earlier in the string before SUMMARY. It has to test for dim
# ADJACENT to BODY, which is what a dimmed line would actually look like.
query I
SELECT duck_blocks_render_ansi([
  {'kind':'block','element_type':'section','content':'','level':1,'encoding':'text','attributes':MAP{'role':'group'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'caption','content':'','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'SUMMARY','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'BODY','level':2,'encoding':'text','attributes':MAP{},'element_order':3}::duck_block
]) LIKE '%' || chr(27) || '[2mBODY%';
----
false

# Document metadata must not render as body content. Skipping only the value
# MARKER is insufficient: a MetaBlocks value has kind='block' CHILDREN, which
# then rendered as prose -- an abstract appearing in the rendered document.
query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks(
  '{"meta":{"abstract":{"t":"MetaBlocks","c":[{"t":"Para","c":[{"t":"Str","c":"BLOCKLEAK"}]}]},
            "title":{"t":"MetaInlines","c":[{"t":"Str","c":"INLEAK"}]}},
    "blocks":[{"t":"Para","c":[{"t":"Str","c":"REALBODY"}]}]}')) LIKE '%LEAK%';
----
false

query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks(
  '{"meta":{"abstract":{"t":"MetaBlocks","c":[{"t":"Para","c":[{"t":"Str","c":"BLOCKLEAK"}]}]}},
    "blocks":[{"t":"Para","c":[{"t":"Str","c":"REALBODY"}]}]}')) LIKE '%REALBODY%';
----
true

# An EXPLICIT level 0 must stay distinct from a NULL level. `metadata` is
# documented at level 0, so a 0-as-NULL sentinel conflates two states that occur
# in real data. Metadata beside a value scope is not swallowed by it.
query I
SELECT render_probe LIKE '%BODY%' AND render_probe NOT LIKE '%META0%'
FROM (SELECT duck_blocks_render_ansi([
  {'kind':'value','element_type':'string','content':'M','level':1,'encoding':'text',
   'attributes':MAP{'key':'k'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'metadata','content':'META0','level':0,'encoding':'yaml',
   'attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'BODY','level':1,'encoding':'text',
   'attributes':MAP{},'element_order':2}::duck_block]) AS render_probe);
----
true

# ============================================================================
# A TRANSPARENT CONTAINER MUST NOT DISCARD ITS OWN CONTENT.
#
# `figure` and `caption` pass straight through so their children render
# themselves -- but spec v1's content rule permits a container to carry its text
# directly when it has a single text child, and the pass-through dropped it. A
# figure or caption carrying content rendered as NOTHING, while
# duck_blocks_to_text kept it, so the two disagreed about whether the document
# had any text.
#
# Found by applying the webbed session's own sweep result to this renderer: they
# had loose text dropped inside a transparent wrapper. "Transparent pass-through
# discards what it does not stop to look at" is the shape, not anything
# HTML-specific.
# ============================================================================

query III
SELECT duck_blocks_render_ansi([{'kind':'block','element_type':'figure','content':'CONTENT','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block], 40) LIKE '%CONTENT%',
       duck_blocks_render_ansi([{'kind':'block','element_type':'caption','content':'CONTENT','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block], 40) LIKE '%CONTENT%',
       duck_blocks_render_ansi([{'kind':'block','element_type':'list','content':'CONTENT','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block], 40) LIKE '%CONTENT%';
----
true	true	true

# DISCRIMINATING: an EMPTY figure/caption must stay transparent. Rendering the
# container itself would also make the assertions above pass, while emitting a
# stray blank line for every figure in every document.
query I
SELECT replace(regexp_replace(duck_blocks_render_ansi(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Str","c":"body"}]}]]}]}'), 40), '\x1b\[[0-9;]*m', '', 'g'), chr(10), '|');
----
body||cap

# The renderer and the text extractor must agree that the document HAS text.
# They disagreed before: render said nothing, to_text said CONTENT.
query I
SELECT (duck_blocks_render_ansi([{'kind':'block','element_type':'figure','content':'CONTENT','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block], 40) LIKE '%CONTENT%')
     = (duck_blocks_to_text([{'kind':'block','element_type':'figure','content':'CONTENT','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block]) LIKE '%CONTENT%');
----
true
