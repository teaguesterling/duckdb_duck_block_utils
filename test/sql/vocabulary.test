# name: test/sql/vocabulary.test
# description: vocabulary introspection and the duck_block spec version marker
# group: [sql]

require duck_block_utils

# ============================================================================
# Introspection -- so other extensions can ASSERT they match the vocabulary
# instead of mirroring a header that silently drifts.
# ============================================================================

query I
SELECT duck_block_kind_names();
----
[block, inline, value]

query I
SELECT list_contains(duck_block_type_names(), 'figure') AND list_contains(duck_block_type_names(), 'caption')
   AND list_contains(duck_block_type_names(), 'generic');
----
true

# The spec version, PINNED. This asserted `length(...) > 0` until 2026-08-31,
# which passes for '2.0', for '1.1', and for 'banana' -- the exact adjacent-
# assertion shape this repo spent a week finding in other people's code, sitting
# in the test suite of the repo that OWNS the spec. Four extensions vendor this
# value and assert against it; nothing here checked what it was.
#
# Pinning the literal is deliberate: a bump must edit this line, which makes it
# reviewable, the same ratchet the pandoc and spec ledgers use.
#
# (Prompted by webbed reporting the same gap in their own conformance test --
# "no wrong assertion to correct, just an absent one, which is worse in the
# quiet way.")
query I
SELECT duck_block_spec_version();
----
6.1

# ...and it must be well-formed MAJOR.MINOR, since the contract in the header
# says consumers assert major equality plus a minor floor. A version that does
# not split into two integers makes that assertion unwritable.
query II
SELECT try_cast(split_part(duck_block_spec_version(), '.', 1) AS INTEGER) IS NOT NULL,
       try_cast(split_part(duck_block_spec_version(), '.', 2) AS INTEGER) IS NOT NULL;
----
true	true

# every kind a converter emits is in the declared set -- the assertion panduck
# and webbed can run against this rather than a hardcoded list.
#
# NOTE WHICH DIRECTION THIS IS. It tests emitted-is-a-subset-of-declared. The
# CONVERSE is asserted below and is the half that matters more, because a kind can
# be declared and produced by nothing -- which is exactly the state webbed and
# panduck are in for `value`: the vocabulary offers it, their readers emit none,
# and every document's title is discarded.
#
# duckdb_markdown's framing, after finding both shapes in their own repo: "which
# kinds EXIST" and "what this reader EMITS" are different claims that happen to
# coincide, and calling the second one "valid" is the invitation to copy it as a
# conformance rule. That is how this repo's published macro became a validator
# that rejected the correct fix.
query I
SELECT count(*) FROM (
  SELECT unnest(pandoc_ast_to_blocks('{"meta":{"t":{"t":"MetaBool","c":true}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"x"}]}]}')) AS b
) WHERE NOT list_contains(duck_block_kind_names(), b.kind);
----
0


# THE CONVERSE: every DECLARED kind must actually be emitted by something.
#
# A declared-but-unreachable kind is the `UNREACHABLE` failure one level up -- the
# vocabulary offers a slot that no producer fills, so consumers never learn it
# exists and the data that belongs there is silently dropped. That is not
# hypothetical: two of three consuming extensions currently emit no `value` at all.
#
# Driven from duck_block_kind_names(), so a kind added later must be REACHABLE
# rather than merely declared.
query I
WITH emitted AS (
  SELECT list_distinct(list(b.kind)) AS ks
  FROM (SELECT unnest(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaString","c":"T"}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"a "},{"t":"Strong","c":[{"t":"Str","c":"b"}]}]}]}')) AS b)
)
SELECT list_filter(duck_block_kind_names(), k -> NOT list_contains(ks, k)) FROM emitted;
----
[]

# ============================================================================
# Version marker
# ============================================================================

query I
SELECT duck_blocks_version(duck_blocks_stamp(duck_block_paragraph([duck_block_text('x')]))) = duck_block_spec_version();
----
true

# unstamped blocks report NULL rather than guessing
query I
SELECT duck_blocks_version(duck_block_paragraph([duck_block_text('x')])) IS NULL;
----
true

# stamping is additive: the document body is untouched and still first
query I
SELECT duck_blocks_stamp(duck_block_paragraph([duck_block_text('x')]))[1].element_type;
----
paragraph

# the marker is a value element, so block-walking consumers ignore it
query I
SELECT duck_blocks_to_text(duck_blocks_stamp(duck_block_paragraph([duck_block_text('x')])));
----
x

# and it does NOT leak into pandoc document metadata
query I
SELECT duck_blocks_to_pandoc_ast(duck_blocks_stamp(duck_block_paragraph([duck_block_text('x')]))).meta::VARCHAR;
----
{}

# ============================================================================
# Regression: document metadata must not leak into extracted body text.
# The first cut of kind='value' shipped this bug -- duck_blocks_to_text skipped
# `inline` and treated everything else as a block, so value elements fell
# through, and MetaInlines children were then picked up as a stray inline run.
# ============================================================================

query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks(
  '{"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"LEAK"}]},
            "tags":{"t":"MetaList","c":[{"t":"MetaInlines","c":[{"t":"Str","c":"ALSO"}]}]}},
    "blocks":[{"t":"Para","c":[{"t":"Str","c":"Body"}]}]}'));
----
Body

# a heading TOC must not pick up metadata either
query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_toc(pandoc_ast_to_blocks(
  '{"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"LEAK"}]}},
    "blocks":[{"t":"Header","c":[1,["",[],[]],[{"t":"Str","c":"Real"}]]}]}'))) AS t)
WHERE (t).title = 'LEAK';
----
0

# ============================================================================
# section -- semantic sectioning container
# One type plus attributes['role'], following the established convention:
# heading+heading_level (not h1..h6), list+list_type (not bullet_list/
# ordered_list), quoted+quote_type. NOT `div`: HTML's spec calls div "an
# element of last resort", so mapping a semantic container onto it stashes the
# truth in an attribute while the type says something false.
# ============================================================================

query I
SELECT list_contains(duck_block_type_names(), 'section');
----
true

# a section round-trips to pandoc as a Div carrying its role as a class,
# which is pandoc's nearest honest equivalent -- it has no Section constructor
query I
SELECT duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'section','content':'','level':1,'encoding':'text',
   'attributes':MAP{'role':'article','id':'a1'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'Body','level':2,'encoding':'text',
   'attributes':MAP{},'element_order':1}::duck_block
]) LIKE '%"t":"Div"%';
----
true

query I
SELECT duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'section','content':'','level':1,'encoding':'text',
   'attributes':MAP{'role':'article','id':'a1'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'Body','level':2,'encoding':'text',
   'attributes':MAP{},'element_order':1}::duck_block
]) LIKE '%article%';
----
true

# children are preserved, not dropped
query I
SELECT duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'section','content':'','level':1,'encoding':'text',
   'attributes':MAP{'role':'section'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'Body','level':2,'encoding':'text',
   'attributes':MAP{},'element_order':1}::duck_block
]) LIKE '%Body%';
----
true

# ============================================================================
# Validation is where this extension owns the spec, so it must know the whole
# vocabulary -- and must check FIELD SEMANTICS, not just field presence.
# Names alone are not a specification: `level` was read three different ways by
# three implementations while every one of them used the documented name.
# ============================================================================

# REGRESSION: kind='value' was added without updating the validator, so every
# document carrying metadata validated as invalid.
query I
SELECT (duck_blocks_validate(pandoc_ast_to_blocks(
  '{"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"T"}]}},
    "blocks":[{"t":"Para","c":[{"t":"Str","c":"B"}]}]}'))).valid;
----
true

# the kind set comes from the vocabulary, so a new kind cannot orphan it again
query I
SELECT (duck_blocks_validate([
  {'kind':'nonsense','element_type':'paragraph','content':'x','level':1,'encoding':'text',
   'attributes':MAP{},'element_order':0}::duck_block])).valid;
----
false

# SEMANTIC vs STRUCTURAL: a heading's semantic level (h1/h2) belongs in
# attributes['heading_level']; `level` is its structural depth in the document
# tree. A top-level h2 is level 1 with heading_level 2 -- the two numbers are
# independent and confusing them is the oldest trap in this vocabulary.
query I
SELECT (duck_blocks_validate([
  {'kind':'block','element_type':'heading','content':'H','level':1,'encoding':'text',
   'attributes':MAP{'heading_level':'2'},'element_order':0}::duck_block])).valid;
----
true

# And a NULL level is now an ERROR, not a convention. `level` and adjacency
# together describe the whole document tree, so an element without one cannot be
# placed in it. Nothing checked this until 2026-08-31, which is how a
# NULL-at-top-level convention spread to four extensions unchallenged.
query II
SELECT (duck_blocks_validate([
  {'kind':'block','element_type':'heading','content':'H','level':NULL,'encoding':'text',
   'attributes':MAP{'heading_level':'2'},'element_order':0}::duck_block])).valid,
       (duck_blocks_validate([
  {'kind':'block','element_type':'heading','content':'H','level':NULL,'encoding':'text',
   'attributes':MAP{'heading_level':'2'},'element_order':0}::duck_block])).errors[1].field;
----
false	level

# A heading carrying BOTH numbers is CORRECT, not a conflict: level 3 is its
# structural depth, heading_level 1 its semantic rank. The linter used to warn on
# exactly this, telling producers `level` "should be NULL on headings" -- a rule
# encoding the unapproved NULL convention, arguing against the spec it exists to
# enforce. It flagged conforming data, so it is gone.
query I
SELECT len(duck_blocks_lint([
  {'kind':'block','element_type':'heading','content':'H','level':3,'encoding':'text',
   'attributes':MAP{'heading_level':'1'},'element_order':0}::duck_block]));
----
0

# a spec-conformant heading -- level NULL -- warns about nothing
query I
SELECT len(duck_blocks_lint([
  {'kind':'block','element_type':'heading','content':'H','level':1,'encoding':'text',
   'attributes':MAP{'heading_level':'1'},'element_order':0}::duck_block]));
----
0

# SEMANTIC: `generic` exists to make a gap visible, so it must say what it was.
query I
SELECT len(duck_blocks_lint([
  {'kind':'block','element_type':'generic','content':'{}','level':1,'encoding':'json',
   'attributes':MAP{},'element_order':0}::duck_block])) > 0;
----
true

# ...and a generic that names what it stood in for is fine
query I
SELECT len(duck_blocks_lint([
  {'kind':'block','element_type':'generic','content':'{}','level':1,'encoding':'json',
   'attributes':MAP{'source_type':'FutureThing'},'element_order':0}::duck_block]));
----
0

# SEMANTIC: a value element inside a map must carry its key.
query I
SELECT (duck_blocks_validate([
  {'kind':'value','element_type':'string','content':'v','level':1,'encoding':'text',
   'attributes':MAP{'key':'k'},'element_order':0}::duck_block])).valid;
----
true

# ============================================================================
# The builders and the Pandoc converter must agree on `level`.
#
# They did not: pandoc_ast_to_blocks() emitted top-level blocks with level=NULL
# per the spec, while FlattenBlockWithChildren() stamped level=1 on every
# container it built. Children already agreed at 2 -- only the container's own
# level differed, so this is the narrowest possible divergence and still one
# that made the two halves of this extension disagree about a documented field.
# ============================================================================

# a top-level block built by hand carries level 1, like the converter's
query I
SELECT duck_block_paragraph([duck_block_text('a'), duck_block_bold('b')])[1].level;
----
1

# ...and its inline children still sit at 2, unchanged
query I
SELECT duck_block_paragraph([duck_block_text('a'), duck_block_bold('b')])[2].level;
----
2

# builder and converter agree on the CONTAINER's level and its children's depth.
# They differ below that, legitimately: duck_block_bold('b') puts the text in the bold
# element's content, while the converter emits bold plus a text child at 3 --
# the spec's "content is populated iff the container has a single text child".
query I
SELECT duck_block_paragraph([duck_block_text('a'), duck_block_bold('b')])[1].level = 1
   AND pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"a"}]}]')[1].level = 1;
----
true

query I
SELECT duck_block_paragraph([duck_block_text('a'), duck_block_bold('b')])[2].level
     = pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"Code","c":[["",[],[]],"x"]}]}]')[2].level;
----
true

# headings: NULL level, h1-h6 in the attribute, and no lint warning
query I
SELECT duck_block_heading(1, 'T')[1].level;
----
1

query I
SELECT duck_block_heading(1, 'T')[1].attributes['heading_level'];
----
1

query I
SELECT len(duck_blocks_lint(duck_blocks_assemble([duck_block_heading(1, 'Title'), duck_block_paragraph('Text')])));
----
0

# nested blockquotes still carry their depth -- the one call site that passes a
# real level rather than 1 must keep working
query I
SELECT duck_blocks_to_text(duck_block_blockquote('inner')) LIKE '%inner%';
----
true

# ============================================================================
# Metadata must not leak into extracted body text -- ALL metavalue shapes.
#
# The first fix skipped a value element and then resumed at the next block or
# value. That works for MetaInlines/List/Map, whose children are inlines, and
# FAILS for MetaBlocks, whose children ARE blocks -- so it resumed on the
# abstract's own paragraph. Verified one shape, claimed the class.
#
# Now level-scoped: a value at level L consumes everything deeper than L, which
# is the spec's own containment rule and shape-independent.
# ============================================================================

query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks(
  '{"meta":{"abstract":{"t":"MetaBlocks","c":[{"t":"Para","c":[{"t":"Str","c":"BLOCKLEAK"}]}]}},
    "blocks":[{"t":"Para","c":[{"t":"Str","c":"REALBODY"}]}]}'));
----
REALBODY

# every shape at once: inlines, blocks, bool, list, map
query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks(
  '{"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"INLEAK"}]},
            "abstract":{"t":"MetaBlocks","c":[{"t":"Para","c":[{"t":"Str","c":"BLOCKLEAK"}]}]},
            "draft":{"t":"MetaBool","c":true},
            "tags":{"t":"MetaList","c":[{"t":"MetaInlines","c":[{"t":"Str","c":"LISTLEAK"}]}]},
            "author":{"t":"MetaMap","c":{"name":{"t":"MetaInlines","c":[{"t":"Str","c":"MAPLEAK"}]}}}},
    "blocks":[{"t":"Para","c":[{"t":"Str","c":"REALBODY"}]}]}'));
----
REALBODY

# nested MetaBlocks inside a MetaMap -- two levels deep, still contained
query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks(
  '{"meta":{"outer":{"t":"MetaMap","c":{"inner":{"t":"MetaBlocks","c":[{"t":"Para","c":[{"t":"Str","c":"DEEPLEAK"}]}]}}}},
    "blocks":[{"t":"Para","c":[{"t":"Str","c":"REALBODY"}]}]}'));
----
REALBODY

# the TOC must not pick up a heading buried in metadata either
query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_toc(pandoc_ast_to_blocks(
  '{"meta":{"abstract":{"t":"MetaBlocks","c":[{"t":"Header","c":[1,["",[],[]],[{"t":"Str","c":"METAHEAD"}]]}]}},
    "blocks":[{"t":"Header","c":[1,["",[],[]],[{"t":"Str","c":"Real"}]]}]}'))) AS t)
WHERE (t).title = 'METAHEAD';
----
0

# ============================================================================
# `page` -- a physical pagination boundary.
#
# A MARKER, not a container: like `hr`, it carries no content and owns no
# children. element_order already gives grouping ("blocks between marker N and
# N+1"), so a container would re-nest whole documents one level deeper for
# nothing.
#
# It exists because duckeye's PDF path currently fakes page boundaries by
# synthesising `## Page N` MARKDOWN HEADINGS, which injects physical pagination
# into the semantic heading structure -- duck_blocks_toc_rows then lists "Page 1, Page 2" as
# though they were sections, and duck_blocks_get_section will happily slice on one.
# ============================================================================

query I
SELECT list_contains(duck_block_type_names(), 'page_break');
----
true

# a page marker carries its number and no content
query I
SELECT (duck_blocks_validate([
  {'kind':'block','element_type':'page_break','content':'','level':1,'encoding':'text',
   'attributes':MAP{'page_number':'3'},'element_order':0}::duck_block])).valid;
----
true

# it is NOT a heading: the TOC must ignore it
query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_toc([
  {'kind':'block','element_type':'page_break','content':'','level':1,'encoding':'text',
   'attributes':MAP{'page_number':'1'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'heading','content':'Real','level':1,'encoding':'text',
   'attributes':MAP{'heading_level':'1'},'element_order':1}::duck_block])) AS t);
----
1

# ...and contributes no text
query I
SELECT duck_blocks_to_text([
  {'kind':'block','element_type':'page_break','content':'','level':1,'encoding':'text',
   'attributes':MAP{'page_number':'1'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'Body','level':1,'encoding':'text',
   'attributes':MAP{},'element_order':1}::duck_block]);
----
Body

# Pandoc has no page constructor, so it exports as a Div carrying the number --
# its nearest honest equivalent, and what a `page` class means to a reader
query I
SELECT duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'page_break','content':'','level':1,'encoding':'text',
   'attributes':MAP{'page_number':'7'},'element_order':0}::duck_block]) LIKE '%"t":"Div"%';
----
true

query I
SELECT duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'page_break','content':'','level':1,'encoding':'text',
   'attributes':MAP{'page_number':'7'},'element_order':0}::duck_block]) LIKE '%page%';
----
true

# ============================================================================
# Inline `generic` passes its children through. This is deliberate, not luck.
#
# The asymmetry with BLOCK generic is about whether CONTENT survives, not about
# how important the type is:
#
#   block generic   content is a verbatim fragment, NO children -- dropping the
#                   element loses everything, so a consumer must leave a trace
#   inline generic  a marker whose CHILDREN carry the text -- dropping the
#                   wrapper loses only source_type, exactly as dropping `span`
#                   loses only its identity
#
# So a RENDERING may drop the wrapper identity; a TRANSPORT may not. The ANSI
# renderer and text extractor drop it, and should.
#
# The Pandoc exporter did NOT preserve it until this test was written: inline
# generic fell through to a "[generic]" placeholder that destroyed the children's
# text -- the same defect as the "[Underline]" placeholder fixed on the IMPORT
# side, surviving on export because nothing had round-tripped an unmapped inline.
# It now emits a Span carrying source_type as a class.
#
# Neither renderer branches on INLINE_GENERIC -- both reach it by fallthrough.
# These assertions are what make that correct by design rather than by accident,
# found by duckdb_markdown auditing their writer against the vocabulary header.
# ============================================================================

query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks(
  '[{"t":"Para","c":[{"t":"Str","c":"before "},{"t":"Bogus","c":[{"t":"Str","c":"KEPT"}]},{"t":"Str","c":" after"}]}]'));
----
before KEPT after

query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks(
  '[{"t":"Para","c":[{"t":"Str","c":"before "},{"t":"Bogus","c":[{"t":"Str","c":"KEPT"}]},{"t":"Str","c":" after"}]}]'))
  LIKE '%before KEPT after%';
----
true

# the TRANSPORT keeps what the renderings drop -- BOTH the text and the identity
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks(
  '[{"t":"Para","c":[{"t":"Bogus","c":[{"t":"Str","c":"KEPT"}]}]}]')) LIKE '%KEPT%';
----
true

query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks(
  '[{"t":"Para","c":[{"t":"Bogus","c":[{"t":"Str","c":"KEPT"}]}]}]')) LIKE '%Bogus%';
----
true

# and no placeholder survives anywhere
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks(
  '[{"t":"Para","c":[{"t":"Bogus","c":[{"t":"Str","c":"KEPT"}]}]}]')) LIKE '%[generic]%';
----
false

# BLOCK generic is the loud case -- its content has nowhere else to live
query I
SELECT pandoc_ast_to_blocks('[{"t":"FutureThing","c":[1,2]}]')[1].attributes['source_type'];
----
FutureThing

# ============================================================================
# THE PUBLISHED CONFORMANCE MACRO MUST ACCEPT EVERY KIND THIS BUILD EMITS.
#
# docs/duck_blocks_spec.md publishes `duck_block_is_valid` for extensions to copy
# so they can validate WITHOUT depending on duck_block_utils. It read
# `elem.kind IN ('block', 'inline')` until 2026-09-01 -- so copied as written it
# rejected every metadata element as invalid, and the spec's Extension
# Responsibilities said producers MUST set kind to one of those two.
#
# That is the instruction that produces the metadata leak: a producer following it
# has nowhere to put a document's own title and puts it in the body as prose. It is
# the first defect reported to duckdb_markdown this morning, and the canonical spec
# was publishing the instruction to commit it, in MUST language, the whole time.
#
# `value` has existed since spec 3.0. Six documents in this repo restated the
# two-kind definition and I had fixed only the type-definition line.
# ============================================================================

statement ok
CREATE OR REPLACE MACRO duck_block_is_valid(elem) AS (
    elem.kind IN ('block', 'inline', 'value')
    AND elem.element_type IS NOT NULL
    AND elem.level >= 1
    AND elem.element_order >= 0
);

# Every kind the build declares must pass the macro the spec publishes. Driven from
# duck_block_kind_names() rather than a literal, so a kind added later cannot be
# forgotten here the way `value` was forgotten in six files.
query I
SELECT bool_and(duck_block_is_valid({'kind': k, 'element_type': 'paragraph', 'content': 'x',
                                     'level': 1, 'encoding': 'text', 'attributes': MAP{},
                                     'element_order': 0}::duck_block))
FROM (SELECT unnest(duck_block_kind_names()) AS k);
----
true

# DISCRIMINATING, against a real reader emission rather than a synthetic struct:
# a document with metadata produces a `value` element, and the macro must accept it.
# Asserting only over the NAMES would pass for a build that declares `value` and
# never emits one.
query II
SELECT count(*) FILTER (WHERE b.kind = 'value'),
       bool_and(duck_block_is_valid(b))
FROM (SELECT unnest(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaString","c":"T"}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"body"}]}]}')) AS b);
----
1	true

# ============================================================================
# THE `metadata` ROW SAID LEVEL 0, WHICH THE VALIDATOR REJECTS.
#
# docs/duck_blocks_spec.md's type table gave `metadata` a level of 0 while the
# conformance macro it publishes two hundred lines away requires `level >= 1`, and
# duck_blocks_validate() errors with "level 0 is below 1; top level is 1".
#
# So the spec instructed a value its own validator rejects, in the row for the one
# type both webbed and panduck need in order to stop dropping every document's
# title. A producer doing exactly as told would have been told it was wrong.
#
# Third self-contradiction found in this document today, after the container
# content rule and the two-kind `kind` definition.
# ============================================================================

query II
SELECT (SELECT b.level FROM (SELECT unnest(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaString","c":"T"}},"blocks":[]}')) AS b) WHERE b.kind = 'value'),
       duck_blocks_validate(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaString","c":"T"}},"blocks":[]}')).valid;
----
1	true

# DISCRIMINATING: the level the table USED to document must actually fail, or
# "the table was fine" would be an equally good reading of the assertion above.
query I
SELECT duck_blocks_validate([{'kind':'value','element_type':'metadata','content':'t','level':0,'encoding':'yaml','attributes':MAP{},'element_order':0}::duck_block]).valid;
----
false
