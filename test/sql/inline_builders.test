# name: test/sql/inline_builders.test
# description: test duck_block_utils extension - inline builder functions
# group: [duck_block_utils]

require duck_block_utils

# ============================================================================
# doc_inline Type Tests
# ============================================================================

# Test doc_inline type is registered with all fields
query I
SELECT typeof(doc_text('hello'));
----
STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER)

# ============================================================================
# doc_text Tests
# ============================================================================

query I
SELECT doc_text('Hello world').element_type;
----
text

query I
SELECT doc_text('Hello world').content;
----
Hello world

query I
SELECT doc_text('Hello world').level;
----
1

query I
SELECT doc_text('Hello world').element_order;
----
0

# ============================================================================
# Whitespace Tests
# ============================================================================

query I
SELECT doc_space().element_type;
----
space

query I
SELECT doc_space().content;
----
(empty)

query I
SELECT doc_softbreak().element_type;
----
softbreak

query I
SELECT doc_linebreak().element_type;
----
linebreak

query I
SELECT doc_linebreak().content;
----
(empty)

# ============================================================================
# doc_link Tests
# ============================================================================

query I
SELECT doc_link('Click here', 'https://example.com').element_type;
----
link

query I
SELECT doc_link('Click here', 'https://example.com').content;
----
Click here

query I
SELECT doc_link('Click here', 'https://example.com').attributes['href'];
----
https://example.com

query I
SELECT doc_link('Click here', 'https://example.com', 'My Title').attributes['title'];
----
My Title

# ============================================================================
# doc_inline_image Tests
# ============================================================================

query I
SELECT doc_inline_image('/path/to/img.png').element_type;
----
image

query I
SELECT doc_inline_image('/path/to/img.png').attributes['src'];
----
/path/to/img.png

query I
SELECT doc_inline_image('/path/to/img.png', 'Alt text').attributes['alt'];
----
Alt text

query I
SELECT doc_inline_image('/path/to/img.png', 'Alt text').content;
----
Alt text

# ============================================================================
# Formatting Tests
# ============================================================================

query I
SELECT doc_bold('Important').element_type;
----
bold

query I
SELECT doc_italic('Emphasis').element_type;
----
italic

query I
SELECT doc_strikethrough('deleted').element_type;
----
strikethrough

query I
SELECT doc_superscript('2').element_type;
----
superscript

query I
SELECT doc_subscript('n').element_type;
----
subscript

query I
SELECT doc_smallcaps('Title').element_type;
----
smallcaps

query I
SELECT doc_underline('underlined').element_type;
----
underline

# ============================================================================
# Semantic Tests
# ============================================================================

query I
SELECT doc_inline_code('print(1)').element_type;
----
code

query I
SELECT doc_math('E=mc^2').element_type;
----
math

query I
SELECT doc_math('E=mc^2').attributes['display'];
----
inline

query I
SELECT doc_math('\\sum_{i=1}^n', true).attributes['display'];
----
block

query I
SELECT doc_quoted('Hello').element_type;
----
quoted

query I
SELECT doc_quoted('Hello').attributes['quote_type'];
----
double

query I
SELECT doc_quoted('Hello', 'single').attributes['quote_type'];
----
single

query I
SELECT doc_cite('knuth1984').element_type;
----
cite

query I
SELECT doc_cite('knuth1984').attributes['key'];
----
knuth1984

query I
SELECT doc_note('Footnote content').element_type;
----
note

query I
SELECT doc_span('text', 'my-id').element_type;
----
span

query I
SELECT doc_span('text', 'my-id').attributes['id'];
----
my-id

query I
SELECT doc_raw_inline('<br>').element_type;
----
raw

query I
SELECT doc_raw_inline('<br>').attributes['format'];
----
html

query I
SELECT doc_raw_inline('\\LaTeX', 'latex').attributes['format'];
----
latex

# ============================================================================
# Integration: Arrays of inline elements
# ============================================================================

query I
SELECT len([doc_text('Hello '), doc_bold('world'), doc_text('!')]);
----
3

query I
SELECT [doc_text('Hello '), doc_bold('world')][1].element_type;
----
text

query I
SELECT [doc_text('Hello '), doc_bold('world')][2].element_type;
----
bold

# ============================================================================
# Pandoc Conversion Tests
# ============================================================================

# Test basic Pandoc inline parsing
query I
SELECT len(pandoc_inlines_to_doc_inlines('[{"t":"Str","c":"Hello"}]'));
----
1

query I
SELECT pandoc_inlines_to_doc_inlines('[{"t":"Str","c":"Hello"}]')[1].element_type;
----
text

query I
SELECT pandoc_inlines_to_doc_inlines('[{"t":"Str","c":"Hello"}]')[1].content;
----
Hello

# Test Space and LineBreak
query I
SELECT pandoc_inlines_to_doc_inlines('[{"t":"Space"}]')[1].element_type;
----
space

query I
SELECT pandoc_inlines_to_doc_inlines('[{"t":"LineBreak"}]')[1].element_type;
----
linebreak

# Test Strong (bold) with nested content
query I
SELECT len(pandoc_inlines_to_doc_inlines('[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]'));
----
2

query I
SELECT pandoc_inlines_to_doc_inlines('[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]')[1].element_type;
----
bold

query I
SELECT pandoc_inlines_to_doc_inlines('[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]')[1].level;
----
1

query I
SELECT pandoc_inlines_to_doc_inlines('[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]')[2].element_type;
----
text

query I
SELECT pandoc_inlines_to_doc_inlines('[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]')[2].level;
----
2

# Test pandoc_inlines_to_text
query I
SELECT pandoc_inlines_to_text('[{"t":"Str","c":"Hello"},{"t":"Space"},{"t":"Strong","c":[{"t":"Str","c":"world"}]}]', 'markdown');
----
Hello **world**

query I
SELECT pandoc_inlines_to_text('[{"t":"Str","c":"Hello"},{"t":"Space"},{"t":"Strong","c":[{"t":"Str","c":"world"}]}]', 'text');
----
Hello world

# Test round-trip conversion
query I
SELECT doc_inlines_to_pandoc([doc_text('Hello')]);
----
[{"t":"Str","c":"Hello"}]
