# name: test/sql/duck_block_utils.test
# description: test duck_block_utils extension - types and manipulation functions
# group: [duck_block_utils]

# Require statement will ensure this test is run with this extension loaded
require duck_block_utils

# ============================================================================
# Type Tests - Using builder functions which return proper struct types
# ============================================================================

# Test db_heading returns correct structure
query I
SELECT db_heading('Test', 1).element_type;
----
heading

# Test db_paragraph with NULL level
query I
SELECT db_paragraph('Hello').level IS NULL;
----
true

# Test db_code with attributes
query I
SELECT db_code('print(1)', 'python').attributes['language'];
----
python

# ============================================================================
# db_blocks_filter Tests
# ============================================================================

# Test filter with single type
query I
SELECT len(db_blocks_filter(
    [db_heading('Title', 1), db_paragraph('Text')],
    ['heading']
));
----
1

# Test filter with multiple types
query I
SELECT len(db_blocks_filter(
    [db_heading('Title', 1), db_paragraph('Text'), db_code('x=1', 'py')],
    ['heading', 'code']
));
----
2

# Test filter with no matches
query I
SELECT len(db_blocks_filter(
    [db_paragraph('Text')],
    ['heading']
));
----
0

# Test filter preserves original block_order
query I
SELECT db_blocks_filter(
    [db_heading('A', 1), db_paragraph('B')],
    ['heading']
)[1].element_order;
----
0

# ============================================================================
# db_blocks_exclude Tests
# ============================================================================

# Test exclude single type
query I
SELECT len(db_blocks_exclude(
    [db_heading('Title', 1), db_paragraph('Text'), db_hr()],
    ['hr']
));
----
2

# Test exclude multiple types
query I
SELECT len(db_blocks_exclude(
    [db_heading('Title', 1), db_metadata('title: Test'), db_paragraph('Text')],
    ['metadata', 'hr']
));
----
2

# ============================================================================
# db_blocks_merge Tests
# ============================================================================

# Test merge length
query I
SELECT len(db_blocks_merge(
    [db_heading('A', 1)],
    [db_paragraph('B')]
));
----
2

# Test merge adjusts block_order for second list
query I
SELECT db_blocks_merge(
    [db_heading('A', 1)],
    [db_paragraph('B')]
)[2].element_order;
----
1

# ============================================================================
# db_blocks_reorder Tests
# ============================================================================

# Test reorder assigns sequential order starting from 0
query I
SELECT db_blocks_reorder(
    [db_heading('A', 1), db_paragraph('B')]
)[1].element_order;
----
0

query I
SELECT db_blocks_reorder(
    [db_heading('A', 1), db_paragraph('B')]
)[2].element_order;
----
1

# ============================================================================
# db_blocks_slice Tests
# ============================================================================

# Test slice extracts correct range
query I
SELECT len(db_blocks_slice(
    db_assemble([db_heading('A', 1), db_paragraph('B'), db_code('C', 'py'), db_paragraph('D')]),
    1, 2
));
----
2

# Test slice with no matches returns empty
query I
SELECT len(db_blocks_slice(
    [db_heading('A', 1)],
    5, 10
));
----
0
