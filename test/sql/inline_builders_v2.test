# name: test/sql/inline_builders_v2.test
# description: test duck_block_utils extension - v2 inline builder functions (LIST return, config-first)
# group: [sql]

require duck_block_utils

# ============================================================================
# Type Tests (v2: all builders return LIST)
# ============================================================================

# Test return type is LIST(duck_block)
query I
SELECT typeof(duck_block_text('hello'));
----
STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER)[]

# ============================================================================
# duck_block_text Tests (v2: returns LIST)
# ============================================================================

query I
SELECT duck_block_text('Hello world')[1].element_type;
----
text

query I
SELECT duck_block_text('Hello world')[1].content;
----
Hello world

query I
SELECT duck_block_text('Hello world')[1].level;
----
1

query I
SELECT len(duck_block_text('Hello world'));
----
1

# ============================================================================
# Whitespace Tests (v2: returns LIST)
# ============================================================================

query I
SELECT duck_block_space()[1].element_type;
----
space

query I
SELECT len(duck_block_space());
----
1

query I
SELECT duck_block_softbreak()[1].element_type;
----
softbreak

query I
SELECT duck_block_linebreak()[1].element_type;
----
linebreak

# ============================================================================
# duck_block_link Tests (v2: href first)
# ============================================================================

query I
SELECT duck_block_link('https://example.com', 'Click here')[1].element_type;
----
link

query I
SELECT duck_block_link('https://example.com', 'Click here')[1].content;
----
Click here

query I
SELECT duck_block_link('https://example.com', 'Click here')[1].attributes['href'];
----
https://example.com

# Test duck_block_link with title (href, title, content)
query I
SELECT duck_block_link('https://example.com', 'My Title', 'Click here')[1].attributes['title'];
----
My Title

# Test duck_block_link with inline children
query I
SELECT len(duck_block_link('https://example.com', [duck_block_text('Click '), duck_block_bold('here')]));
----
3

query I
SELECT duck_block_link('https://example.com', [duck_block_text('Click')])[1].content IS NULL;
----
true

query I
SELECT duck_block_link('https://example.com', [duck_block_text('Click')])[2].level;
----
2

# ============================================================================
# duck_block_inline_image Tests (v2: returns LIST)
# ============================================================================

query I
SELECT duck_block_inline_image('/path/to/img.png')[1].element_type;
----
image

query I
SELECT duck_block_inline_image('/path/to/img.png')[1].attributes['src'];
----
/path/to/img.png

query I
SELECT duck_block_inline_image('/path/to/img.png', 'Alt text')[1].attributes['alt'];
----
Alt text

query I
SELECT duck_block_inline_image('/path/to/img.png', 'Alt text')[1].content;
----
Alt text

query I
SELECT len(duck_block_inline_image('/path/to/img.png'));
----
1

# ============================================================================
# Formatting Tests (v2: returns LIST)
# ============================================================================

query I
SELECT duck_block_bold('Important')[1].element_type;
----
bold

query I
SELECT duck_block_bold('Important')[1].content;
----
Important

query I
SELECT duck_block_italic('Emphasis')[1].element_type;
----
italic

query I
SELECT duck_block_strikethrough('deleted')[1].element_type;
----
strikethrough

query I
SELECT duck_block_superscript('2')[1].element_type;
----
superscript

query I
SELECT duck_block_subscript('n')[1].element_type;
----
subscript

query I
SELECT duck_block_smallcaps('Title')[1].element_type;
----
smallcaps

query I
SELECT duck_block_underline('underlined')[1].element_type;
----
underline

# ============================================================================
# Formatting with Children (v2: content as duck_block_content)
# ============================================================================

# Test duck_block_bold with children - content is NULL
query I
SELECT duck_block_bold([duck_block_text('Hello'), duck_block_text(' world')])[1].content IS NULL;
----
true

# Test duck_block_bold with children - returns flattened list
query I
SELECT len(duck_block_bold([duck_block_text('Hello'), duck_block_text(' world')]));
----
3

# Test duck_block_bold children are at level 2
query I
SELECT duck_block_bold([duck_block_text('Hello')])[2].level;
----
2

# Test duck_block_italic with children
query I
SELECT len(duck_block_italic([duck_block_text('emphasized')]));
----
2

# Test duck_block_strikethrough with children
query I
SELECT len(duck_block_strikethrough([duck_block_text('deleted')]));
----
2

# ============================================================================
# Semantic Tests (v2: returns LIST)
# ============================================================================

query I
SELECT duck_block_inline_code('print(1)')[1].element_type;
----
code

query I
SELECT duck_block_inline_code('print(1)')[1].content;
----
print(1)

# duck_block_math: display first when specified
query I
SELECT duck_block_math('E=mc^2')[1].element_type;
----
math

query I
SELECT duck_block_math('E=mc^2')[1].attributes['display'];
----
inline

query I
SELECT duck_block_math(true, '\\sum_{i=1}^n')[1].attributes['display'];
----
block

# duck_block_quoted: quote_type first when specified
query I
SELECT duck_block_quoted('Hello')[1].element_type;
----
quoted

query I
SELECT duck_block_quoted('Hello')[1].attributes['quote_type'];
----
double

query I
SELECT duck_block_quoted('single', 'Hello')[1].attributes['quote_type'];
----
single

# duck_block_quoted with children
query I
SELECT len(duck_block_quoted([duck_block_text('some words')]));
----
2

query I
SELECT duck_block_quoted([duck_block_text('word')])[1].content IS NULL;
----
true

query I
SELECT duck_block_cite('knuth1984')[1].element_type;
----
cite

query I
SELECT duck_block_cite('knuth1984')[1].attributes['key'];
----
knuth1984

query I
SELECT duck_block_note('Footnote content')[1].element_type;
----
note

# duck_block_note with children
query I
SELECT len(duck_block_note([duck_block_text('Footnote')]));
----
2

# duck_block_span: id first, then class
query I
SELECT duck_block_span('text')[1].element_type;
----
span

query I
SELECT duck_block_span('my-id', 'text')[1].attributes['id'];
----
my-id

query I
SELECT duck_block_span('my-id', 'my-class', 'text')[1].attributes['class'];
----
my-class

# duck_block_span with children
query I
SELECT len(duck_block_span([duck_block_text('content')]));
----
2

query I
SELECT duck_block_span('my-id', [duck_block_text('content')])[1].attributes['id'];
----
my-id

# duck_block_raw_inline: format first when specified
query I
SELECT duck_block_raw_inline('<br>')[1].element_type;
----
raw

query I
SELECT duck_block_raw_inline('<br>')[1].attributes['format'];
----
html

query I
SELECT duck_block_raw_inline('latex', '\\LaTeX')[1].attributes['format'];
----
latex

# ============================================================================
# Nested Children Tests
# ============================================================================

# Test deeply nested content
query I
SELECT len(duck_block_bold([duck_block_italic([duck_block_text('nested')])]));
----
3

# Test levels increment correctly for nested
query I
SELECT duck_block_bold([duck_block_italic([duck_block_text('nested')])])[2].level;
----
2

# Test element_order is preserved within children
query III
SELECT duck_block_bold([duck_block_text('A'), duck_block_text('B'), duck_block_text('C')])[2].element_order,
       duck_block_bold([duck_block_text('A'), duck_block_text('B'), duck_block_text('C')])[3].element_order,
       duck_block_bold([duck_block_text('A'), duck_block_text('B'), duck_block_text('C')])[4].element_order;
----
0	1	2

# ============================================================================
# Integration: Composing inline elements
# ============================================================================

# Test creating a list of inlines with flatten
query I
SELECT len(flatten([
    duck_block_text('Click '),
    duck_block_link('https://example.com', 'here'),
    duck_block_text('!')
]));
----
3

# Test composing link with formatted text
query I
SELECT len(duck_block_link('https://example.com', [
    duck_block_bold('Click'),
    duck_block_text(' here')
]));
----
3

# ============================================================================
# Pandoc Conversion Tests (unchanged)
# ============================================================================

# Test basic Pandoc inline parsing
query I
SELECT len(pandoc_inlines_to_db_inlines('[{"t":"Str","c":"Hello"}]'));
----
1

query I
SELECT pandoc_inlines_to_db_inlines('[{"t":"Str","c":"Hello"}]')[1].element_type;
----
text

# Test Strong (bold) with nested content - already returns list
query I
SELECT len(pandoc_inlines_to_db_inlines('[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]'));
----
2

query I
SELECT pandoc_inlines_to_db_inlines('[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]')[1].element_type;
----
bold

query I
SELECT pandoc_inlines_to_db_inlines('[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]')[2].level;
----
2

# Test round-trip conversion
query I
SELECT duck_blocks_inlines_to_pandoc(duck_block_text('Hello'));
----
[{"t":"Str","c":"Hello"}]
