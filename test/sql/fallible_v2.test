# name: test/sql/fallible_v2.test
# description: class 13 -- throwing scalar functions are declared fallible; the type prefix is what discriminates
# group: [sql]

require duck_block_utils

# On DuckDB v2.0 an undeclared throw is rewritten as
#   INTERNAL Error: Scalar function "x" threw an execution error, but the function is not marked as fallible ... Error: <raw message>
# which still CONTAINS the raw message, so a bare-substring `statement error` passes on
# both the correct and the mis-declared form. Expecting the exception's TYPE PREFIX
# immediately before the message distinguishes them: the internal form never has it.
# On v1.5.5 the contract is consulted but not enforced, so these pass either way there;
# the duckdb-next-build leg is where they earn their keep.
#
# write_pandoc_ast / read_pandoc_ast are deprecated in favour of panduck's own readers;
# these two cases move there with them.

statement error
SELECT write_pandoc_ast('/nonexistent-dir/x.json', [duck_block_heading('H', 1)]);
----
IO Error: Could not open file for writing

statement error
SELECT read_pandoc_ast('/nonexistent-dir/none.json');
----
IO Error: Could not open file

# CheckPandocDepth's type-prefix discrimination ("Invalid Input Error: ...") is already
# asserted at test/sql/pandoc_recursion_cap.test:27-32 (same construction, same expected
# string); not repeated here.
