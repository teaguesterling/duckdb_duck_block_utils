# name: test/sql/assembly_v2.test
# description: test duck_block_utils extension - v2 assembly functions (LIST(LIST) input)
# group: [sql]

require duck_block_utils

# ============================================================================
# duck_blocks_assemble Tests (v2: takes LIST(LIST(duck_block)))
# ============================================================================

# Test duck_blocks_assemble flattens LIST(LIST(duck_block))
query I
SELECT len(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_code('py', 'x=1')
]));
----
3

# Test duck_blocks_assemble assigns sequential element_order
query III
SELECT duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_code('py', 'x=1')
])[1].element_order,
duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_code('py', 'x=1')
])[2].element_order,
duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_code('py', 'x=1')
])[3].element_order;
----
0	1	2

# Test duck_blocks_assemble flattens nested content correctly
query I
SELECT len(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph([duck_block_text('Hello '), duck_block_bold('world')])
]));
----
4

# Test duck_blocks_assemble preserves child levels
query I
SELECT duck_blocks_assemble([
    duck_block_paragraph([duck_block_bold('Important')])
])[2].level;
----
2

# ============================================================================
# duck_blocks_document Tests (v2: alias for duck_blocks_assemble)
# ============================================================================

query I
SELECT len(duck_blocks_document([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text')
]));
----
2

query I
SELECT duck_blocks_document([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text')
])[2].element_order;
----
1

# ============================================================================
# duck_block_section Tests (v2: level first, title second)
# ============================================================================

# Test duck_block_section creates heading + children
query I
SELECT len(duck_block_section(2, 'Introduction', [
    duck_block_paragraph('First paragraph'),
    duck_block_paragraph('Second paragraph')
]));
----
3

# Test duck_block_section first block is heading with correct level
query I
SELECT duck_block_section(2, 'Introduction', [duck_block_paragraph('Text')])[1].element_type;
----
heading

query I
SELECT duck_block_section(2, 'Introduction', [duck_block_paragraph('Text')])[1].attributes['heading_level'];
----
2

# Test duck_block_section heading has level 1 (top-level structural level)
query I
SELECT duck_block_section(2, 'Introduction', [duck_block_paragraph('Text')])[1].level;
----
1

# Test duck_block_section children follow heading
query I
SELECT duck_block_section(2, 'Introduction', [duck_block_paragraph('First')])[2].element_type;
----
paragraph

# Test duck_block_section assigns sequential element_order
query III
SELECT duck_block_section(2, 'Title', [duck_block_paragraph('A'), duck_block_paragraph('B')])[1].element_order,
       duck_block_section(2, 'Title', [duck_block_paragraph('A'), duck_block_paragraph('B')])[2].element_order,
       duck_block_section(2, 'Title', [duck_block_paragraph('A'), duck_block_paragraph('B')])[3].element_order;
----
0	1	2

# Test duck_block_section with no children (2-arg version)
query I
SELECT len(duck_block_section(3, 'Just a Heading'));
----
1

query I
SELECT duck_block_section(3, 'Just a Heading')[1].element_type;
----
heading

# Test duck_block_section with inline children for heading
query I
SELECT len(duck_block_section(1, [duck_block_text('Hello '), duck_block_bold('World')]));
----
3

query I
SELECT duck_block_section(1, [duck_block_text('Hello '), duck_block_bold('World')])[1].element_type;
----
heading

query I
SELECT duck_block_section(1, [duck_block_text('Hello '), duck_block_bold('World')])[1].content IS NULL;
----
true

# ============================================================================
# duck_blocks_rebase_levels Tests (v2: takes LIST(duck_block), which is flattened builder output)
# ============================================================================

# Test duck_blocks_rebase_levels increases heading levels
query I
SELECT duck_blocks_rebase_levels(duck_block_heading(1, 'Title'), 1)[1].attributes['heading_level'];
----
2

query I
SELECT duck_blocks_rebase_levels(duck_block_heading(2, 'Title'), 2)[1].attributes['heading_level'];
----
4

# Test duck_blocks_rebase_levels decreases heading levels
query I
SELECT duck_blocks_rebase_levels(duck_block_heading(3, 'Title'), -1)[1].attributes['heading_level'];
----
2

# Test duck_blocks_rebase_levels clamps to minimum level 1
query I
SELECT duck_blocks_rebase_levels(duck_block_heading(1, 'Title'), -5)[1].attributes['heading_level'];
----
1

# Test duck_blocks_rebase_levels clamps to maximum level 6
query I
SELECT duck_blocks_rebase_levels(duck_block_heading(5, 'Title'), 10)[1].attributes['heading_level'];
----
6

# Test duck_blocks_rebase_levels doesn't affect non-heading blocks
query I
SELECT duck_blocks_rebase_levels(duck_block_paragraph('Text'), 1)[1].element_type;
----
paragraph

# Test duck_blocks_rebase_levels with mixed blocks (flattened)
query I
SELECT len(duck_blocks_rebase_levels(flatten([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_heading(2, 'Subtitle')
]), 1));
----
3

query I
SELECT duck_blocks_rebase_levels(flatten([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_heading(2, 'Subtitle')
]), 1)[1].attributes['heading_level'];
----
2

query I
SELECT duck_blocks_rebase_levels(flatten([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_heading(2, 'Subtitle')
]), 1)[3].attributes['heading_level'];
----
3

# ============================================================================
# duck_blocks_concat Tests (v2: takes flattened lists)
# ============================================================================

# Test duck_blocks_concat combines lists
query I
SELECT len(duck_blocks_concat(
    duck_block_heading(1, 'A'),
    duck_block_paragraph('B')
));
----
2

# Test duck_blocks_concat preserves original element_order (unlike merge)
query II
SELECT duck_blocks_concat(
    duck_block_heading(1, 'A'),
    duck_block_paragraph('B')
)[1].element_order,
duck_blocks_concat(
    duck_block_heading(1, 'A'),
    duck_block_paragraph('B')
)[2].element_order;
----
0	0

# ============================================================================
# Integration: Building complex documents
# ============================================================================

# Test building a complete document
query I
SELECT len(duck_blocks_assemble([
    duck_block_metadata('title: My Document'),
    duck_block_heading(1, 'Introduction'),
    duck_block_paragraph('Welcome to the document.'),
    duck_block_heading(2, 'Getting Started'),
    duck_block_code('bash', 'npm install'),
    duck_block_paragraph('Now you are ready.'),
    duck_block_hr()
]));
----
7

# Test nested sections with assemble
query I
SELECT len(duck_blocks_assemble([
    duck_block_section(1, 'Chapter 1', [duck_block_paragraph('Content 1')]),
    duck_block_section(1, 'Chapter 2', [duck_block_paragraph('Content 2')])
]));
----
4

# Verify structure: heading, para, heading, para
query I
SELECT duck_blocks_assemble([
    duck_block_section(1, 'Chapter 1', [duck_block_paragraph('Content 1')]),
    duck_block_section(1, 'Chapter 2', [duck_block_paragraph('Content 2')])
])[1].element_type;
----
heading

query I
SELECT duck_blocks_assemble([
    duck_block_section(1, 'Chapter 1', [duck_block_paragraph('Content 1')]),
    duck_block_section(1, 'Chapter 2', [duck_block_paragraph('Content 2')])
])[2].element_type;
----
paragraph

query I
SELECT duck_blocks_assemble([
    duck_block_section(1, 'Chapter 1', [duck_block_paragraph('Content 1')]),
    duck_block_section(1, 'Chapter 2', [duck_block_paragraph('Content 2')])
])[3].element_type;
----
heading

# ============================================================================
# Complex Document with Inline Content
# ============================================================================

# Test document with rich inline content
query I
SELECT len(duck_blocks_assemble([
    duck_block_heading(1, 'User Guide'),
    duck_block_paragraph([
        duck_block_text('Welcome to '),
        duck_block_bold('DuckDB'),
        duck_block_text(' extensions.')
    ]),
    duck_block_heading(2, 'Installation'),
    duck_block_paragraph([
        duck_block_text('Run: '),
        duck_block_inline_code('INSTALL duck_block_utils')
    ]),
    duck_block_heading(2, 'Links'),
    duck_block_list_block(false, ['GitHub', 'Documentation'])
]));
----
13

# ============================================================================
# Backward Compatibility Tests
# ============================================================================

# Test duck_blocks_rebase_levels reads from level field when heading_level attribute is not set
query I
SELECT duck_blocks_rebase_levels([
    duck_block('heading', 'Old Format', 2, 'text', MAP{}, 0)
], 1)[1].attributes['heading_level'];
----
3

# Test duck_blocks_headings reads from level field when heading_level attribute is not set
query I
SELECT duck_blocks_headings([
    duck_block('heading', 'Old Format', 3, 'text', MAP{}, 0)
])[1].level;
----
3

# Test duck_blocks_headings prefers heading_level attribute over level field
query I
SELECT duck_blocks_headings([
    duck_block('heading', 'New Format', 99, 'text', MAP{'heading_level': '2'}, 0)
])[1].level;
----
2

# ============================================================================
# Integration: Rebasing and merging subdocuments
# ============================================================================

# Test rebasing levels in a document merge
query I
SELECT len(duck_blocks_assemble([
    duck_block_heading(1, 'Main Doc'),
    duck_blocks_rebase_levels(flatten([
        duck_block_heading(1, 'Subdoc Title'),
        duck_block_paragraph('Subdoc content')
    ]), 1)
]));
----
3

query II
SELECT duck_blocks_assemble([
    duck_block_heading(1, 'Main Doc'),
    duck_blocks_rebase_levels(flatten([
        duck_block_heading(1, 'Subdoc Title'),
        duck_block_paragraph('Subdoc content')
    ]), 1)
])[1].attributes['heading_level'],
duck_blocks_assemble([
    duck_block_heading(1, 'Main Doc'),
    duck_blocks_rebase_levels(flatten([
        duck_block_heading(1, 'Subdoc Title'),
        duck_block_paragraph('Subdoc content')
    ]), 1)
])[2].attributes['heading_level'];
----
1	2
