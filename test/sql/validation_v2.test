# name: test/sql/validation_v2.test
# description: test duck_block_utils extension - v2 validation functions
# group: [sql]

require duck_block_utils

# ============================================================================
# duck_blocks_validate Tests
# ============================================================================

# Test valid blocks pass validation (using duck_blocks_assemble to flatten builder output)
query I
SELECT duck_blocks_validate(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text')
])).valid;
----
true

# Test valid blocks have empty errors
query I
SELECT len(duck_blocks_validate(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text')
])).errors);
----
0

# Test empty list is valid
query I
SELECT duck_blocks_validate([]).valid;
----
true

# Test NULL input returns NULL (standard SQL NULL propagation)
query I
SELECT duck_blocks_validate(NULL) IS NULL;
----
true

# ============================================================================
# duck_blocks_lint Tests
# ============================================================================

# The builders and pandoc_ast_to_blocks() agree on levels: every element carries
# an explicit depth, top level 1, children parent+1. This assertion previously
# pinned a divergence between them.
query I
SELECT len(duck_blocks_lint(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_heading(2, 'Section'),
    duck_block_paragraph('Text')
])));
----
0

# a spec-conformant heading -- level NULL -- warns about nothing
query I
SELECT len(duck_blocks_lint([
  {'kind':'block','element_type':'heading','content':'H','level':1,'encoding':'text',
   'attributes':MAP{'heading_level':'1'},'element_order':0}::duck_block]));
----
0

# Test lint detects heading level skip
query I
SELECT len(duck_blocks_lint(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_heading(3, 'Subsection')
]))) > 0;
----
true

# Test lint warning message contains heading skip info.
# SEARCHES rather than indexing [1]: warning order is not part of the contract,
# and adding a new lint rule changed which warning came first. Indexing blindly
# into a list is the same mistake the spec now warns consumers against.
query I
SELECT list_bool_or(list_transform(duck_blocks_lint(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_heading(3, 'Skip')
])), w -> w.message LIKE '%skip%'));
----
true

# Test lint warning severity
query I
SELECT duck_blocks_lint(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_heading(3, 'Skip')
]))[1].severity;
----
warning

# Test lint detects code without language
query I
SELECT len(duck_blocks_lint(duck_block_code('x=1'))) > 0;
----
true

# Test empty list returns no warnings
query I
SELECT len(duck_blocks_lint([]));
----
0

# ============================================================================
# duck_blocks_structure Tests
# ============================================================================

# Test structure block count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_paragraph('More')
])).block_count;
----
3

# Test structure heading count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(1, 'H1'),
    duck_block_paragraph('Text'),
    duck_block_heading(2, 'H2')
])).heading_count;
----
2

# Test structure paragraph count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_paragraph('P1'),
    duck_block_paragraph('P2'),
    duck_block_paragraph('P3')
])).paragraph_count;
----
3

# Test structure code block count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_code('py', 'x=1'),
    duck_block_code('bash', 'echo hi')
])).code_block_count;
----
2

# Test structure max heading level
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(1, 'H1'),
    duck_block_heading(3, 'H3'),
    duck_block_heading(2, 'H2')
])).max_heading_level;
----
3

# Test structure min heading level
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(2, 'H2'),
    duck_block_heading(4, 'H4'),
    duck_block_heading(3, 'H3')
])).min_heading_level;
----
2

# Test structure with no headings
query I
SELECT duck_blocks_structure(duck_block_paragraph('Text')).min_heading_level;
----
0

# Test structure total content length
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_paragraph('Hello'),
    duck_block_paragraph('World')
])).total_content_length;
----
10

# Test structure with empty list
query I
SELECT duck_blocks_structure([]).block_count;
----
0

# Test structure inline count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_text('Hello'),
    duck_block_bold('World'),
    duck_block_paragraph('Block')
])).inline_count;
----
2

# Test structure link count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_link('https://example.com', 'Click'),
    duck_block_link('https://test.com', 'Here'),
    duck_block_paragraph('Text')
])).link_count;
----
2

# Test structure image count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_inline_image('/img.png', 'Alt'),
    duck_block_image('/photo.jpg', 'Photo', 'Title')
])).image_count;
----
2

# ============================================================================
# Integration Tests
# ============================================================================

# Test validation on assembled document
query I
SELECT duck_blocks_validate(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Intro'),
    duck_block_heading(2, 'Section'),
    duck_block_code('python', 'example')
])).valid;
----
true

# Test structure of assembled document
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Intro'),
    duck_block_heading(2, 'Section'),
    duck_block_code('python', 'example')
])).heading_count;
----
2

# ============================================================================
# A CONTAINER THAT OWNS NOTHING.
#
# The spec says a container's children follow it at level + 1. A container whose
# next block sits at its own depth or shallower owns nothing, and the blocks meant
# to be inside it are siblings -- so it renders as an empty container with its
# content beside it. On a rendered page that LOOKS CORRECT: the text is where a
# reader expects and nothing is missing.
#
# Found live: panduck's epub reader emitted blockquote and its paragraph both at
# NULL level, and webbed's HTML writer -- which expresses containment through
# level -- closed the blockquote before the paragraph rendered. duck_blocks_validate
# called that shape VALID, and the only lint was "empty content in blockquote",
# which is adjacent to the defect rather than on it.
# ============================================================================

query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_lint([
  {'kind':'block','element_type':'blockquote','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER),
  {'kind':'block','element_type':'paragraph','content':'A block quote.','level':1,'encoding':'text','attributes':MAP{},'element_order':1}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])) AS w)
WHERE w.message LIKE '%owns no children%';
----
1

# DISCRIMINATING: the defective shape ALSO produces "empty content in blockquote",
# which is what the linter already said and what makes this easy to mistake for
# covered. Asserting that any warning appears would have passed against the
# defect. The property is that the STRUCTURAL warning appears.
query I
SELECT count(*) > 0 FROM (SELECT unnest(duck_blocks_lint([
  {'kind':'block','element_type':'blockquote','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER),
  {'kind':'block','element_type':'paragraph','content':'x','level':1,'encoding':'text','attributes':MAP{},'element_order':1}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])) AS w)
WHERE w.severity = 'warning' AND w.message LIKE '%SIBLING%';
----
true

# NO FALSE POSITIVES. Every producer in this repo emits conforming containers,
# including the figure/caption case where the caption is a SIBLING of the content
# by design and must not be mistaken for an escaped child.
query IIII
SELECT (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_blockquote('x'))) AS w) WHERE w.message LIKE '%owns no children%'),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_list(['a','b']))) AS w) WHERE w.message LIKE '%owns no children%'),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_list_block([duck_block_list_item('a')]))) AS w) WHERE w.message LIKE '%owns no children%'),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[],["i.png",""]]}]}]]}]}'))) AS w) WHERE w.message LIKE '%owns no children%');
----
0	0	0	0

# ============================================================================
# "Empty content" must mean NOTHING AT ALL, not "content field is empty".
#
# Spec 2.0 says a container carries no content of its own, so the old rule fired
# on EVERY conforming container -- and on every rich paragraph, whose text lives
# in inline children. A rule that fires on correct code does not merely add
# lines; panduck measured a real defect whose only nearby lint was one of FOUR
# identical "empty content" infos, three benign, which made the genuine problem
# look like the fourth instance of a harmless pattern. Noise camouflages signal.
# ============================================================================

# Conforming containers produce NO lint at all.
query IIII
SELECT (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_blockquote('x'))) AS w)),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_list(['a']))) AS w)),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_list_block([duck_block_list_item('a')]))) AS w)),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[],["i.png",""]]}]}]]}]}'))) AS w));
----
0	0	0	0

# DISCRIMINATING: suppressing the rule entirely would also produce those zeros.
# An element with neither content nor children must still be reported.
query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_lint([
  {'kind':'block','element_type':'paragraph','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])) AS w)
WHERE w.message LIKE '%no content and no children%';
----
1

# On panduck's real epub rows the structural warnings must outnumber the infos --
# the signal has to dominate, which is the whole point of removing the noise.
query II
SELECT count(*) FILTER (WHERE w.severity = 'warning'), count(*) FILTER (WHERE w.severity = 'info')
FROM (SELECT unnest(duck_blocks_lint([
  {'kind':'block','element_type':'list_item','content':'bullet one','level':1,'encoding':'text','attributes':MAP{},'element_order':12}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER),
  {'kind':'block','element_type':'blockquote','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':14}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER),
  {'kind':'block','element_type':'paragraph','content':'A block quote.','level':1,'encoding':'text','attributes':MAP{},'element_order':15}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])) AS w);
----
2	1

# ============================================================================
# LEVEL IS VALIDATED. `level` and adjacency together describe the entire document
# tree, so a malformed level does not degrade the structure -- it destroys it.
#
# Nothing checked this until spec 3.0, which is exactly how a NULL-at-top-level
# convention could be introduced here and propagate to four extensions without
# anything objecting. NULL, 0, -5 and a 1 -> 3 jump with no parent ALL returned
# valid:true.
# ============================================================================

query IIII
SELECT (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':NULL,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).valid,
       (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':0,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).valid,
       (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':-5,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).valid,
       (duck_blocks_validate([
         {'kind':'block','element_type':'paragraph','content':'a','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
         {'kind':'block','element_type':'paragraph','content':'b','level':3,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])).valid;
----
false	false	false	false

# DISCRIMINATING: each names `level` as the offending field, so a validator that
# happened to reject these for some other reason would not pass.
query IIII
SELECT (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':NULL,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).errors[1].field,
       (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':0,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).errors[1].field,
       (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':-5,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).errors[1].field,
       (duck_blocks_validate([
         {'kind':'block','element_type':'paragraph','content':'a','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
         {'kind':'block','element_type':'paragraph','content':'b','level':3,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])).errors[1].field;
----
level	level	level	level

# Conforming output from BOTH producers stays valid -- the rules must not reject
# what this extension itself emits.
query II
SELECT (duck_blocks_validate(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"q"}]}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"i"}]}]]}]}'))).valid,
       (duck_blocks_validate(duck_blocks_assemble([duck_block_heading(1,'T'), duck_block_list(['a']), duck_block_blockquote('q')]))).valid;
----
true	true

# Descending one at a time is legal to any depth; only a JUMP is an error.
query I
SELECT (duck_blocks_validate([
  {'kind':'block','element_type':'div','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'blockquote','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'deep','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block])).valid;
----
true
