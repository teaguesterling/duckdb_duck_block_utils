# name: test/sql/validation_v2.test
# description: test duck_block_utils extension - v2 validation functions
# group: [sql]

require duck_block_utils

# ============================================================================
# duck_blocks_validate Tests
# ============================================================================

# Test valid blocks pass validation (using duck_blocks_assemble to flatten builder output)
query I
SELECT duck_blocks_validate(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text')
])).valid;
----
true

# Test valid blocks have empty errors
query I
SELECT len(duck_blocks_validate(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text')
])).errors);
----
0

# Test empty list is valid
query I
SELECT duck_blocks_validate([]).valid;
----
true

# Test NULL input returns NULL (standard SQL NULL propagation)
query I
SELECT duck_blocks_validate(NULL) IS NULL;
----
true

# ============================================================================
# duck_blocks_lint Tests
# ============================================================================

# The builders and pandoc_ast_to_blocks() agree on levels: every element carries
# an explicit depth, top level 1, children parent+1. This assertion previously
# pinned a divergence between them.
query I
SELECT len(duck_blocks_lint(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_heading(2, 'Section'),
    duck_block_paragraph('Text')
])));
----
0

# a spec-conformant heading -- level NULL -- warns about nothing
query I
SELECT len(duck_blocks_lint([
  {'kind':'block','element_type':'heading','content':'H','level':1,'encoding':'text',
   'attributes':MAP{'heading_level':'1'},'element_order':0}::duck_block]));
----
0

# Test lint detects heading level skip
query I
SELECT len(duck_blocks_lint(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_heading(3, 'Subsection')
]))) > 0;
----
true

# Test lint warning message contains heading skip info.
# SEARCHES rather than indexing [1]: warning order is not part of the contract,
# and adding a new lint rule changed which warning came first. Indexing blindly
# into a list is the same mistake the spec now warns consumers against.
query I
SELECT list_bool_or(list_transform(duck_blocks_lint(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_heading(3, 'Skip')
])), w -> w.message LIKE '%skip%'));
----
true

# Test lint warning severity
query I
SELECT duck_blocks_lint(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_heading(3, 'Skip')
]))[1].severity;
----
warning

# Test lint detects code without language
query I
SELECT len(duck_blocks_lint(duck_block_code('x=1'))) > 0;
----
true

# Test empty list returns no warnings
query I
SELECT len(duck_blocks_lint([]));
----
0

# ============================================================================
# duck_blocks_structure Tests
# ============================================================================

# Test structure block count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text'),
    duck_block_paragraph('More')
])).block_count;
----
3

# Test structure heading count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(1, 'H1'),
    duck_block_paragraph('Text'),
    duck_block_heading(2, 'H2')
])).heading_count;
----
2

# Test structure paragraph count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_paragraph('P1'),
    duck_block_paragraph('P2'),
    duck_block_paragraph('P3')
])).paragraph_count;
----
3

# Test structure code block count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_code('py', 'x=1'),
    duck_block_code('bash', 'echo hi')
])).code_block_count;
----
2

# Test structure max heading level
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(1, 'H1'),
    duck_block_heading(3, 'H3'),
    duck_block_heading(2, 'H2')
])).max_heading_level;
----
3

# Test structure min heading level
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(2, 'H2'),
    duck_block_heading(4, 'H4'),
    duck_block_heading(3, 'H3')
])).min_heading_level;
----
2

# Test structure with no headings
query I
SELECT duck_blocks_structure(duck_block_paragraph('Text')).min_heading_level;
----
0

# Test structure total content length
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_paragraph('Hello'),
    duck_block_paragraph('World')
])).total_content_length;
----
10

# Test structure with empty list
query I
SELECT duck_blocks_structure([]).block_count;
----
0

# Test structure inline count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_text('Hello'),
    duck_block_bold('World'),
    duck_block_paragraph('Block')
])).inline_count;
----
2

# Test structure link count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_link('https://example.com', 'Click'),
    duck_block_link('https://test.com', 'Here'),
    duck_block_paragraph('Text')
])).link_count;
----
2

# Test structure image count
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_inline_image('/img.png', 'Alt'),
    duck_block_image('/photo.jpg', 'Photo', 'Title')
])).image_count;
----
2

# ============================================================================
# Integration Tests
# ============================================================================

# Test validation on assembled document
query I
SELECT duck_blocks_validate(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Intro'),
    duck_block_heading(2, 'Section'),
    duck_block_code('python', 'example')
])).valid;
----
true

# Test structure of assembled document
query I
SELECT duck_blocks_structure(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Intro'),
    duck_block_heading(2, 'Section'),
    duck_block_code('python', 'example')
])).heading_count;
----
2

# ============================================================================
# A CONTAINER THAT OWNS NOTHING.
#
# The spec says a container's children follow it at level + 1. A container whose
# next block sits at its own depth or shallower owns nothing, and the blocks meant
# to be inside it are siblings -- so it renders as an empty container with its
# content beside it. On a rendered page that LOOKS CORRECT: the text is where a
# reader expects and nothing is missing.
#
# Found live: panduck's epub reader emitted blockquote and its paragraph both at
# NULL level, and webbed's HTML writer -- which expresses containment through
# level -- closed the blockquote before the paragraph rendered. duck_blocks_validate
# called that shape VALID, and the only lint was "empty content in blockquote",
# which is adjacent to the defect rather than on it.
# ============================================================================

query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_lint([
  {'kind':'block','element_type':'blockquote','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER),
  {'kind':'block','element_type':'paragraph','content':'A block quote.','level':1,'encoding':'text','attributes':MAP{},'element_order':1}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])) AS w)
WHERE w.message LIKE '%owns no children%';
----
1

# DISCRIMINATING: the defective shape ALSO produces "empty content in blockquote",
# which is what the linter already said and what makes this easy to mistake for
# covered. Asserting that any warning appears would have passed against the
# defect. The property is that the STRUCTURAL warning appears.
query I
SELECT count(*) > 0 FROM (SELECT unnest(duck_blocks_lint([
  {'kind':'block','element_type':'blockquote','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER),
  {'kind':'block','element_type':'paragraph','content':'x','level':1,'encoding':'text','attributes':MAP{},'element_order':1}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])) AS w)
WHERE w.severity = 'warning' AND w.message LIKE '%SIBLING%';
----
true

# NO FALSE POSITIVES. Every producer in this repo emits conforming containers,
# including the figure/caption case where the caption is a SIBLING of the content
# by design and must not be mistaken for an escaped child.
query IIII
SELECT (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_blockquote('x'))) AS w) WHERE w.message LIKE '%owns no children%'),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_list(['a','b']))) AS w) WHERE w.message LIKE '%owns no children%'),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_list_block([duck_block_list_item('a')]))) AS w) WHERE w.message LIKE '%owns no children%'),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[],["i.png",""]]}]}]]}]}'))) AS w) WHERE w.message LIKE '%owns no children%');
----
0	0	0	0

# ============================================================================
# "Empty content" must mean NOTHING AT ALL, not "content field is empty".
#
# Spec 2.0 says a container carries no content of its own, so the old rule fired
# on EVERY conforming container -- and on every rich paragraph, whose text lives
# in inline children. A rule that fires on correct code does not merely add
# lines; panduck measured a real defect whose only nearby lint was one of FOUR
# identical "empty content" infos, three benign, which made the genuine problem
# look like the fourth instance of a harmless pattern. Noise camouflages signal.
# ============================================================================

# Conforming containers produce NO lint at all.
query IIII
SELECT (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_blockquote('x'))) AS w)),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_list(['a']))) AS w)),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_list_block([duck_block_list_item('a')]))) AS w)),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[],["i.png",""]]}]}]]}]}'))) AS w));
----
0	0	0	0

# DISCRIMINATING: suppressing the rule entirely would also produce those zeros.
# An element with neither content nor children must still be reported.
query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_lint([
  {'kind':'block','element_type':'paragraph','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])) AS w)
WHERE w.message LIKE '%no content and no children%';
----
1

# On panduck's real epub rows: ONE structural warning and no infos. The empty
# blockquote is flagged; the content-bearing list_item is NOT, because under
# spec v1.0's restored rule a container carrying its text owns no children by
# design and is complete. Duplicate reporting was also removed -- "empty" and
# "owns no children" were one fact described twice.
query II
SELECT count(*) FILTER (WHERE w.severity = 'warning'), count(*) FILTER (WHERE w.severity = 'info')
FROM (SELECT unnest(duck_blocks_lint([
  {'kind':'block','element_type':'list_item','content':'bullet one','level':1,'encoding':'text','attributes':MAP{},'element_order':12}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER),
  {'kind':'block','element_type':'blockquote','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':14}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER),
  {'kind':'block','element_type':'paragraph','content':'A block quote.','level':1,'encoding':'text','attributes':MAP{},'element_order':15}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])) AS w);
----
1	0

# ============================================================================
# LEVEL IS VALIDATED. `level` and adjacency together describe the entire document
# tree, so a malformed level does not degrade the structure -- it destroys it.
#
# Nothing checked this until spec 3.0, which is exactly how a NULL-at-top-level
# convention could be introduced here and propagate to four extensions without
# anything objecting. NULL, 0, -5 and a 1 -> 3 jump with no parent ALL returned
# valid:true.
# ============================================================================

query IIII
SELECT (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':NULL,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).valid,
       (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':0,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).valid,
       (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':-5,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).valid,
       (duck_blocks_validate([
         {'kind':'block','element_type':'paragraph','content':'a','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
         {'kind':'block','element_type':'paragraph','content':'b','level':3,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])).valid;
----
false	false	false	false

# DISCRIMINATING: each names `level` as the offending field, so a validator that
# happened to reject these for some other reason would not pass.
query IIII
SELECT (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':NULL,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).errors[1].field,
       (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':0,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).errors[1].field,
       (duck_blocks_validate([{'kind':'block','element_type':'paragraph','content':'x','level':-5,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])).errors[1].field,
       (duck_blocks_validate([
         {'kind':'block','element_type':'paragraph','content':'a','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
         {'kind':'block','element_type':'paragraph','content':'b','level':3,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])).errors[1].field;
----
level	level	level	level

# Conforming output from BOTH producers stays valid -- the rules must not reject
# what this extension itself emits.
query II
SELECT (duck_blocks_validate(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"q"}]}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"i"}]}]]}]}'))).valid,
       (duck_blocks_validate(duck_blocks_assemble([duck_block_heading(1,'T'), duck_block_list(['a']), duck_block_blockquote('q')]))).valid;
----
true	true

# Descending one at a time is legal to any depth; only a JUMP is an error.
query I
SELECT (duck_blocks_validate([
  {'kind':'block','element_type':'div','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'blockquote','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'deep','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block])).valid;
----
true

# ============================================================================
# A heading's RANK lives in attributes['heading_level']; `level` is its DEPTH.
# A heading missing the attribute carries no rank at all, and a consumer falling
# back to `level` renders a heading inside two containers as h3 whatever it is.
# duckdb_markdown's writer does exactly that -- a fair reading of 1.x/2.0, which
# said headings carried NULL there, and silent corruption under 3.0.
# ============================================================================

query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_lint([{'kind':'block','element_type':'heading','content':'T','level':3,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])) AS w)
WHERE w.severity = 'warning' AND w.message LIKE '%heading_level%';
----
1

# DISCRIMINATING: a heading WITH the attribute must stay silent, including when
# the two numbers differ -- which is the normal case, not a conflict.
query II
SELECT (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint([{'kind':'block','element_type':'heading','content':'T','level':3,'encoding':'text','attributes':MAP{'heading_level':'1'},'element_order':0}::duck_block])) AS w)),
       (SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(duck_block_heading(2,'T'))) AS w));
----
0	0

# ============================================================================
# SPEC 6.0: `plain` in leaf position.
#
# A lint rather than an error -- the 5.0 shape still converts and still renders,
# so data written against it stays readable. But it is the shape where a container
# with a single text child has TWO representations, which is what every version
# since 2.0 has existed to remove, and four extensions vendor this vocabulary.
# They need something that OBJECTS. The `level` drift got a year of prose in a
# spec document and no check, and that is precisely why it drifted for a year.
# ============================================================================

# FIRES on the 5.0 shape: list_item > plain, the plain being the only child.
query I
SELECT list_bool_or(list_transform(duck_blocks_lint([
  {'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'list_item','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'plain','content':'x','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block
]), w -> w.message LIKE '%only child of `list_item`%'));
----
true

# SILENT on the 6.0 shape. A lint that fires on the shape it is asking for would
# be worse than none -- it trains people to mute it.
query I
SELECT len(duck_blocks_lint([
  {'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'list_item','content':'x','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block
]));
----
0

# SILENT where `plain` is CORRECT: the run has a block sibling, so the container's
# content cannot hold it. This is the assertion that stops the lint from simply
# meaning "there is a plain here", which would fire on every legitimate use.
#
# The negative is only evidence because the positive control is two assertions up:
# the SAME predicate on the same lint returns true for the 5.0 shape. Without that
# pairing, `coalesce(..., false)` here would also pass for a lint that never fires
# at all -- which is the assertion shape this repo has spent a week finding.
query I
SELECT coalesce(list_bool_or(list_transform(duck_blocks_lint([
  {'kind':'block','element_type':'section','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'plain','content':'Lead','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'heading','content':'H','level':2,'encoding':'text','attributes':MAP{'heading_level':'2'},'element_order':2}::duck_block
]), w -> w.message LIKE '%only child%')), false);
----
false

# SILENT at the top level, where the document root has no content field to hold it.
query I
SELECT len(duck_blocks_lint([
  {'kind':'block','element_type':'plain','content':'x','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block
]));
----
0

# ============================================================================
# duck_blocks_normalize -- SPEC 6.1
#
# 6.0's content rule is SIBLING-DEPENDENT: whether a text run becomes its
# container's content or stays a `plain` depends on what FOLLOWS it, which a
# streaming reader does not know when it reaches the run. Raised by panduck,
# whose EPUB and LaTeX readers both emit as they walk.
#
# Exported rather than left private so four extensions do not each grow their own
# lookahead and drift -- the same argument that put tight-vs-loose in the
# vocabulary instead of in each reader.
# ============================================================================

# Collapses the naive shape a streaming producer emits.
query II
SELECT len(duck_blocks_normalize([
  {'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'list_item','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'plain','content':'x','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block
])),
       duck_blocks_normalize([
  {'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'list_item','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'plain','content':'x','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block
])[2].content;
----
2	x

# IDEMPOTENT. A producer cannot always tell whether its input was normalised
# upstream, so a normaliser that is unsafe to run twice is one nobody can call
# defensively -- and "call it if you are not sure" is the whole point of exporting it.
query I
SELECT duck_blocks_normalize(duck_blocks_normalize([
  {'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'list_item','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'plain','content':'x','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block
])) = duck_blocks_normalize([
  {'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'list_item','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'plain','content':'x','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block
]);
----
true

# DISCRIMINATING: it must NOT eat a legitimate `plain`. A normaliser that removed
# every plain would pass both assertions above, and would silently destroy the one
# shape the type exists for.
query II
SELECT len(duck_blocks_normalize([
  {'kind':'block','element_type':'section','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'plain','content':'Lead','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'heading','content':'H','level':2,'encoding':'text','attributes':MAP{'heading_level':'2'},'element_order':2}::duck_block
])),
       duck_blocks_normalize([
  {'kind':'block','element_type':'plain','content':'top','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block
])[1].element_type;
----
3	plain

# It settles the lint: normalize then lint reports nothing. This is the pair a
# producer actually runs -- fix with one, verify with the other.
query I
SELECT len(duck_blocks_lint(duck_blocks_normalize([
  {'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'list_item','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'plain','content':'x','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block
])));
----
0

# ============================================================================
# THE SPEC'S CONTAINER CLAIM, PINNED.
#
# docs/duck_blocks_spec.md said containers "carry no content of their own" in its
# type table AND in prose, while the content-rule section further down showed
# `list_item content="tight item"` and `div content="bare text"`. Both were
# published. An implementer conforming to either was following the spec.
#
# That is exactly how the `level` disagreement happened: v1.0 said three different
# things about `level` in one file and every extension that diverged was
# conforming to one of them. A spec that contradicts itself does not produce
# careless implementations, it produces careful ones that disagree.
#
# So the surviving claim is asserted here rather than left as prose.
# ============================================================================

# Every container accepts its own content: valid, and no lint objects. A validator
# that rejected this would contradict the document four extensions implement from.
query II
SELECT bool_and(v), sum(w) FROM (
  SELECT duck_blocks_validate([{'kind':'block','element_type':t,'content':'CARRIED','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block]).valid AS v,
         len(duck_blocks_lint([{'kind':'block','element_type':t,'content':'CARRIED','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])) AS w
  FROM (SELECT unnest(['blockquote','list_item','div','section','figure','caption']) AS t)
);
----
true	0

# ...and `list` is the documented exception, for a reason that follows from the
# rule rather than qualifying it: a list's children are list_items, never text, so
# it can never HAVE a single text child. Asserted so the exception cannot quietly
# become general -- I widened the spec text to all seven containers before
# measuring, and this is the case that would have caught it.
query II
SELECT duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'div','content':'CARRIED','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])::VARCHAR LIKE '%CARRIED%',
       duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'list','content':'CARRIED','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block])::VARCHAR LIKE '%CARRIED%';
----
true	false

# ============================================================================
# AN element_type OUTSIDE THE VOCABULARY WAS INVISIBLE.
#
# `duck_blocks_validate` accepted `zzzz_not_a_type` as valid and the linter said
# nothing, so the 43 declared type names were decorative from a validation
# standpoint: any typo or private invention passed silently.
#
# Found by duckdb_markdown, who emit `frontmatter` where the vocabulary declares
# `metadata`, and observed that nothing objected -- "your 'what can this check not
# see' applied to the thing that just checked me."
#
# A LINT, NOT AN ERROR. A consumer built against an older vocabulary must still
# read data from a newer producer; rejecting an unknown type would make every
# additive release break every consumer that had not upgraded, which is the
# opposite of what MINOR is for.
# ============================================================================

query I
SELECT list_bool_or(list_transform(duck_blocks_lint([
  {'kind':'block','element_type':'frontmatter','content':'t','level':1,'encoding':'yaml','attributes':MAP{},'element_order':0}::duck_block
]), w -> w.message LIKE '%not in the vocabulary%'));
----
true

# SILENT on every declared type, driven from duck_block_type_names() rather than a
# sample -- a lint that fired on a real type would be muted within a day.
query I
SELECT sum(n) FROM (
  SELECT len(duck_blocks_lint([{'kind':'block','element_type':t,'content':'x','level':1,'encoding':'text','attributes':MAP{'heading_level':'1','language':'sql','src':'i.png','format':'html','list_type':'bullet','source_type':'X'},'element_order':0}::duck_block])) AS n
  FROM (SELECT unnest(duck_block_type_names()) AS t)
);
----
0

# ...and silent on real reader output, which is the case that decides whether the
# lint is usable at all.
query I
SELECT len(duck_blocks_lint(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaString","c":"T"}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"x"}]}]}')));
----
0

# ============================================================================
# THE FIXPOINT PROPERTY: lint(normalize(x)) must be EMPTY.
#
# duck_blocks_normalize emitted a shape duck_blocks_lint warns about. A chain of
# plains collapsed ONE LEVEL PER CALL:
#
#   paragraph > plain > plain > plain('foo')
#     one pass   -> paragraph > plain('foo')   <- lint objects to this
#     two passes -> paragraph('foo')           <- correct
#
# The normalizer's output failed the normalizer's own published rule, and the
# linter already said so. Nothing had put the two in the same query.
#
# validate() calls the one-pass output VALID, correctly -- it is structurally fine,
# just not normalized. So no amount of validation could have caught this class;
# only the fixpoint property can. Found and framed by the panduck session.
#
# MY IDEMPOTENCE ASSERTION PASSED THROUGHOUT. It used a single-level case, where
# one pass IS the fixpoint. A property asserted on the one input I thought to write
# is a claim about that input -- the same failure I had been trading with
# duckdb_markdown all evening, in the test written to establish a general property.
# ============================================================================

# The invariant, over the shapes that actually exercise it.
query I
SELECT sum(n) FROM (
  SELECT len(duck_blocks_lint(duck_blocks_normalize(d))) AS n FROM (VALUES
    -- a chain: the case that was broken
    ([{'kind':'block','element_type':'paragraph','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
      {'kind':'block','element_type':'plain','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
      {'kind':'block','element_type':'plain','content':NULL,'level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block,
      {'kind':'block','element_type':'plain','content':'foo','level':4,'encoding':'text','attributes':MAP{},'element_order':3}::duck_block]),
    -- one level: the case that always worked
    ([{'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
      {'kind':'block','element_type':'list_item','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
      {'kind':'block','element_type':'plain','content':'x','level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block]),
    -- a legitimate plain, which must survive and must not be warned about
    ([{'kind':'block','element_type':'section','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
      {'kind':'block','element_type':'plain','content':'Lead','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
      {'kind':'block','element_type':'heading','content':'H','level':2,'encoding':'text','attributes':MAP{'heading_level':'2'},'element_order':2}::duck_block]),
    -- real reader output
    (pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaString","c":"T"}},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"o"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"i"}]}]]}]]}]}'))
  ) AS t(d)
);
----
0

# DISCRIMINATING: one pass must now REACH the fixpoint, not merely be idempotent
# after two. Asserting normalize(normalize(x)) = normalize(x) alone passes for a
# function that collapses one level per call and then stalls -- which is exactly
# what shipped.
query II
SELECT duck_blocks_normalize([
  {'kind':'block','element_type':'paragraph','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'plain','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'plain','content':NULL,'level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block,
  {'kind':'block','element_type':'plain','content':'foo','level':4,'encoding':'text','attributes':MAP{},'element_order':3}::duck_block])[1].content,
       len(duck_blocks_normalize([
  {'kind':'block','element_type':'paragraph','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'plain','content':NULL,'level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'plain','content':NULL,'level':3,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block,
  {'kind':'block','element_type':'plain','content':'foo','level':4,'encoding':'text','attributes':MAP{},'element_order':3}::duck_block]));
----
foo	1
