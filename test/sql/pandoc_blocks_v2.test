# name: test/sql/pandoc_blocks_v2.test
# description: test duck_block_utils extension - v2 Pandoc block conversion functions
# group: [sql]

require duck_block_utils

statement ok
INSTALL json;

statement ok
LOAD json;

# ============================================================================
# pandoc_ast_to_blocks Tests
# ============================================================================

# Test parsing Header block
query I
SELECT len(pandoc_ast_to_blocks('[{"t":"Header","c":[1,["id",[],[]],[{"t":"Str","c":"Title"}]]}]'));
----
1

query I
SELECT pandoc_ast_to_blocks('[{"t":"Header","c":[1,["id",[],[]],[{"t":"Str","c":"Title"}]]}]')[1].element_type;
----
heading

query I
SELECT pandoc_ast_to_blocks('[{"t":"Header","c":[2,["id",[],[]],[{"t":"Str","c":"Section"}]]}]')[1].attributes['heading_level'];
----
2

# Test parsing Para block
query I
SELECT pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"Hello"}]}]')[1].element_type;
----
paragraph

query I
SELECT pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"Hello"}]}]')[1].content;
----
Hello

# Test parsing CodeBlock
query I
SELECT pandoc_ast_to_blocks('[{"t":"CodeBlock","c":[["",["python"],[]],"print(1)"]}]')[1].element_type;
----
code

query I
SELECT pandoc_ast_to_blocks('[{"t":"CodeBlock","c":[["",["python"],[]],"print(1)"]}]')[1].attributes['language'];
----
python

# Test parsing HorizontalRule
query I
SELECT pandoc_ast_to_blocks('[{"t":"HorizontalRule"}]')[1].element_type;
----
hr

# Test parsing multiple blocks
query I
SELECT len(pandoc_ast_to_blocks('[{"t":"Header","c":[1,["",[],[]],[{"t":"Str","c":"Title"}]]},{"t":"Para","c":[{"t":"Str","c":"Text"}]}]'));
----
2

# Test element_order is assigned sequentially
query I
SELECT pandoc_ast_to_blocks('[{"t":"Header","c":[1,["",[],[]],[{"t":"Str","c":"A"}]]},{"t":"Para","c":[{"t":"Str","c":"B"}]}]')[1].element_order;
----
0

query I
SELECT pandoc_ast_to_blocks('[{"t":"Header","c":[1,["",[],[]],[{"t":"Str","c":"A"}]]},{"t":"Para","c":[{"t":"Str","c":"B"}]}]')[2].element_order;
----
1

# Test empty input
query I
SELECT len(pandoc_ast_to_blocks('[]'));
----
0

# Test NULL input returns empty list (len of NULL is NULL, so check differently)
query I
SELECT pandoc_ast_to_blocks(NULL) IS NULL OR len(pandoc_ast_to_blocks(NULL)) = 0;
----
true

# Test parsing full AST with blocks key
query I
SELECT len(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Test"}]}]}'));
----
1

# ============================================================================
# duck_blocks_to_pandoc_blocks Tests (v2: builders return LIST)
# ============================================================================

# Test converting heading to Pandoc AST (duck_block_heading returns LIST, can pass directly)
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_heading(1, 'Title')) LIKE '%Header%';
----
true

query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_heading(1, 'Title')) LIKE '%Title%';
----
true

# Test converting paragraph to Pandoc AST
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_paragraph('Hello')) LIKE '%Para%';
----
true

query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_paragraph('Hello')) LIKE '%Hello%';
----
true

# Test converting code block to Pandoc AST (v2: language first)
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_code('python', 'x=1')) LIKE '%CodeBlock%';
----
true

query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_code('python', 'x=1')) LIKE '%python%';
----
true

# Test converting hr to Pandoc AST
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_hr()) LIKE '%HorizontalRule%';
----
true

# Test converting multiple blocks (use duck_blocks_assemble to flatten)
query I
SELECT duck_blocks_to_pandoc_blocks(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Text')
])) LIKE '%Header%Para%';
----
true

# Test empty list returns empty array
query I
SELECT duck_blocks_to_pandoc_blocks([]);
----
[]

# Test NULL input returns NULL (standard SQL NULL propagation)
query I
SELECT duck_blocks_to_pandoc_blocks(NULL) IS NULL;
----
true

# Test inline elements are skipped in block output
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_text('inline'));
----
[]

# ============================================================================
# Round-trip Tests
# ============================================================================

# Test simple round-trip: Para
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_paragraph('Hello')))[1].element_type;
----
paragraph

# Test simple round-trip: Header (v2: level first)
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_heading(1, 'Title')))[1].element_type;
----
heading

# Test simple round-trip: CodeBlock (v2: language first)
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_code('py', 'x=1')))[1].element_type;
----
code

# Test content preserved in round-trip
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_paragraph('Test content')))[1].content;
----
Test content

# ============================================================================
# Complex Document Round-trip
# ============================================================================

# Test assembled document round-trip
query I
SELECT len(pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Introduction'),
    duck_block_code('python', 'print("hello")'),
    duck_block_hr()
]))));
----
4

# ============================================================================
# duck_blocks_to_pandoc_ast Tests (complete Pandoc AST with wrapper)
# Returns STRUCT with pandoc-api-version, meta, and blocks fields
# ============================================================================

# Test returns STRUCT type
query I
SELECT typeof(duck_blocks_to_pandoc_ast(duck_block_heading(1, 'Test'))) LIKE 'STRUCT%';
----
true

# Test struct has pandoc-api-version field
query I
SELECT duck_blocks_to_pandoc_ast(duck_block_heading(1, 'Test'))."pandoc-api-version" IS NOT NULL;
----
true

# Test API version is [1,23,1] -- pandoc 3.x rejects anything below [1,23]
query I
SELECT duck_blocks_to_pandoc_ast(duck_block_heading(1, 'Test'))."pandoc-api-version"[1];
----
1

query I
SELECT duck_blocks_to_pandoc_ast(duck_block_heading(1, 'Test'))."pandoc-api-version"[2];
----
23

# Test struct has meta field (empty object)
query I
SELECT duck_blocks_to_pandoc_ast(duck_block_heading(1, 'Test')).meta;
----
{}

# Test blocks array has correct length
query I
SELECT json_array_length(duck_blocks_to_pandoc_ast(duck_block_heading(1, 'Test')).blocks);
----
1

# Test block type in output
query I
SELECT json_extract(duck_blocks_to_pandoc_ast(duck_block_heading(1, 'Test')).blocks, '$[0].t');
----
"Header"

query I
SELECT json_extract(duck_blocks_to_pandoc_ast(duck_block_paragraph('Hello')).blocks, '$[0].t');
----
"Para"

# Test multiple blocks
query I
SELECT json_array_length(duck_blocks_to_pandoc_ast(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Body'),
    duck_block_hr()
])).blocks);
----
3

# Test NULL input returns NULL (standard SQL NULL propagation)
query I
SELECT duck_blocks_to_pandoc_ast(NULL) IS NULL;
----
true

# Test empty list returns valid empty AST
query I
SELECT duck_blocks_to_pandoc_ast([]).blocks;
----
[]

# ============================================================================
# duck_blocks_to_pandoc_ast with Rich Content
# ============================================================================

# Test paragraph with inline formatting
query I
SELECT json_extract(duck_blocks_to_pandoc_ast(duck_blocks_assemble([
    duck_block_paragraph([duck_block_text('Hello '), duck_block_bold('world')])
])).blocks, '$[0].c[0].t');
----
"Str"

query I
SELECT json_extract(duck_blocks_to_pandoc_ast(duck_blocks_assemble([
    duck_block_paragraph([duck_block_text('Hello '), duck_block_bold('world')])
])).blocks, '$[0].c[1].t');
----
"Strong"

# Test list block type with inline children
query I
SELECT json_extract(duck_blocks_to_pandoc_ast(duck_blocks_assemble([
    duck_block_list([duck_block_list_item([duck_block_text('Item 1')]), duck_block_list_item([duck_block_text('Item 2')])])
])).blocks, '$[0].t');
----
"BulletList"

# Test list with simple string items (no inline children)
query I
SELECT json_extract(duck_blocks_to_pandoc_ast(duck_blocks_assemble([
    duck_block_list([duck_block_list_item('Simple 1'), duck_block_list_item('Simple 2')])
])).blocks, '$[0].c[0][0].c[0].c');
----
"Simple 1"

query I
SELECT json_array_length(json_extract(duck_blocks_to_pandoc_ast(duck_blocks_assemble([
    duck_block_list([duck_block_list_item('A'), duck_block_list_item('B'), duck_block_list_item('C')])
])).blocks, '$[0].c'));
----
3

# Test code block with language
query I
SELECT json_extract(duck_blocks_to_pandoc_ast(duck_block_code('sql', 'SELECT 1')).blocks, '$[0].c[0][1][0]');
----
"sql"

# ============================================================================
# Full Round-trip with duck_blocks_to_pandoc_ast
# Uses to_json() to convert struct to JSON string for round-trip parsing
# ============================================================================

# Test round-trip through complete AST
query I
SELECT pandoc_ast_to_blocks(to_json(duck_blocks_to_pandoc_ast(duck_block_heading(1, 'Test'))))[1].element_type;
----
heading

query I
SELECT pandoc_ast_to_blocks(to_json(duck_blocks_to_pandoc_ast(duck_block_paragraph('Hello'))))[1].content;
----
Hello

# Test complex document round-trip preserves block count
query I
SELECT len(pandoc_ast_to_blocks(to_json(duck_blocks_to_pandoc_ast(duck_blocks_assemble([
    duck_block_heading(1, 'Title'),
    duck_block_paragraph('Intro'),
    duck_block_code('python', 'x=1'),
    duck_block_hr(),
    duck_block_paragraph('Conclusion')
])))));
----
5

# Test heading level preserved in round-trip
query I
SELECT pandoc_ast_to_blocks(to_json(duck_blocks_to_pandoc_ast(duck_block_heading(2, 'Section'))))[1].attributes['heading_level'];
----
2

# Test code language preserved in round-trip
query I
SELECT pandoc_ast_to_blocks(to_json(duck_blocks_to_pandoc_ast(duck_block_code('javascript', 'let x'))))[1].attributes['language'];
----
javascript

# ============================================================================
# pandoc_ast table function tests with named parameters
# ============================================================================

# Test basic table function
query I
SELECT "pandoc-api-version" FROM pandoc_ast(duck_block_heading(1, 'Test'));
----
[1, 23, 1]

# Test custom api_version parameter
query I
SELECT "pandoc-api-version" FROM pandoc_ast(duck_block_heading(1, 'Test'), api_version := [1, 23]);
----
[1, 23]

# Test meta parameter with simple MAP - title only
query I
SELECT json_extract(meta, '$.title.t') FROM pandoc_ast(duck_block_heading(1, 'Test'), meta := {'title': 'My Document'});
----
"MetaInlines"

query I
SELECT json_extract(meta, '$.title.c[0].c') FROM pandoc_ast(duck_block_heading(1, 'Test'), meta := {'title': 'My Document'});
----
"My Document"

# Test meta with multiple fields
query I
SELECT json_extract(meta, '$.author.c[0].c') FROM pandoc_ast(duck_block_heading(1, 'Test'), meta := {'title': 'Doc', 'author': 'John Doe'});
----
"John Doe"

query I
SELECT json_extract(meta, '$.date.c[0].c') FROM pandoc_ast(duck_block_heading(1, 'Test'), meta := {'title': 'Doc', 'author': 'Jane', 'date': '2024-01-05'});
----
"2024-01-05"

# Test empty meta (default)
query I
SELECT meta FROM pandoc_ast(duck_block_heading(1, 'Test'));
----
{}

# ============================================================================
# Nested Level Handling Tests
# These tests verify that level-based nesting is preserved correctly
# ============================================================================

# ----------------------------------------------------------------------------
# Test 1: Nested inline formatting preserves levels
# ----------------------------------------------------------------------------

# Bold containing text and italic should have correct level hierarchy.
# EVERY element carries an explicit depth -- blocks and inlines alike, no NULLs.
query I
SELECT unnest(duck_block_bold([duck_block_text('a'), duck_block_italic('b')])).level;
----
1
2
2

# When nested in paragraph, levels should shift appropriately
query I
SELECT unnest(duck_block_paragraph([duck_block_bold([duck_block_text('a'), duck_block_italic('b')])])).level;
----
1
2
3
3

# Triple nesting: paragraph > bold > italic > text
query I
SELECT unnest(duck_block_paragraph([duck_block_bold([duck_block_italic([duck_block_text('deep')])])])).level;
----
1
2
3
4

# ----------------------------------------------------------------------------
# Test 2: Nested inline converts to correct Pandoc JSON structure
# ----------------------------------------------------------------------------

# Bold with nested italic should produce Strong containing Emph
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(
    duck_block_paragraph([duck_block_bold([duck_block_text('a '), duck_block_italic('b')])])
), '$[0].c[0].t');
----
"Strong"

query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(
    duck_block_paragraph([duck_block_bold([duck_block_text('a '), duck_block_italic('b')])])
), '$[0].c[0].c[1].t');
----
"Emph"

# ----------------------------------------------------------------------------
# Test 3: Nested lists structure (duck_block level hierarchy)
# ----------------------------------------------------------------------------

# A top-level list is at depth 1, its items at 2, their paragraphs at 3. Every
# element carries an explicit level -- `level` and adjacency together describe
# the whole tree, so there is nothing for a NULL to mean.
query II
SELECT elem.element_type, elem.level FROM (
    SELECT unnest(duck_block_list([duck_block_list_item('A'), duck_block_list_item('B')])) as elem
);
----
list	1
list_item	2
list_item	2

# Nested list: outer list items at level 2, inner list at level 2, inner items at level 3
query II
SELECT elem.element_type, elem.level FROM (
    SELECT unnest(duck_block_list([
        duck_block_list_item('First'),
        duck_block_list([duck_block_list_item('Nested A'), duck_block_list_item('Nested B')])
    ])) as elem
);
----
list	1
list_item	2
list	2
list_item	3
list_item	3

# ----------------------------------------------------------------------------
# Test 4: Nested lists convert to correct Pandoc JSON
# ----------------------------------------------------------------------------

# A nested list produces one BulletList with the nested list inside the first item
query I
SELECT json_array_length(duck_blocks_to_pandoc_blocks(duck_block_list([
    duck_block_list_item('First'),
    duck_block_list([duck_block_list_item('Nested')])
])));
----
1

# Verify the nested structure: outer list has 1 item, inner list has 1 item
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_list([
    duck_block_list_item('First'),
    duck_block_list([duck_block_list_item('Nested A'), duck_block_list_item('Nested B')])
])), '$[0].c[0][1].t');
----
"BulletList"

# Nested list has 2 items
query I
SELECT json_array_length(json_extract(duck_blocks_to_pandoc_blocks(duck_block_list([
    duck_block_list_item('First'),
    duck_block_list([duck_block_list_item('Nested A'), duck_block_list_item('Nested B')])
])), '$[0].c[0][1].c'));
----
2

# ----------------------------------------------------------------------------
# Test 5: Blockquote nesting preserves levels
# ----------------------------------------------------------------------------

# Blockquote with paragraph children
query II
SELECT elem.element_type, elem.level FROM (
    SELECT unnest(duck_block_blockquote(1, [duck_block_text('quoted text')])) as elem
);
----
blockquote	1
text	2

# Blockquote converts to Pandoc with content
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(
    duck_block_blockquote(1, [duck_block_text('Simple quote')])
), '$[0].t');
----
"BlockQuote"

query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(
    duck_block_blockquote(1, [duck_block_text('Simple quote')])
), '$[0].c[0].c[0].c');
----
"Simple quote"

# Blockquote with rich inline content
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(
    duck_block_blockquote(1, [duck_block_bold('Bold quote')])
), '$[0].c[0].c[0].t');
----
"Strong"

# Blockquote round-trip preserves type
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(
    duck_block_blockquote(1, [duck_block_text('Round trip')])
))[1].element_type;
----
blockquote

# ----------------------------------------------------------------------------
# Test 6: Mixed block/inline nesting
# ----------------------------------------------------------------------------

# Paragraph with link containing bold
query I
SELECT unnest(duck_block_paragraph([
    duck_block_text('See '),
    duck_block_link('http://x', [duck_block_bold('here')])
])).level;
----
1
2
2
3

# ----------------------------------------------------------------------------
# Test 7: List items with rich inline content
# ----------------------------------------------------------------------------

# List item with bold text should have correct levels
query II
SELECT elem.element_type, elem.level FROM (
    SELECT unnest(duck_block_list([
        duck_block_list_item([duck_block_bold('Important'), duck_block_text(' item')])
    ])) as elem
);
----
list	1
list_item	2
bold	3
text	3

# ============================================================================
# Table Round-Trip Tests
# ============================================================================

# ----------------------------------------------------------------------------
# Test 1: Basic table parsing
# ----------------------------------------------------------------------------

# Simple 2x2 table parses as table block type
query I
SELECT pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"},{"t":"AlignDefault"}],[0,0],[[{"t":"Plain","c":[{"t":"Str","c":"A"}]}],[{"t":"Plain","c":[{"t":"Str","c":"B"}]}]],[[[{"t":"Plain","c":[{"t":"Str","c":"1"}]}],[{"t":"Plain","c":[{"t":"Str","c":"2"}]}]]]]}]')[1].element_type;
----
table

# Table content is stored as JSON
query I
SELECT pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"},{"t":"AlignDefault"}],[0,0],[[{"t":"Plain","c":[{"t":"Str","c":"A"}]}],[{"t":"Plain","c":[{"t":"Str","c":"B"}]}]],[[[{"t":"Plain","c":[{"t":"Str","c":"1"}]}],[{"t":"Plain","c":[{"t":"Str","c":"2"}]}]]]]}]')[1].encoding;
----
json

# ----------------------------------------------------------------------------
# Test 2: Table round-trip preserves structure
# ----------------------------------------------------------------------------

# Round-trip simple table - verify Table type preserved
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"}],[0],[[{"t":"Plain","c":[{"t":"Str","c":"Header"}]}]],[[[{"t":"Plain","c":[{"t":"Str","c":"Cell"}]}]]]]}]')), '$[0].t');
----
"Table"

# Round-trip preserves header content
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"}],[0],[[{"t":"Plain","c":[{"t":"Str","c":"Header"}]}]],[[[{"t":"Plain","c":[{"t":"Str","c":"Cell"}]}]]]]}]')), '$[0].c[3][0][0].c[0].c');
----
"Header"

# Round-trip preserves cell content
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"}],[0],[[{"t":"Plain","c":[{"t":"Str","c":"Header"}]}]],[[[{"t":"Plain","c":[{"t":"Str","c":"Cell"}]}]]]]}]')), '$[0].c[4][0][0][0].c[0].c');
----
"Cell"

# ----------------------------------------------------------------------------
# Test 3: Table with rich text formatting
# ----------------------------------------------------------------------------

# Table with bold header
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"}],[0],[[{"t":"Plain","c":[{"t":"Strong","c":[{"t":"Str","c":"Bold"}]}]}]],[[[{"t":"Plain","c":[{"t":"Str","c":"Cell"}]}]]]]}]')), '$[0].c[3][0][0].c[0].t');
----
"Strong"

# Table with italic cell
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"}],[0],[[{"t":"Plain","c":[{"t":"Str","c":"Header"}]}]],[[[{"t":"Plain","c":[{"t":"Emph","c":[{"t":"Str","c":"Italic"}]}]}]]]]}]')), '$[0].c[4][0][0][0].c[0].t');
----
"Emph"

# Table with code in cell
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"}],[0],[[{"t":"Plain","c":[{"t":"Str","c":"Header"}]}]],[[[{"t":"Plain","c":[{"t":"Code","c":[["",[],""],"code"]}]}]]]]}]')), '$[0].c[4][0][0][0].c[0].t');
----
"Code"

# ----------------------------------------------------------------------------
# Test 4: Table with multiple columns and rows
# ----------------------------------------------------------------------------

# 3-column table preserves all alignment specs
query I
SELECT json_array_length(json_extract(duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"},{"t":"AlignLeft"},{"t":"AlignRight"}],[0,0,0],[[{"t":"Plain","c":[{"t":"Str","c":"A"}]}],[{"t":"Plain","c":[{"t":"Str","c":"B"}]}],[{"t":"Plain","c":[{"t":"Str","c":"C"}]}]],[]]}]')), '$[0].c[1]'));
----
3

# 2-row table preserves all rows
query I
SELECT json_array_length(json_extract(duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[[],[{"t":"AlignDefault"}],[0],[[{"t":"Plain","c":[{"t":"Str","c":"H"}]}]],[[[{"t":"Plain","c":[{"t":"Str","c":"R1"}]}]],[[{"t":"Plain","c":[{"t":"Str","c":"R2"}]}]]]]}]')), '$[0].c[4]'));
----
2

# ============================================================================
# Image Block Pandoc Conversion Tests
# ============================================================================

# Image block outputs as Para containing Image inline
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_image('http://example.com/img.png', 'Alt', 'Title')), '$[0].t');
----
"Para"

# Image inline is inside the Para
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_image('http://example.com/img.png', 'Alt', 'Title')), '$[0].c[0].t');
----
"Image"

# Image URL is preserved
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_image('http://example.com/img.png', 'Alt', 'Title')), '$[0].c[0].c[2][0]');
----
"http://example.com/img.png"

# Image alt text is preserved
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_image('http://example.com/img.png', 'Alt', 'Title')), '$[0].c[0].c[1][0].c');
----
"Alt"

# Image title is preserved
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_image('http://example.com/img.png', 'Alt', 'Title')), '$[0].c[0].c[2][1]');
----
"Title"

# ============================================================================
# Raw Block Round-Trip Tests
# ============================================================================

# Raw block outputs as RawBlock
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_raw('html', '<div>Test</div>')), '$[0].t');
----
"RawBlock"

# Raw block format is preserved
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_raw('html', '<div>Test</div>')), '$[0].c[0]');
----
"html"

# Raw block content is preserved
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_raw('html', '<div>Test</div>')), '$[0].c[1]');
----
"<div>Test</div>"

# Raw block with latex format
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_raw('latex', '\\textbf{bold}')), '$[0].c[0]');
----
"latex"

# Raw block round-trip preserves type
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_raw('html', '<span>X</span>')))[1].element_type;
----
raw

# Raw block round-trip preserves format attribute
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_raw('html', '<span>X</span>')))[1].attributes['format'];
----
html

# Raw block round-trip preserves content
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_raw('html', '<span>X</span>')))[1].content;
----
<span>X</span>

# ============================================================================
# Horizontal Rule Round-Trip Tests
# ============================================================================

# HR outputs as HorizontalRule
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_hr());
----
[{"t":"HorizontalRule"}]

# HR parses from Pandoc
query I
SELECT pandoc_ast_to_blocks('[{"t":"HorizontalRule"}]')[1].element_type;
----
hr

# HR round-trip preserves type
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_hr()))[1].element_type;
----
hr

# HR has empty content
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_hr()))[1].content;
----
(empty)

# ============================================================================
# Metadata Block Handling Tests
# ============================================================================

# Metadata blocks are skipped in Pandoc output (they belong in meta, not blocks)
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_metadata('{"title": "Test"}'));
----
[]

# Metadata mixed with other blocks - only non-metadata blocks output
query I
SELECT duck_blocks_to_pandoc_blocks(list_concat(duck_block_metadata('{"title": "Doc"}'), duck_block_paragraph('Content')));
----
[{"t":"Para","c":[{"t":"Str","c":"Content"}]}]

# ============================================================================
# Code Block Round-Trip Tests
# ============================================================================

# Code block outputs as CodeBlock
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_code('python', 'x = 1')), '$[0].t');
----
"CodeBlock"

# Code block language is in classes array
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_code('python', 'x = 1')), '$[0].c[0][1][0]');
----
"python"

# Code block content is preserved
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_code('python', 'print("Hello")')), '$[0].c[1]');
----
"print(\"Hello\")"

# Code block round-trip preserves type
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_code('sql', 'SELECT 1')))[1].element_type;
----
code

# Code block round-trip preserves language
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_code('javascript', 'let x')))[1].attributes['language'];
----
javascript

# Code block round-trip preserves content
query I
SELECT pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks(duck_block_code('rust', 'fn main() {}')))[1].content;
----
fn main() {}

# Code block with multiline content
query I
SELECT json_extract(duck_blocks_to_pandoc_blocks(duck_block_code('sql', 'SELECT *
FROM t')), '$[0].c[1]');
----
"SELECT *\nFROM t"

# Parsing CodeBlock from Pandoc preserves language
query I
SELECT pandoc_ast_to_blocks('[{"t":"CodeBlock","c":[["",["haskell"],[]],"main = putStrLn"]}]')[1].attributes['language'];
----
haskell

# ============================================================================
# Inline Code / Math preservation and structured inline children (issue #21)
#
# ExtractInlinesText only ever saw Str/Space/SoftBreak/LineBreak, so `Code` and
# `Math` inlines were dropped outright: "Run `make install` first." converted to
# "Run  first.". Rich inline runs now become kind='inline' children (the shape
# parse_markdown_to_duck_blocks emits and the renderer already styles), while
# text-only runs keep the flat, content-carrying shape.
# ============================================================================

# ----------------------------------------------------------------------------
# Text-only runs are unchanged: one block, text in `content`
# ----------------------------------------------------------------------------

query I
SELECT len(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"Hello"},{"t":"Space"},{"t":"Str","c":"world"}]}]'));
----
1

query I
SELECT pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"Hello"},{"t":"Space"},{"t":"Str","c":"world"}]}]')[1].content;
----
Hello world

# ----------------------------------------------------------------------------
# Code inlines survive (they used to disappear)
# ----------------------------------------------------------------------------

# The reported reproduction: "Run `make install` first."
query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"Run"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"make install"]},{"t":"Space"},{"t":"Str","c":"first."}]}]'));
----
Run make install first.

# The code text is carried by a structured inline child
query I
SELECT list_filter(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"Run"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"make install"]},{"t":"Space"},{"t":"Str","c":"first."}]}]'), b -> b.kind = 'inline' AND b.element_type = 'code')[1].content;
----
make install

# The parent block carries no duplicated (and truncated) text
query I
SELECT pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"Run"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"make install"]},{"t":"Space"},{"t":"Str","c":"first."}]}]')[1].content;
----
(empty)

# ----------------------------------------------------------------------------
# Math inlines survive
# ----------------------------------------------------------------------------

query I
SELECT list_filter(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"E"},{"t":"Space"},{"t":"Math","c":[{"t":"InlineMath"},"E=mc^2"]}]}]'), b -> b.kind = 'inline' AND b.element_type = 'math')[1].content;
----
E=mc^2

query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"E"},{"t":"Space"},{"t":"Math","c":[{"t":"InlineMath"},"E=mc^2"]}]}]'));
----
E E=mc^2

# ----------------------------------------------------------------------------
# Link text and image alt text must not regress into the structured shape
# ----------------------------------------------------------------------------

# Link text is a child of the link container
query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"See"},{"t":"Space"},{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"the docs"}],["http://x",""]]}]}]'));
----
See the docs

# The link keeps its href
query I
SELECT list_filter(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"See"},{"t":"Space"},{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"the docs"}],["http://x",""]]}]}]'), b -> b.element_type = 'link')[1].attributes['href'];
----
http://x

# Image alt text is kept as content plus an alt attribute, and src is the target
query I
SELECT list_filter(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"a"},{"t":"Space"},{"t":"Str","c":"duck"}],["duck.png","t"]]}]}]'), b -> b.element_type = 'image')[1].content;
----
a duck

query I
SELECT list_filter(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"a"},{"t":"Space"},{"t":"Str","c":"duck"}],["duck.png","t"]]}]}]'), b -> b.element_type = 'image')[1].attributes['src'];
----
duck.png

# ----------------------------------------------------------------------------
# Headings: title extraction sees the structured children (issues #20 + #21)
# ----------------------------------------------------------------------------

query I
SELECT duck_blocks_headings(pandoc_ast_to_blocks('[{"t":"Header","c":[2,["fmt",[],[]],[{"t":"Str","c":"The"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"mrconfig"]},{"t":"Space"},{"t":"Str","c":"format"}]]}]'))[1].title;
----
The mrconfig format

query I
SELECT duck_blocks_headings(pandoc_ast_to_blocks('[{"t":"Header","c":[2,["fmt",[],[]],[{"t":"Str","c":"The"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"mrconfig"]},{"t":"Space"},{"t":"Str","c":"format"}]]}]'))[1].id;
----
fmt

# ----------------------------------------------------------------------------
# element_order stays sequential across blocks and their inline children
# ----------------------------------------------------------------------------

query I
SELECT list_transform(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"Code","c":[["",[],[]],"c"]}]},{"t":"Para","c":[{"t":"Str","c":"b"}]}]'), b -> b.element_order);
----
[0, 1, 2, 3]

# ----------------------------------------------------------------------------
# Round-trip back to Pandoc JSON keeps the Code inline
# ----------------------------------------------------------------------------

query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"Run"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"make install"]}]}]'));
----
[{"t":"Para","c":[{"t":"Str","c":"Run"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"make install"]}]}]

# Rich inline text inside a Div child round-trips too
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Div","c":[["d",[],[]],[{"t":"Para","c":[{"t":"Code","c":[["",[],[]],"x"]}]}]]}]'));
----
[{"t":"Div","c":[["d",[],[]],[{"t":"Para","c":[{"t":"Code","c":[["",[],[]],"x"]}]}]]}]

# ============================================================================
# Underline (import + export)
# spec: docs/superpowers/specs/2026-08-31-pandoc-gaps-and-reader-dispatch-design.md
# ============================================================================

query I
SELECT pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Underline","c":[{"t":"Str","c":"under"}]},{"t":"Str","c":"!"}]}]')[2].element_type;
----
underline

query I
SELECT pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Underline","c":[{"t":"Str","c":"under"}]},{"t":"Str","c":"!"}]}]')[3].content;
----
under

query I
SELECT duck_blocks_to_pandoc_ast(duck_block_paragraph([duck_block_text('An '), duck_block_underline('underlined'), duck_block_text(' phrase.')])).blocks::VARCHAR LIKE '%"t":"Underline"%';
----
true

query I
SELECT duck_blocks_to_pandoc_ast(duck_block_paragraph([duck_block_text('An '), duck_block_underline('underlined'), duck_block_text(' phrase.')])).blocks::VARCHAR LIKE '%[underline]%';
----
false

# ============================================================================
# Unknown block constructors pass through as generic (no silent drops)
# ============================================================================

query I
SELECT len(pandoc_ast_to_blocks('[{"t":"NotARealConstructor","c":[1,2]}]'));
----
1

query I
SELECT pandoc_ast_to_blocks('[{"t":"NotARealConstructor","c":[1,2]}]')[1].element_type;
----
generic

query I
SELECT pandoc_ast_to_blocks('[{"t":"NotARealConstructor","c":[1,2]}]')[1].kind;
----
block

query I
SELECT pandoc_ast_to_blocks('[{"t":"NotARealConstructor","c":[1,2]}]')[1].attributes['source_type'];
----
NotARealConstructor

query I
SELECT pandoc_ast_to_blocks('[{"t":"NotARealConstructor","c":[1,2]}]')[1].encoding;
----
json

# document length is preserved: 3 blocks in, 3 blocks out
query I
SELECT len(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Bogus"},{"t":"Para","c":[{"t":"Str","c":"b"}]}]'));
----
3

# ============================================================================
# Unknown inline constructors keep their text
# ============================================================================

# structured path: a generic marker is emitted AND the words survive as children
query I
SELECT list_contains(
  list_transform(pandoc_ast_to_blocks(
    '[{"t":"Para","c":[{"t":"Bogus","c":[{"t":"Str","c":"keepme"}]},{"t":"Code","c":[["",[],[]],"x"]}]}]'),
    b -> b.content),
  'keepme');
----
true

query I
SELECT list_contains(
  list_transform(pandoc_ast_to_blocks(
    '[{"t":"Para","c":[{"t":"Bogus","c":[{"t":"Str","c":"keepme"}]},{"t":"Code","c":[["",[],[]],"x"]}]}]'),
    b -> b.element_type),
  'generic');
----
true

# no bracket placeholder is emitted anywhere
query I
SELECT pandoc_ast_to_blocks(
  '[{"t":"Para","c":[{"t":"Bogus","c":[{"t":"Str","c":"keepme"}]},{"t":"Code","c":[["",[],[]],"x"]}]}]')::VARCHAR LIKE '%[Bogus]%';
----
false

# pandoc_inlines_to_text must not drop text it cannot classify
query I
SELECT pandoc_inlines_to_text('[{"t":"Str","c":"An"},{"t":"Space"},{"t":"Underline","c":[{"t":"Str","c":"underlined"}]},{"t":"Space"},{"t":"Str","c":"here."}]');
----
An underlined here.

query I
SELECT pandoc_inlines_to_text('[{"t":"Str","c":"An"},{"t":"Space"},{"t":"Bogus","c":[{"t":"Str","c":"kept"}]},{"t":"Space"},{"t":"Str","c":"here."}]');
----
An kept here.

# ============================================================================
# LineBlock
# ============================================================================

query I
SELECT pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"one"}],[{"t":"Str","c":"two"}]]}]')[1].element_type;
----
lineblock

# lines are joined with a newline in content
query I
SELECT pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"one"}],[{"t":"Str","c":"two"}]]}]')[1].content
       = 'one' || chr(10) || 'two';
----
true

# a single-line LineBlock has no trailing newline
query I
SELECT pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"solo"}]]}]')[1].content;
----
solo

# ============================================================================
# DefinitionList is A LIST KIND -- `list` with list_type='definition', terms and
# definitions as list_items tagged by attributes['role'].
#
# That is the extensibility `list_type` was made canonical FOR: a boolean cannot
# say "definition". Zero new types, and every consumer that already walks lists
# gets definition lists free.
#
# It was opaque JSON before, which meant it RENDERED ITS OWN AST to the screen
# and its serialisation polluted search -- worse than table, which merely
# rendered nothing.
# ============================================================================

query IIII
SELECT b.element_type, coalesce(b.attributes['list_type'],'-'), coalesce(b.attributes['role'],'-'), coalesce(b.content,'')
FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]')) AS b);
----
list	definition	-	(empty)
list_item	-	term	term
list_item	-	definition	def

# The term and the definition sit in the list_item's own `content` -- SPEC 6.0.
# 5.0 gave each a `plain` child, which meant a container with a single text child
# had two possible shapes depending on who built it. `plain` is now only for text
# that has nowhere else to live: alongside block siblings, or at the top level.
#
# DISCRIMINATING: a definition list must be a LIST but must NOT be an ordinary
# bullet list. list_type is what carries that, and a consumer reading only
# `ordered` sees 'false' for both -- which is exactly why a boolean could not grow.
query II
SELECT (SELECT b.attributes['list_type'] FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"t"}],[[{"t":"Plain","c":[{"t":"Str","c":"d"}]}]]]]}]')) AS b) WHERE b.element_type='list'),
       (SELECT b.attributes['list_type'] FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"x"}]}]]}]')) AS b) WHERE b.element_type='list');
----
definition	bullet

# Its text is the terms and definitions, not its serialisation.
query II
SELECT duck_blocks_to_text(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]')) LIKE '%term%',
       duck_blocks_to_text(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]')) LIKE '%"t":%';
----
true	false

# encoding is TEXT now, not json -- the container carries no serialisation at all.
query II
SELECT pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]')[1].encoding,
       pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]')[1].content = '';
----
text	true

# The term and definition are reachable as STRUCTURE rather than by grepping a
# JSON blob -- keyed by role, not by position. The earlier version indexed [3],
# [4] and [5], which asserts the layout rather than the reachability it is named
# for, and duly broke on a shape change that reached the text just fine.
query II
SELECT (SELECT b.content FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]')) AS b) WHERE b.attributes['role'] = 'term'),
       (SELECT b.content FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]')) AS b) WHERE b.attributes['role'] = 'definition');
----
term	def

# DISCRIMINATING: both roles must be present and DISTINCT. Asserting only that
# 'term' is somewhere in the output passes for a reader that emits the term twice
# and loses the definition entirely.
query III
SELECT count(*) FILTER (WHERE b.attributes['role'] = 'term'),
       count(*) FILTER (WHERE b.attributes['role'] = 'definition'),
       count(*) FILTER (WHERE b.element_type = 'plain')
FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]')) AS b);
----
1	1	0

# Round trip is byte-identical: term/definition items pair back into
# DefinitionList's [([Inline],[[Block]])].
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]'))::VARCHAR = '[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"def"}]}]]]]}]';
----
true

# DISCRIMINATING: an ordinary bullet list must still export as a BulletList.
# Routing every list through the DefinitionList path would pass the assertion
# above while destroying every normal list in every document.
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_list(['a','b']))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}],[{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]}]';
----
true

# ============================================================================
# Figure -- structural, with a general-purpose caption container block
# ============================================================================

query I
SELECT pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"cap"}],["img.png",""]]}]}]]}]')[1].element_type;
----
figure

# the image survives as a real inline, not opaque JSON
query I
SELECT list_contains(list_transform(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"cap"}],["img.png",""]]}]}]]}]'), b -> b.element_type), 'image');
----
true

# a caption container is emitted
query I
SELECT list_contains(list_transform(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"cap"}],["img.png",""]]}]}]]}]'), b -> b.element_type), 'caption');
----
true

# CONTENT COMES BEFORE CAPTION, so a renderer walking the flat list emits the
# image before the words describing it
query I
SELECT list_position(list_transform(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"cap"}],["img.png",""]]}]}]]}]'), b -> b.element_type), 'image')
     < list_position(list_transform(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"cap"}],["img.png",""]]}]}]]}]'), b -> b.element_type), 'caption');
----
true

# caption FORMATTING survives -- the regression test for structured captions
query I
SELECT list_contains(list_transform(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]}]],[{"t":"Plain","c":[{"t":"Str","c":"body"}]}]]}]'), b -> b.element_type), 'bold');
----
true

# a figure with an empty caption emits no caption container
query I
SELECT list_contains(list_transform(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[]],[{"t":"Plain","c":[{"t":"Str","c":"body"}]}]]}]'), b -> b.element_type), 'caption');
----
false

# nested inside a Div, the figure is no longer dropped
query I
SELECT list_contains(list_transform(pandoc_ast_to_blocks('[{"t":"Div","c":[["",["note"],[]],[{"t":"Figure","c":[["",[],[]],[null,[]],[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]'), b -> b.element_type), 'figure');
----
true

# the caption container is a SIBLING of the content blocks -- both are children
# of the figure -- so they sit at the same level. The export walk depends on this.
# The figure's content is a `plain`, not a `paragraph`: Pandoc's Figure holds
# Plain[Image], and since spec 4.0 Plain maps to `plain` rather than collapsing
# onto `paragraph`.
query I
SELECT (SELECT b.level FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"cap"}],["img.png",""]]}]}]]}]')) AS b) WHERE b.element_type = 'caption')
     = (SELECT b.level FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"cap"}],["img.png",""]]}]}]]}]')) AS b) WHERE b.element_type = 'plain' LIMIT 1);
----
true

# ============================================================================
# pandoc-api-version
# pandoc 3.x rejects anything below [1,23] outright ("Incompatible API
# versions"), so the old [1,20] default made every export unreadable by the
# installed pandoc.
# ============================================================================

query I
SELECT duck_blocks_to_pandoc_ast(duck_block_paragraph([duck_block_text('hi')]))['pandoc-api-version'];
----
[1, 23, 1]

query I
SELECT (SELECT "pandoc-api-version" FROM pandoc_ast(duck_block_paragraph([duck_block_text('hi')])));
----
[1, 23, 1]

# the table function's override still works
query I
SELECT (SELECT "pandoc-api-version" FROM pandoc_ast(duck_block_paragraph([duck_block_text('hi')]), api_version := [1,23]));
----
[1, 23]

# ============================================================================
# kind='value' -- document metadata
# Pandoc's Meta is a recursive MetaValue tree (MetaMap/MetaList/MetaInlines/
# MetaBool/MetaString). Before this it was dropped entirely: title, tags,
# author and draft all round-tripped to {}.
# ============================================================================

# metadata arrives as kind='value' elements
query I
SELECT list_contains(list_transform(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"T"}]},"draft":{"t":"MetaBool","c":true},"tags":{"t":"MetaList","c":[{"t":"MetaInlines","c":[{"t":"Str","c":"one"}]}]},"author":{"t":"MetaMap","c":{"name":{"t":"MetaInlines","c":[{"t":"Str","c":"Someone"}]}}}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Body"}]}]}'), b -> b.kind), 'value');
----
true

# the document body is unaffected
query I
SELECT pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"T"}]},"draft":{"t":"MetaBool","c":true},"tags":{"t":"MetaList","c":[{"t":"MetaInlines","c":[{"t":"Str","c":"one"}]}]},"author":{"t":"MetaMap","c":{"name":{"t":"MetaInlines","c":[{"t":"Str","c":"Someone"}]}}}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Body"}]}]}')[1].element_type;
----
paragraph

# each MetaValue shape is represented
query I
SELECT list_has_all(
  list_transform(list_filter(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"T"}]},"draft":{"t":"MetaBool","c":true},"tags":{"t":"MetaList","c":[{"t":"MetaInlines","c":[{"t":"Str","c":"one"}]}]},"author":{"t":"MetaMap","c":{"name":{"t":"MetaInlines","c":[{"t":"Str","c":"Someone"}]}}}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Body"}]}]}'), b -> b.kind = 'value'), b -> b.element_type),
  ['inlines', 'bool', 'list', 'map']);
----
true

# keys are preserved
query I
SELECT list_has_all(
  list_transform(list_filter(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"T"}]},"draft":{"t":"MetaBool","c":true},"tags":{"t":"MetaList","c":[{"t":"MetaInlines","c":[{"t":"Str","c":"one"}]}]},"author":{"t":"MetaMap","c":{"name":{"t":"MetaInlines","c":[{"t":"Str","c":"Someone"}]}}}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Body"}]}]}'), b -> b.kind = 'value'), b -> b.attributes['key']),
  ['title', 'draft', 'tags', 'author']);
----
true

# ROUND TRIP: meta is no longer destroyed
query I
SELECT duck_blocks_to_pandoc_ast(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"T"}]},"draft":{"t":"MetaBool","c":true},"tags":{"t":"MetaList","c":[{"t":"MetaInlines","c":[{"t":"Str","c":"one"}]}]},"author":{"t":"MetaMap","c":{"name":{"t":"MetaInlines","c":[{"t":"Str","c":"Someone"}]}}}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Body"}]}]}')).meta::VARCHAR LIKE '%title%';
----
true

query I
SELECT duck_blocks_to_pandoc_ast(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"T"}]},"draft":{"t":"MetaBool","c":true},"tags":{"t":"MetaList","c":[{"t":"MetaInlines","c":[{"t":"Str","c":"one"}]}]},"author":{"t":"MetaMap","c":{"name":{"t":"MetaInlines","c":[{"t":"Str","c":"Someone"}]}}}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Body"}]}]}')).meta::VARCHAR LIKE '%MetaBool%';
----
true

# ============================================================================
# BLOCK `generic` round-trips LOSSLESSLY.
#
# The import side stores the whole constructor object -- `t` included -- and its
# comment says it does so "so export can reconstitute it including `t`". Export
# never did: an unmapped block fell through to the Para fallback and its stored
# JSON was emitted as a Str, so a round trip printed a raw AST blob into the
# document body AS VISIBLE TEXT. Corruption that looks like content.
#
# Found by checking the block side after the webbed session reported the mirror
# image of it in their own renderer -- they fixed a block fallthrough and missed
# the inline one; this repo fixed the inline one (e44efe6) and missed the block.
# ============================================================================

# The whole constructor comes back byte-for-byte.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Marquee","c":[["",[],[]],[{"t":"Plain","c":[{"t":"Str","c":"KEPT"}]}]]}]}'))::VARCHAR = '[{"t":"Marquee","c":[["",[],[]],[{"t":"Plain","c":[{"t":"Str","c":"KEPT"}]}]]}]';
----
true

# DISCRIMINATING: the old bug produced a Para, and it produced one that still
# contained the text "KEPT" -- so asserting merely that KEPT survived would have
# PASSED against the defect. The property is that no Para was fabricated and the
# constructor name is still `t`, not prose.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Marquee","c":[["",[],[]],[{"t":"Plain","c":[{"t":"Str","c":"KEPT"}]}]]}]}'))::VARCHAR NOT LIKE '%"t":"Para"%';
----
true

# The stored JSON must never reappear as a Str payload, which is how the blob
# became visible text.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Marquee","c":[["",[],[]],[{"t":"Plain","c":[{"t":"Str","c":"KEPT"}]}]]}]}'))::VARCHAR NOT LIKE '%Str","c":"{%';
----
true

# Import still records what it stood in for.
query II
SELECT b.element_type, b.attributes['source_type']
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Marquee","c":[["",[],[]],[{"t":"Plain","c":[{"t":"Str","c":"KEPT"}]}]]}]}')) AS b)
WHERE b.kind = 'block';
----
generic	Marquee

# INLINE `generic` whose `c` is directly an inline array keeps its text and
# degrades to a Span carrying source_type as a class (e44efe6).
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Blink","c":[{"t":"Str","c":"KEPT"}]}]}]}'))::VARCHAR = '[{"t":"Para","c":[{"t":"Span","c":[["",["Blink"],[]],[{"t":"Str","c":"KEPT"}]]}]}]';
----
true

# ============================================================================
# STRUCTURAL LISTS. The Pandoc reader used to store a list's whole `c` as
# encoding='json', which made decoding every consumer's problem and produced the
# same defects in three independent implementations -- and, unnoticed by any of
# them, exported back to an EMPTY BulletList.
#
# Reported by the duckeye and duckdb_markdown sessions; the empty-export was
# found here while verifying their report.
# ============================================================================

# list -> list_item -> the item's own text. No JSON, no opaque content.
#
# SPEC 6.0: a TIGHT item's text sits in the item's own `content`, because a lone
# Pandoc `Plain` IS the single text child v1's content rule describes. 5.0 gave
# it a `plain` child instead, which meant `<li>text</li>` and `<p>text</p>` --
# the same situation -- had different shapes. A LOOSE item still has a
# `paragraph` child, and that pair is what carries tight-vs-loose now.
query IIIII
SELECT b.element_type, b.kind, coalesce(b.level::VARCHAR,'NULL'), b.encoding, coalesce(b.content,'')
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"alpha"}]}]]}]}')) AS b);
----
list	block	1	text	(empty)
list_item	block	2	text	alpha

# DISCRIMINATING against the shape change itself: the LOOSE item must still grow
# a child, or "tight and loose look the same" would pass the assertion above.
query IIIII
SELECT b.element_type, b.kind, coalesce(b.level::VARCHAR,'NULL'), b.encoding, coalesce(b.content,'')
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"alpha"}]}]]}]}')) AS b);
----
list	block	1	text	(empty)
list_item	block	2	text	(empty)
paragraph	block	3	text	alpha

# DISCRIMINATING: item COUNT was already right while every item was blank, so
# counting items would have passed against the defect. The property is that a
# round trip returns the words.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"alpha"}]}],[{"t":"Plain","c":[{"t":"Str","c":"beta"}]}]]}]}'))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"alpha"}]}],[{"t":"Plain","c":[{"t":"Str","c":"beta"}]}]]}]';
----
true

# An ordered list's start/style/delim lived ONLY inside the opaque JSON, so every
# ordered list silently came back as "1." in Decimal/Period.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"OrderedList","c":[[3,{"t":"LowerRoman"},{"t":"OneParen"}],[[{"t":"Plain","c":[{"t":"Str","c":"three"}]}]]]}]}'))::VARCHAR = '[{"t":"OrderedList","c":[[3,{"t":"LowerRoman"},{"t":"OneParen"}],[[{"t":"Plain","c":[{"t":"Str","c":"three"}]}]]]}]';
----
true

# ...and they are reachable as attributes, which is what a consumer reads.
query III
SELECT b.attributes['start'], b.attributes['number_style'], b.attributes['number_delim']
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"OrderedList","c":[[3,{"t":"LowerRoman"},{"t":"OneParen"}],[[{"t":"Plain","c":[{"t":"Str","c":"x"}]}]]]}]}')) AS b)
WHERE b.element_type = 'list';
----
3	LowerRoman	OneParen

# TEXT/SEARCH: content words were only reachable inside a JSON blob, so a phrase
# spanning a Space did not match and AST machinery matched as a false positive.
query II
SELECT duck_blocks_to_text(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"alpha"},{"t":"Space"},{"t":"Str","c":"bullet"}]}]]}]}')) LIKE '%alpha bullet%',
       duck_blocks_to_text(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"OrderedList","c":[[1,{"t":"Decimal"},{"t":"Period"}],[[{"t":"Plain","c":[{"t":"Str","c":"x"}]}]]]}]}')) LIKE '%Decimal%';
----
true	false

# RENDER: bullets carry their text, ordered lists number, nesting indents.
query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]}'), 40) LIKE '%outer%inner%';
----
true

query I
SELECT regexp_replace(duck_blocks_render_ansi(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"OrderedList","c":[[1,{"t":"Decimal"},{"t":"Period"}],[[{"t":"Plain","c":[{"t":"Str","c":"first"}]}]]]}]}'), 40), '\x1b\[[0-9;]*m', '', 'g') LIKE '% 1. first%';
----
true

# The builders' JSON list shape must keep working -- both are legal.
query I
SELECT regexp_replace(duck_blocks_render_ansi(duck_block_list(['alpha','beta']), 40), '\x1b\[[0-9;]*m', '', 'g') LIKE '%• alpha%• beta%';
----
true

# ============================================================================
# STRUCTURAL BLOCKQUOTES. Was encoding='json', so every renderer that showed
# `content` put raw Pandoc AST on the screen.
# ============================================================================

query IIII
SELECT b.element_type, b.kind, coalesce(b.level::VARCHAR,'NULL'), b.encoding
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"quoted"}]}]}]}')) AS b);
----
blockquote	block	1	text
paragraph	block	2	text

# DISCRIMINATING: the raw-AST bug still rendered the word "quoted" (inside the
# JSON), so asserting the word appeared would have PASSED. The property is that
# no AST punctuation reaches the screen.
query II
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"quoted"}]}]}]}'), 40) LIKE '%quoted%',
       duck_blocks_render_ansi(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"quoted"}]}]}]}'), 40) LIKE '%"t":"Para"%';
----
true	false

# A quote's children must stay INSIDE it on export. Emitting them as siblings
# would silently lift quoted text into the body -- attribution-changing.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"inside"}]}]},{"t":"Para","c":[{"t":"Str","c":"outside"}]}]}'))::VARCHAR = '[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"inside"}]}]},{"t":"Para","c":[{"t":"Str","c":"outside"}]}]';
----
true

# The block after the quote must NOT be quoted in the rendering either.
query I
SELECT regexp_replace(duck_blocks_render_ansi(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"inside"}]}]},{"t":"Para","c":[{"t":"Str","c":"outside"}]}]}'), 40), '\x1b\[[0-9;]*m', '', 'g') NOT LIKE '%▌ outside%';
----
true

# Builder-shaped quotes keep working -- both shapes legal, and under SPEC 6.0 the
# two shapes now MEAN the two Pandoc constructors:
#
#   duck_block_blockquote('q')                   -> BlockQuote[Plain]  (single text child)
#   duck_block_blockquote([duck_block_paragraph]) -> BlockQuote[Para]
#
# The string form used to emit Para unconditionally, which made `BlockQuote[Plain]`
# WRITE-ONLY: it read back fine and exported as Para, so a round trip downgraded it
# with nothing to see. Both survive now, which is why this asserts the PAIR -- the
# old single assertion passed while one of the two constructors was unreachable.
query II
SELECT duck_blocks_to_pandoc_blocks(duck_block_blockquote('builder quote'))::VARCHAR = '[{"t":"BlockQuote","c":[{"t":"Plain","c":[{"t":"Str","c":"builder quote"}]}]}]',
       duck_blocks_to_pandoc_blocks(duck_block_blockquote([duck_block_paragraph('builder quote')]))::VARCHAR = '[{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"builder quote"}]}]}]';
----
true	true

# ============================================================================
# EXPORT BRANCHES FOR deflist AND lineblock.
#
# Found by sweeping every block type through the exporter after fixing the same
# defect for `generic` at b943f43 -- the sweep that should have accompanied that
# fix. Neither type had an export branch, so both fell to the terminal Para
# fallback and came back as a paragraph whose VISIBLE TEXT was their own raw AST.
# ============================================================================

query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"definition"}]}]]]]}]}'))::VARCHAR = '[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"definition"}]}]]]]}]';
----
true

query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"LineBlock","c":[[{"t":"Str","c":"line one"}],[{"t":"Str","c":"line two"}]]}]}'))::VARCHAR = '[{"t":"LineBlock","c":[[{"t":"Str","c":"line one"}],[{"t":"Str","c":"line two"}]]}]';
----
true

# DISCRIMINATING for both: the defect PRESERVED the words (they were inside the
# JSON it printed), so asserting "term"/"line one" survived would have passed.
# The property is that no Para was fabricated and the constructor name survives.
query II
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"DefinitionList","c":[[[{"t":"Str","c":"term"}],[[{"t":"Plain","c":[{"t":"Str","c":"definition"}]}]]]]}]}'))::VARCHAR NOT LIKE '%"t":"Para"%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"LineBlock","c":[[{"t":"Str","c":"line one"}]]}]}'))::VARCHAR NOT LIKE '%"t":"Para"%';
----
true	true

# ============================================================================
# NESTED INLINE CONTAINMENT.
#
# Not a fix -- a guard. The webbed session found their writer walked the inline
# run FLAT and ignored level, so a wrapper rendered empty and its text escaped
# it: "a <b>bold <i>inner</i></b> c" lost the bolding on "bold " silently. That
# is the containment defect they had already fixed for BLOCKS, one level down in
# the adjacent function. panduck predicted it in webbed's code without seeing it.
#
# This path is correct here, verified rather than assumed. Pinned because three
# sibling extensions had the same defect and nothing here would have noticed if
# a future change introduced it.
# ============================================================================

# The reader emits genuinely nested inlines: wrapper with NULL content, children
# one level deeper.
# NOTE the reader writes an EMPTY STRING for a wrapper's content, while the block
# builders write NULL. Both mean "no content of my own" and nothing reads them
# differently today, but it is a divergence -- recorded here so the next person
# measures it rather than assuming, as this test's first version did.
query III
SELECT b.element_type, b.level, coalesce(b.content, '<NULL>')
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Strong","c":[{"t":"Str","c":"bold"},{"t":"Emph","c":[{"t":"Str","c":"inner"}]}]}]}]}')) AS b)
WHERE b.kind = 'inline';
----
bold	2	(empty)
text	3	bold
italic	3	(empty)
text	4	inner

# DISCRIMINATING: a flat walk emits the wrapper EMPTY and lets its text escape,
# which still renders every word -- so asserting the words survive would pass
# against the defect. The property is that the bold region CONTAINS the nested
# text, i.e. bold-on precedes it and bold-off follows it.
query I
SELECT duck_blocks_render_ansi(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"Space"},{"t":"Strong","c":[{"t":"Str","c":"bold"},{"t":"Space"},{"t":"Emph","c":[{"t":"Str","c":"inner"}]}]},{"t":"Space"},{"t":"Str","c":"c"}]}]}'), 40)
       LIKE '%' || chr(27) || '[1mbold ' || chr(27) || '[3minner%';
----
true

# Three levels nest LIFO and every wrapper closes; adjacent wrappers stay apart.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Strong","c":[{"t":"Str","c":"b"},{"t":"Emph","c":[{"t":"Str","c":"i"},{"t":"Strikeout","c":[{"t":"Str","c":"s"}]}]}]},{"t":"Str","c":"|"},{"t":"Emph","c":[{"t":"Str","c":"second"}]}]}]}'))::VARCHAR = '[{"t":"Para","c":[{"t":"Strong","c":[{"t":"Str","c":"b"},{"t":"Emph","c":[{"t":"Str","c":"i"},{"t":"Strikeout","c":[{"t":"Str","c":"s"}]}]}]},{"t":"Str","c":"|"},{"t":"Emph","c":[{"t":"Str","c":"second"}]}]}]';
----
true

# A wrapper whose own content is empty must not also emit that emptiness as an
# element. duckdb_markdown's version of this produced "My ****Doc".
query I
SELECT duck_blocks_to_text(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Str","c":"My"},{"t":"Space"},{"t":"Strong","c":[{"t":"Str","c":"Doc"}]}]}]}'));
----
My Doc

# ============================================================================
# A list_item may hold MULTIPLE blocks. <li><p>a</p><p>b</p></li> is ordinary in
# EPUB and HTML, and the exporter kept only the first paragraph -- silent loss of
# everything after it. Found by testing the case panduck asked about BEFORE
# answering them rather than after.
# ============================================================================

query IIII
SELECT b.element_type, coalesce(b.level::VARCHAR,'NULL'), coalesce(b.content,'-'), b.kind
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Para","c":[{"t":"Str","c":"b"}]}]]}]}')) AS b);
----
list	1	(empty)	block
list_item	2	(empty)	block
paragraph	3	a	block
paragraph	3	b	block

# DISCRIMINATING: the defect kept the FIRST paragraph, so asserting that the item
# survives, or that 'a' survives, would both have passed against it. The property
# is that the SECOND paragraph reaches the output.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Para","c":[{"t":"Str","c":"b"}]}]]}]}'))::VARCHAR LIKE '%"c":"b"%';
----
true

# Both blocks stay inside the SAME item -- one item holding two paragraphs, not
# two items. Splitting them would also make 'b' survive while corrupting the list.
#
# BYTE-IDENTICAL since spec 4.0: the input's two Paras come back as two Paras.
# Before `plain` existed the first was forced to Plain, because the exporter had
# only one constructor for a list item's first block and could not tell a tight
# item from a loose one.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Para","c":[{"t":"Str","c":"b"}]}]]}]}'))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Para","c":[{"t":"Str","c":"b"}]}]]}]';
----
true

# A multi-block item is structurally sound, so the containment lint stays quiet.
query I
SELECT count(*) FROM (SELECT unnest(duck_blocks_lint(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Para","c":[{"t":"Str","c":"b"}]}]]}]}'))) AS w);
----
0

# ============================================================================
# STORED 1.x DATA STILL CONVERTS.
#
# The spec promises "both old forms are still ACCEPTED on export, so stored 1.x
# block lists keep converting". That promise was FALSE for the JSON list form:
# ConvertListToPandocVal walks children, a 1.x list has none, and the result was
# [{"t":"BulletList","c":[]}] -- silent total loss of every item.
#
# This is not hypothetical data. The community build (078a9b3) produces exactly
# this shape, so anything persisted from it hit this path. Found by auditing the
# rulings written into the spec against the code, rather than trusting them.
# ============================================================================

query I
SELECT duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'list','content':'["a","b"]','level':1,'encoding':'json','attributes':MAP{'ordered':'false'},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}],[{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]}]';
----
true

# DISCRIMINATING: the defect produced a well-formed BulletList, so asserting that
# a BulletList comes out would have passed against it. The property is that the
# ITEMS are in it.
query I
SELECT duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'list','content':'["a","b"]','level':1,'encoding':'json','attributes':MAP{'ordered':'false'},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])::VARCHAR NOT LIKE '%"c":[]%';
----
true

# 1.x ordered lists keep their ordering.
query I
SELECT duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'list','content':'["a"]','level':1,'encoding':'json','attributes':MAP{'ordered':'true'},'element_order':0}::STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR,VARCHAR), element_order INTEGER)])::VARCHAR LIKE '%OrderedList%';
----
true

# The 2.0 structural path must be unaffected -- the legacy branch only fires when
# there are no children to walk.
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_list(['a','b']))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}],[{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]}]';
----
true

# ============================================================================
# `ordered` is the attribute spec v1.0 documents for list orderedness. The Pandoc
# reader emitted only `list_type`, which arrived later, so a consumer written
# against the PUBLISHED v1 spec read nothing at all from a Pandoc-produced list.
# Both producers now emit both names.
# ============================================================================

query IIII
SELECT (SELECT b.attributes['ordered'] FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"OrderedList","c":[[1,{"t":"Decimal"},{"t":"Period"}],[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}]]]}]}')) AS b) WHERE b.element_type='list'),
       (SELECT b.attributes['ordered'] FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}]]}]}')) AS b) WHERE b.element_type='list'),
       (SELECT b.attributes['ordered'] FROM (SELECT unnest(duck_block_list(true,['a'])) AS b) WHERE b.element_type='list'),
       (SELECT b.attributes['ordered'] FROM (SELECT unnest(duck_block_list(['a'])) AS b) WHERE b.element_type='list');
----
true	false	true	false

# DISCRIMINATING: list_type was always present, so asserting orderedness is
# READABLE would have passed against the defect. The property is that v1's name
# specifically is there.
query II
SELECT (SELECT b.attributes['list_type'] FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"OrderedList","c":[[1,{"t":"Decimal"},{"t":"Period"}],[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}]]]}]}')) AS b) WHERE b.element_type='list'),
       (SELECT b.attributes['ordered'] IS NOT NULL FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"OrderedList","c":[[1,{"t":"Decimal"},{"t":"Period"}],[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}]]]}]}')) AS b) WHERE b.element_type='list');
----
ordered	true

# ============================================================================
# `plain` -- Pandoc's Plain constructor, and HTML text not wrapped in a <p>.
#
# This reader mapped Plain and Para BOTH to `paragraph`, so the TIGHT vs LOOSE
# list distinction was lost. webbed lost the same distinction independently, by
# flattening list items to strings -- two readers, two mechanisms, same loss,
# neither aware. That is why it is answered in the vocabulary rather than in
# either reader.
# ============================================================================

# tight and loose are now DIFFERENT shapes, and each round-trips to its own
# constructor.
query II
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"x"}]}]]}]}'))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"x"}]}]]}]',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}'))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]';
----
true	true

# DISCRIMINATING: before `plain`, BOTH of the above round-tripped to Plain, so
# asserting the tight one alone would have passed against the defect. The
# property is that the two inputs produce DIFFERENT outputs.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"x"}]}]]}]}'))::VARCHAR
    <> duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}'))::VARCHAR;
----
true

# A `plain` must survive EVERY container. Found by sweeping rather than reasoning:
# inside a div, blockquote or figure it was dropped entirely, because the child
# walk tested one type name and the fallthrough ate the rest.
query III
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"Plain","c":[{"t":"Str","c":"in"}]}]]}]}'))::VARCHAR LIKE '%"t":"Plain"%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BlockQuote","c":[{"t":"Plain","c":[{"t":"Str","c":"in"}]}]}]}'))::VARCHAR LIKE '%"t":"Plain"%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[],["i.png",""]]}]}]]}]}'))::VARCHAR LIKE '%"t":"Plain"%';
----
true	true	true

# A top-level plain must not fall to the terminal Para fallback.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Plain","c":[{"t":"Str","c":"bare"}]}]}'))::VARCHAR = '[{"t":"Plain","c":[{"t":"Str","c":"bare"}]}]';
----
true

# It renders and extracts exactly like a paragraph -- ignoring it costs spacing,
# not content.
query II
SELECT regexp_replace(duck_blocks_render_ansi(duck_block_plain('bare'), 30), '\x1b\[[0-9;]*m', '', 'g') LIKE '%bare%',
       duck_blocks_to_text(duck_block_plain('bare'));
----
true	bare

# The builder exists, so a type a reader can emit is one a builder can produce.
query II
SELECT duck_block_plain('bare')[1].element_type,
       duck_block_plain([duck_block_text('a '), duck_block_bold('b')])[1].content IS NULL;
----
plain	true

# `list_type` is canonical; `ordered` is a legacy alias. Both emitted.
query IIII
SELECT (SELECT b.attributes['list_type'] FROM (SELECT unnest(duck_block_list(true,['a'])) AS b) WHERE b.element_type='list'),
       (SELECT b.attributes['ordered'] FROM (SELECT unnest(duck_block_list(true,['a'])) AS b) WHERE b.element_type='list'),
       (SELECT b.attributes['list_type'] FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}]]}]}')) AS b) WHERE b.element_type='list'),
       (SELECT b.attributes['ordered'] FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}]]}]}')) AS b) WHERE b.element_type='list');
----
ordered	true	bullet	false

# ============================================================================
# A CONTAINER MUST NOT SILENTLY DROP A CHILD IT DOES NOT RECOGNISE.
#
# The container child walk ended in a bare `j++` -- any block type the chain did
# not enumerate vanished inside every div, blockquote, figure and caption.
# lineblock, deflist and table were all being lost that way, and the next type
# added would have been too. Adding `plain` is what surfaced it: I fixed the
# instance, and webbed pointed out the class.
#
# Their HTML writer never had this defect because its containment is LEVEL-driven
# -- it pops on depth and renders whatever arrives -- so a new type is handled by
# construction rather than invisible by construction. This is the type-keyed
# equivalent: a terminal arm that does not need to know the type.
# ============================================================================

# deflist and table inside a container keep their own constructors.
query II
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"DefinitionList","c":[[[{"t":"Str","c":"t"}],[[{"t":"Plain","c":[{"t":"Str","c":"d"}]}]]]]}]]}]}'))::VARCHAR LIKE '%"t":"DefinitionList"%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"Table","c":[["",[],[]],[null,[]],[],[["",[],[]],[]],[],[["",[],[]],[]]]}]]}]}'))::VARCHAR LIKE '%"t":"Table"%';
----
true	true

# DISCRIMINATING: the defect produced a well-formed Div, so asserting that a Div
# comes out would have passed against it. The property is that the CHILD is in it.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"DefinitionList","c":[[[{"t":"Str","c":"t"}],[[{"t":"Plain","c":[{"t":"Str","c":"d"}]}]]]]}]]}]}'))::VARCHAR NOT LIKE '%"c":[["",[],[]],[]]%';
----
true

# A type with no branch at all must still come through VISIBLY rather than
# vanishing -- lineblock has no container branch and must not be silently eaten.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"LineBlock","c":[[{"t":"Str","c":"ln"}]]}]]}]}'))::VARCHAR LIKE '%ln%';
----
true

# The types that already had branches must be unaffected.
query III
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"CodeBlock","c":[["",[],[]],"code"]}]]}]}'))::VARCHAR LIKE '%"t":"CodeBlock"%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"HorizontalRule"}]]}]}'))::VARCHAR LIKE '%HorizontalRule%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"i"}]}]]}]]}]}'))::VARCHAR LIKE '%"t":"BulletList"%';
----
true	true	true

# ============================================================================
# A LIST ITEM MUST NOT DROP CHILDREN EITHER -- the same bare `j++`, one function
# over from the container walk. A Pandoc list item holds [Block], so a code
# block, blockquote or horizontal rule inside one is ordinary and all three
# vanished.
#
# Found by checking the adjacent function after fixing the container walk, which
# is the sibling pattern that has caught something every time today. Both walks
# now share ONE fallback -- the duplication was the root of the class.
#
# THE hr ASSERTION USED TO READ `LIKE '%"hr"%'`, which pinned the DEGRADATION
# rather than the property. An hr in a list item survived only as a Div classed
# "hr", because the list walk does not enumerate hr the way the container walk
# does -- so the same constructor exported differently depending on which
# container it sat in. The shared fallback now writes a real HorizontalRule, and
# this asserts that instead.
#
# Worth noticing as a test-writing failure of its own: an assertion written
# against the output you happen to get will pass forever, including after the
# output becomes correct. "Not dropped" and "exported exactly" are different
# claims and the weaker one was quietly standing in for the stronger.
# ============================================================================

query III
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"item"}]},{"t":"CodeBlock","c":[["",[],[]],"the code"]}]]}]}'))::VARCHAR LIKE '%the code%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"item"}]},{"t":"BlockQuote","c":[{"t":"Para","c":[{"t":"Str","c":"quoted"}]}]}]]}]}'))::VARCHAR LIKE '%quoted%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"item"}]},{"t":"HorizontalRule"}]]}]}'))::VARCHAR LIKE '%HorizontalRule%';
----
true	true	true

# DISCRIMINATING: the item's own text always survived, so asserting that 'item'
# is in the output would have passed against all three. The property is that the
# SECOND child reaches the output.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"item"}]},{"t":"CodeBlock","c":[["",[],[]],"the code"]}]]}]}'))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"item"}]},{"t":"Div","c":[["",["code"],[]],[{"t":"Plain","c":[{"t":"Str","c":"the code"}]}]]}]]}]';
----
true

# The child stays INSIDE its item -- splitting into a second item would also make
# the text survive while corrupting the list. ONE list_item, and the code sits at
# the item's child depth.
query II
SELECT count(*) FILTER (WHERE b.element_type = 'list_item'),
       max(b.level) FILTER (WHERE b.element_type = 'code')
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"item"}]},{"t":"CodeBlock","c":[["",[],[]],"x"]}]]}]}')) AS b);
----
1	3

# Nested lists inside an item must still work -- they have their own branch and
# must not be swallowed by the new fallback.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]}'))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]';
----
true

# ============================================================================
# `section` WAS WRITE-ONLY from the Pandoc path.
#
# Pandoc has no Section constructor, so the exporter writes a `section` as a Div
# whose class is the role -- and the reader never read it back. A round trip
# turned section into div: the type survived as a different, less specific one,
# which is the silent downgrade `generic` exists to prevent and this had instead
# of it.
#
# Found by answering panduck's question about which HTML elements map to which
# role, and checking my own reader rather than only the spec.
# ============================================================================

query IIII
SELECT (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",["article"],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1),
       (SELECT b.attributes['role'] FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",["article"],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1),
       (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",["aside"],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1),
       (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",["main"],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1);
----
section	article	section	section

# DISCRIMINATING: a Div whose class is NOT a sectioning role must stay a div.
# Promoting every classed Div to `section` would also make the assertions above
# pass, while asserting something false about every styled wrapper in a document.
query II
SELECT (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",["note"],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1),
       (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1);
----
div	div

# The round trip is now SYMMETRIC -- a section comes back a section with its role.
query II
SELECT (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'section','content':NULL,'level':1,'encoding':'text','attributes':MAP{'role':'article'},'element_order':0}::duck_block,{'kind':'block','element_type':'paragraph','content':'x','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])::VARCHAR)) AS b) WHERE b.kind='block' LIMIT 1),
       (SELECT b.attributes['role'] FROM (SELECT unnest(pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'section','content':NULL,'level':1,'encoding':'text','attributes':MAP{'role':'article'},'element_order':0}::duck_block,{'kind':'block','element_type':'paragraph','content':'x','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])::VARCHAR)) AS b) WHERE b.kind='block' LIMIT 1);
----
section	article

# All seven roles the spec enumerates are recognised -- the set IS HTML5's
# sectioning elements, which is why an HTML reader mapping <article> onto
# role='article' is reading the spec rather than guessing from names matching.
query I
SELECT count(*) FROM (
  SELECT (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",["' || r || '"],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1) AS et
  FROM (SELECT unnest(['section','article','aside','nav','header','footer','main']) AS r)
) WHERE et = 'section';
----
7

# ============================================================================
# TIGHT/LOOSE IS A PROPERTY OF THE RUN, NOT OF THE ITEM HAVING BLOCK CHILDREN.
#
# panduck asked which an item's own bare text should be when a nested list sits
# beside it -- `plain` because it is a bare run, or `paragraph` because the item
# has block children and is therefore "loose". Real pandoc settles it against the
# second reading:
#
#   - outer          ->  BulletList > Plain > Str      TIGHT, and it has a
#       - inner                     > BulletList        nested list child
#
#   - outer          ->  BulletList > Para  > Str      LOOSE
#                                    > BulletList
#     - inner
#
# So an item can hold block children and still be tight. The rule stands as
# written: `plain` is about the run, not about its container.
#
# THIS CASE IS THE SPEC 6.0 RULE IN BOTH DIRECTIONS AT ONCE, which is why it is
# worth reading the expected rows carefully:
#
#   the OUTER item keeps its `plain`  -- the run has a nested `list` SIBLING, so
#                                       the item's content cannot hold it
#   the INNER item collapses to content -- the run is the item's only child
#
# One rule, two outcomes, decided by what is beside the run rather than by which
# element_type is above it. A reader that special-cased list_item would get one
# of these two wrong.
# ============================================================================

query IIII
SELECT b.element_type, b.level, coalesce(b.content,'(empty)'), b.kind
FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]}')) AS b);
----
list	1	(empty)	block
list_item	2	(empty)	block
plain	3	outer	block
list	3	(empty)	block
list_item	4	inner	block

# DISCRIMINATING: the LOOSE spelling of the same document must differ, and only
# in the item's own run. A rule keyed on "the item has block children" would make
# these two identical, which is exactly the reading pandoc disproves.
query II
SELECT (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]}')) AS b) WHERE b.level = 3 AND b.element_type IN ('plain','paragraph')),
       (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]}')) AS b) WHERE b.level = 3 AND b.element_type IN ('plain','paragraph'));
----
plain	paragraph

# Both spellings round-trip byte-identically -- the distinction survives export.
query II
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]}'))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]}'))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"outer"}]},{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"inner"}]}]]}]]}]';
----
true	true

# ============================================================================
# WRITE-ONLY TYPE SWEEP. `section` was exported as a Div classed with its role and
# never read back, so a round trip silently downgraded it to `div`. Sweeping EVERY
# block type through export-then-read found `page_break` doing the same thing:
# exported as a Div classed 'page' carrying page_number, read back as an anonymous
# div, so every round trip destroyed a pagination marker.
#
# The sweep also flagged `image`, and that one is NOT a defect -- recorded below,
# because a sweep that flags an inherent asymmetry needs the answer written down
# or the next person re-investigates it.
# ============================================================================

# page_break survives a round trip with its number.
query II
SELECT (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'page_break','content':'','level':1,'encoding':'text','attributes':MAP{'page_number':'3'},'element_order':0}::duck_block])::VARCHAR)) AS b) WHERE b.kind='block' LIMIT 1),
       (SELECT b.attributes['page_number'] FROM (SELECT unnest(pandoc_ast_to_blocks(duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'page_break','content':'','level':1,'encoding':'text','attributes':MAP{'page_number':'3'},'element_order':0}::duck_block])::VARCHAR)) AS b) WHERE b.kind='block' LIMIT 1);
----
page_break	3

# DISCRIMINATING: a Div classed 'page' is how page_break is SPELLED, so reading
# every Div back as a page_break would also make the above pass while destroying
# ordinary divs. A div with any other class must stay a div.
query II
SELECT (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",["sidebar"],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1),
       (SELECT b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Div","c":[["",[],[]],[{"t":"Para","c":[{"t":"Str","c":"x"}]}]]}]}')) AS b) WHERE b.kind='block' LIMIT 1);
----
div	div

# NOT A DEFECT, pinned so it is not "fixed" later: a Para whose only child is an
# Image stays a paragraph with an INLINE image. Pandoc has no block Image
# constructor, so Para[Image] is the only encoding it has and a block image is
# indistinguishable from a paragraph containing one. Promoting it would invent a
# distinction the source cannot carry -- unlike section and page_break, where the
# exporter writes a recoverable marker.
query II
SELECT (SELECT b.kind || ' ' || b.element_type FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"alt"}],["i.png",""]]}]}]}')) AS b) LIMIT 1),
       (SELECT b.attributes['src'] FROM (SELECT unnest(pandoc_ast_to_blocks('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"alt"}],["i.png",""]]}]}]}')) AS b) WHERE b.kind='inline');
----
block paragraph	i.png

# ============================================================================
# A STRAY BLOCK DIRECTLY UNDER A LIST -- reported by duckdb_markdown finding the
# identical defect in their writer's list walk, and checked here rather than
# assumed not to transfer.
#
# The list walk had a bare `j++` for a child at list_level+1 that was neither a
# list_item nor a nested list, so a list with a stray paragraph exported as
# `[{"t":"BulletList","c":[]}]` -- the text gone. The RENDERER showed it, so
# renderer and exporter disagreed about whether the document contained the words.
#
# Wrapped as its own item: losing list structure costs formatting, dropping it
# costs the text.
# ============================================================================

query III
SELECT duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{'list_type':'bullet'},'element_order':0}::duck_block,{'kind':'block','element_type':'paragraph','content':'STRAY','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])::VARCHAR LIKE '%STRAY%',
       duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{'list_type':'bullet'},'element_order':0}::duck_block,{'kind':'block','element_type':'code','content':'STRAY','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])::VARCHAR LIKE '%STRAY%',
       duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{'list_type':'bullet'},'element_order':0}::duck_block,{'kind':'block','element_type':'blockquote','content':'STRAY','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])::VARCHAR LIKE '%STRAY%';
----
true	true	true

# DISCRIMINATING: an ORDINARY list must be untouched. Wrapping every child as an
# item would also make the assertions above pass while corrupting every real list.
query I
SELECT duck_blocks_to_pandoc_blocks(duck_block_list(['a','b']))::VARCHAR = '[{"t":"BulletList","c":[[{"t":"Plain","c":[{"t":"Str","c":"a"}]}],[{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]}]';
----
true

# ...and the stray-wrapped item must not lead with an empty Plain.
query I
SELECT duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'list','content':NULL,'level':1,'encoding':'text','attributes':MAP{'list_type':'bullet'},'element_order':0}::duck_block,{'kind':'block','element_type':'paragraph','content':'STRAY','level':2,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block])::VARCHAR NOT LIKE '%"Plain","c":[]%';
----
true

# ============================================================================
# AGREEMENT: the renderer and the text extractor must agree about whether a
# document contains text.
#
# webbed's observation, and it is the guard that would have caught the
# figure(CONTENT) bug: two correct-looking implementations gave OPPOSITE answers
# about one document, and no single-path test can see that. Neither path is the
# reference -- the property is that they agree.
# ============================================================================

# `raw` is EXCLUDED, and this is not a fix -- it is the one type where the two
# SHOULD disagree. duck_blocks_to_text deliberately omits raw content so markup is
# not indexed as prose: searching a document for "script" must not match
# `<script>`, which is the same protection as the JSON-in-search defect fixed
# earlier today. The renderer shows it literally, which is a faithful rendering of
# "the document contained this raw block". Different questions, different answers.
#
# Recorded rather than fixed -- the guard flagged it on its first run and acting on
# the flag would have reintroduced markup into search results.
query I
SELECT bool_and(rendered = extracted) FROM (
  SELECT duck_blocks_render_ansi([{'kind':'block','element_type':ty,'content':'PROBE','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block], 60) LIKE '%PROBE%' AS rendered,
         duck_blocks_to_text([{'kind':'block','element_type':ty,'content':'PROBE','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block]) LIKE '%PROBE%' AS extracted
  FROM (SELECT unnest(['paragraph','plain','heading','code','blockquote','div','section','figure','caption','list','list_item','lineblock']) AS ty)
);
----
true

# DISCRIMINATING for the exclusion itself: `raw` must still be the ONLY type that
# disagrees. Excluding it without pinning that would hide a future disagreement in
# any of the others.
query II
SELECT duck_blocks_render_ansi([{'kind':'block','element_type':'raw','content':'<script>x</script>','level':1,'encoding':'html','attributes':MAP{'format':'html'},'element_order':0}::duck_block], 60) LIKE '%script%',
       duck_blocks_to_text([{'kind':'block','element_type':'raw','content':'<script>x</script>','level':1,'encoding':'html','attributes':MAP{'format':'html'},'element_order':0}::duck_block]) LIKE '%script%';
----
true	false

# ============================================================================
# AN IMAGE'S ALT TEXT IS ITS CONTENT.
#
# The exporter read only attributes['alt']. This reader writes the alt into BOTH
# `content` and that attribute, so a round trip through this repo looked clean
# while a producer following the vocabulary's content rule -- put a single text
# child in `content` -- lost the alt silently, an Image with an empty alt being
# a perfectly valid Image.
#
# Two copies of one fact, checked against each other by the one party that writes
# both. That pair cannot detect its own disagreement, which is why it took a sweep
# over HAND-BUILT blocks (test/check_roundtrip_sweep.py, content arm) rather than
# a round trip to find.
# ============================================================================

query I
SELECT duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'image','content':'alt words','level':1,'encoding':'text','attributes':MAP{'src':'i.png'},'element_order':0}::duck_block])::VARCHAR
     = '[{"t":"Para","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"alt words"}],["i.png",""]]}]}]';
----
true

# DISCRIMINATING: the fallback must not OVERRIDE an explicit alt. If it did, a
# producer that deliberately gave different alt text and caption would silently
# get the caption -- the assertion above passes either way, since both copies say
# the same thing whenever only one is set.
query I
SELECT duck_blocks_to_pandoc_blocks([{'kind':'block','element_type':'image','content':'from content','level':1,'encoding':'text','attributes':MAP{'src':'i.png','alt':'from attr'},'element_order':0}::duck_block])::VARCHAR
     LIKE '%from attr%';
----
true

# ============================================================================
# A DEFINITION IS [Block], PLURAL -- and every block keeps its own constructor.
#
# Two defects, found while generating a real 6.1 sample for duckdb_markdown rather
# than describing one:
#
#   1. The definition branch emitted only items[d].content, so every block after
#      the FIRST was silently lost. True since list_type='definition' shipped.
#      Both walks read one ListItem struct and only the bullet one read all of it.
#
#   2. extra_paragraphs was a vector<string>, which cannot carry Plain-vs-Para --
#      so a `plain` in block two came back as a Para while block one round-tripped
#      correctly. The distinction `plain` was minted for, preserved in the position
#      everyone was looking at and discarded immediately after it.
# ============================================================================

# Every block survives, with its constructor, in a definition AND in a bullet item.
query IIII
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"T"}],[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]]]}]'))::VARCHAR
     = '[{"t":"DefinitionList","c":[[[{"t":"Str","c":"T"}],[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]]]}]',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]}]'))::VARCHAR
     = '[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]}]',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"T"}],[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"CodeBlock","c":[["",[],[]],"XCODE"]}]]]]}]'))::VARCHAR
     LIKE '%XCODE%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"T"}],[[{"t":"Plain","c":[{"t":"Str","c":"a "},{"t":"Strong","c":[{"t":"Str","c":"b"}]}]}]]]]}]'))::VARCHAR
     LIKE '%Strong%';
----
true	true	true	true

# DISCRIMINATING on the constructor specifically: block two must differ between
# these two inputs. Asserting only that the TEXT survives passes for the version
# that emitted Para unconditionally, which is what shipped.
query II
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]}]'))::VARCHAR LIKE '%Plain%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"Para","c":[{"t":"Str","c":"b"}]}]]}]'))::VARCHAR LIKE '%Plain%';
----
true	false

# hr is a REAL HorizontalRule in every container, not a classed Div in some of
# them. The same constructor must not export differently depending on its parent.
query III
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Div","c":[["",[],[]],[{"t":"HorizontalRule"}]]}]'))::VARCHAR LIKE '%HorizontalRule%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"BulletList","c":[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"HorizontalRule"}]]}]'))::VARCHAR LIKE '%HorizontalRule%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"DefinitionList","c":[[[{"t":"Str","c":"T"}],[[{"t":"Para","c":[{"t":"Str","c":"a"}]},{"t":"HorizontalRule"}]]]]}]'))::VARCHAR LIKE '%HorizontalRule%';
----
true	true	true

# ============================================================================
# A LINE BLOCK MUST NOT FLATTEN ITS LINES TO TEXT.
#
# The reader joined every line with ExtractInlinesTextVal, so anything that was
# not Str or Space was DESTROYED: `| plain **bold**` came back as `| plain`, and
# a line whose only content was a link came back EMPTY. Every other block type has
# carried rich inlines as children since 1.x; lineblock kept the text-only path it
# was written with.
#
# THE ROUND TRIP COULD NOT SEE THIS. A line block of plain text -- the only case
# anyone writes a test for -- flattens losslessly, so read-then-write agreed with
# itself perfectly on every existing fixture.
#
# Surfaced by duckdb_markdown reporting a hard break degrading to a soft one on
# their re-read. That was the visible half; this was underneath it.
# ============================================================================

# Plain text is UNCHANGED: newline-joined content, no children. The fix must not
# migrate the common case -- a lineblock whose lines are text has a single text
# run, and the content rule puts that in `content`.
query II
SELECT pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"one"}],[{"t":"Str","c":"two"}]]}]')[1].content
     = 'one' || chr(10) || 'two',
       len(pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"one"}],[{"t":"Str","c":"two"}]]}]'));
----
true	1

# Rich content survives as inline children, delimited by `linebreak` rather than
# by newlines -- because `content` cannot hold a link.
query III
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"plain "},{"t":"Strong","c":[{"t":"Str","c":"bold"}]}],[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"anchor"}],["http://x",""]]}]]}]'))::VARCHAR
     = '[{"t":"LineBlock","c":[[{"t":"Str","c":"plain "},{"t":"Strong","c":[{"t":"Str","c":"bold"}]}],[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"anchor"}],["http://x",""]]}]]}]',
       (SELECT count(*) FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"a"}],[{"t":"Emph","c":[{"t":"Str","c":"b"}]}]]}]')) AS e) WHERE e.element_type = 'linebreak'),
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Emph","c":[{"t":"Str","c":"a"}]}],[],[{"t":"Str","c":"c"}]]}]'))::VARCHAR
     = '[{"t":"LineBlock","c":[[{"t":"Emph","c":[{"t":"Str","c":"a"}]}],[],[{"t":"Str","c":"c"}]]}]';
----
true	1	true

# DISCRIMINATING: the words alone are not the property. The old code kept "plain"
# and lost "bold", so asserting that the output CONTAINS the line's text passes
# against the defect. What must survive is the CONSTRUCTOR.
query II
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"plain "},{"t":"Strong","c":[{"t":"Str","c":"bold"}]}]]}]'))::VARCHAR LIKE '%Strong%',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"anchor"}],["http://x",""]]}]]}]'))::VARCHAR LIKE '%http://x%';
----
true	true

# ============================================================================
# A BREAK IS NOT TEXT.
#
# InlinesAreTextOnly listed `linebreak` and `softbreak` as text, which asserts
# that a run containing them survives being flattened into `content`. It does not:
#
#   Para[Str a, LineBreak, Str b]  ->  content "a\nb"  ->  Str "a\nb"
#   Para[Str a, SoftBreak, Str b]  ->  content "a b"   ->  Str "a b"
#
# A HARD break came back as a raw newline INSIDE a Str -- not a break at all --
# and a SOFT break was gone outright. Two distinct constructors collapsing onto
# one character and then onto none.
#
# Same root cause as the line block that destroyed its bold and links, one path
# over. Found by duckdb_markdown, who went looking here after that fix made their
# rich case work -- the fix is what made the neighbouring defect visible.
# ============================================================================

# Both break constructors survive, and they stay DISTINCT from each other.
query III
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"LineBreak"},{"t":"Str","c":"b"}]}]'))::VARCHAR
     = '[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"LineBreak"},{"t":"Str","c":"b"}]}]',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"SoftBreak"},{"t":"Str","c":"b"}]}]'))::VARCHAR
     = '[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"SoftBreak"},{"t":"Str","c":"b"}]}]',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"LineBreak"},{"t":"Str","c":"b"}]}]'))::VARCHAR
     LIKE '%SoftBreak%';
----
true	true	false

# ORDINARY PROSE MUST NOT MIGRATE. A paragraph with no break still carries its
# text in `content` and grows no children -- the content rule, untouched. A fix
# that moved every paragraph to inline children would pass the assertions above
# and rewrite every document in the portfolio.
query II
SELECT pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"just prose"}]}]')[1].content,
       len(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"just prose"}]}]'));
----
just prose	1

# ...and a PLAIN line block keeps its newline-joined content too, even though this
# code inserts `linebreak` separators between its lines. Richness is decided per
# LINE, before the separators go in; asking of the assembled run would call every
# multi-line block rich and migrate the case that has always lived in content.
query II
SELECT pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"one"}],[{"t":"Str","c":"two"}]]}]')[1].content
     = 'one' || chr(10) || 'two',
       len(pandoc_ast_to_blocks('[{"t":"LineBlock","c":[[{"t":"Str","c":"one"}],[{"t":"Str","c":"two"}]]}]'));
----
true	1

# ============================================================================
# METADATA MUST NOT LEAK INTO THE BODY -- the export direction.
#
#   meta title "TITLE" + body paragraph "BODY"  ->  Para["TITLE"]
#
# The document's body was replaced by its title. The top-level inline-collection
# loop broke on kind='block' only, so it walked PAST a kind='value' element and
# harvested the metadata's inline children as the paragraph's own.
#
# WHY NOTHING CAUGHT IT: the defect needs a document with BOTH metadata and blocks,
# and every fixture had one or the other. `duck_blocks_to_pandoc_ast` round-trips
# the META perfectly while corrupting the body, so the half anyone checks looked
# right -- and the value-kind tests all used metadata-only documents.
#
# Found while answering panduck's question about what a title looks like as
# duck_blocks, by building a realistic document rather than describing the shape.
# They are about to write five readers that emit exactly this combination.
# ============================================================================

# The minimal case, and the control beside it: the corruption requires MetaInlines
# (which has inline children); a MetaString title never had them to steal.
query III
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"TITLE"}]}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"BODY"}]}]}'))::VARCHAR
     = '[{"t":"Para","c":[{"t":"Str","c":"BODY"}]}]',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaString","c":"TITLE"}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"BODY"}]}]}'))::VARCHAR
     = '[{"t":"Para","c":[{"t":"Str","c":"BODY"}]}]',
       duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('{"meta":{},"blocks":[{"t":"Para","c":[{"t":"Str","c":"BODY"}]}]}'))::VARCHAR
     = '[{"t":"Para","c":[{"t":"Str","c":"BODY"}]}]';
----
true	true	true

# DISCRIMINATING: the metadata must ALSO still be there. A fix that dropped the
# `value` elements entirely would satisfy the assertion above perfectly, and would
# be the discard failure two other extensions already have.
query II
SELECT (SELECT count(*) FROM (SELECT unnest(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"TITLE"}]}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"BODY"}]}]}')) AS b) WHERE b.kind = 'value'),
       (SELECT count(*) FROM (SELECT unnest(pandoc_ast_to_blocks('{"meta":{"title":{"t":"MetaInlines","c":[{"t":"Str","c":"TITLE"}]}},"blocks":[{"t":"Para","c":[{"t":"Str","c":"BODY"}]}]}')) AS b) WHERE b.kind = 'inline' AND b.content = 'TITLE');
----
1	1

# ============================================================================
# THE FLATTENER RECURSES. It did not, and the visible symptom was a heading
# losing its formatting -- while the SAME helper projects table cells into the
# native {headers, rows} schema, so a cell whose only content was **BoldCell**
# came back as "". Not mangled, GONE, inside the schema whose whole purpose is
# that cell text be searchable.
#
# Found by panduck running a heading probe against code they had inherited from
# here. A shared helper is where a defect in one construct is a defect in
# another, and the construct nobody looks at is the one that keeps it.
#
# Every fixture passed before this, because a PLAIN cell works -- which is why
# the plain case below is a control rather than decoration.
# ============================================================================

query I
SELECT (SELECT b.content FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Table","c":[["",[],[]],[null,[]],[[{"t":"AlignDefault"},{"t":"ColWidthDefault"}]],[["",[],[]],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"H"}]}]]]]]],[[["",[],[]],0,[],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Strong","c":[{"t":"Str","c":"BoldCell"}]}]}]]]]]]],[["",[],[]],[]]]}]')) AS b));
----
{"headers":["H"],"rows":[["BoldCell"]]}

# CONTROL: the unformatted cell, which worked before and must still work.
query I
SELECT (SELECT b.content FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Table","c":[["",[],[]],[null,[]],[[{"t":"AlignDefault"},{"t":"ColWidthDefault"}]],[["",[],[]],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"H"}]}]]]]]],[[["",[],[]],0,[],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"PlainCell"}]}]]]]]]],[["",[],[]],[]]]}]')) AS b));
----
{"headers":["H"],"rows":[["PlainCell"]]}

# A Link's inlines sit in an inner array beside attr and target, and Code carries
# its text as a BARE STRING in a positional tuple -- unreachable by descending,
# because a bare string is indistinguishable from a URL. Both recovered.
query I
SELECT (SELECT b.content FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Table","c":[["",[],[]],[null,[]],[[{"t":"AlignDefault"},{"t":"ColWidthDefault"}]],[["",[],[]],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"H"}]}]]]]]],[[["",[],[]],0,[],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"text"}],["http://x.example/p",""]]},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"co**de"]}]}]]]]]]],[["",[],[]],[]]]}]')) AS b));
----
{"headers":["H"],"rows":[["text and co**de"]]}

# DISCRIMINATING NEGATIVE: recovering the link text must not drag the URL in with
# it. An assertion that only checked the text is present passes for a flattener
# that appends everything it walks past.
query II
SELECT contains(b.content, 'x.example'), contains(b.content, 'http')
FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Table","c":[["",[],[]],[null,[]],[[{"t":"AlignDefault"},{"t":"ColWidthDefault"}]],[["",[],[]],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"H"}]}]]]]]],[[["",[],[]],0,[],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"text"}],["http://x.example/p",""]]},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"co**de"]}]}]]]]]]],[["",[],[]],[]]]}]')) AS b);
----
false	false

# An image cell keeps its alt and not its src, for the same reason.
query II
SELECT b.content, contains(b.content, 'pic.png')
FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Table","c":[["",[],[]],[null,[]],[[{"t":"AlignDefault"},{"t":"ColWidthDefault"}]],[["",[],[]],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"H"}]}]]]]]],[[["",[],[]],0,[],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"alt"},{"t":"Space"},{"t":"Str","c":"text"}],["pic.png",""]]}]}]]]]]]],[["",[],[]],[]]]}]')) AS b);
----
{"headers":["H"],"rows":[["alt text"]]}	false


# ============================================================================
# INLINE IMAGE ALT, and the LINK/IMAGE TITLE.
#
# The inline Image export wrote an EMPTY alt array unconditionally, so every
# image inside a paragraph lost its alt text -- while the BLOCK image arm read
# it correctly. That asymmetry is why the roundtrip sweep passed: it probes
# `image` in block position, and a real document has images inside paragraphs.
#
# Pandoc's target is [url, TITLE]. The title was read by nobody and written by
# nobody, so `<a title>` and `<img title>` survived neither direction -- an
# absence indistinguishable from a document that never had one.
#
# Found by measuring an HTML round trip end to end, which is the only shape that
# exercises inline position, both directions, and the attributes together.
# ============================================================================

# All three producer shapes: children, content only, attribute only.
query I
SELECT duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'paragraph','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'inline','element_type':'image','content':'ALT','level':2,'encoding':'text','attributes':MAP{'src':'p.png'},'element_order':1}::duck_block])::VARCHAR;
----
[{"t":"Para","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"ALT"}],["p.png",""]]}]}]

query I
SELECT duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'paragraph','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'inline','element_type':'image','content':NULL,'level':2,'encoding':'text','attributes':MAP{'src':'p.png','alt':'ALT'},'element_order':1}::duck_block])::VARCHAR;
----
[{"t":"Para","c":[{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"ALT"}],["p.png",""]]}]}]

# The title survives a full round trip, both on Link and on Image.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"L"}],["u","T"]]},{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"A"}],["s.png","IT"]]}]}]'))::VARCHAR;
----
[{"t":"Para","c":[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"L"}],["u","T"]]},{"t":"Image","c":[["",[],[]],[{"t":"Str","c":"A"}],["s.png","IT"]]}]}]

# DISCRIMINATING: a document with NO title must not gain one. An assertion that
# only checks a title survives passes for an exporter that emits a constant.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"L"}],["u",""]]}]}]'))::VARCHAR;
----
[{"t":"Para","c":[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"L"}],["u",""]]}]}]

# ============================================================================
# A HEADING KEEPS BOTH the flattened title and its rich children -- alone among
# element types. `content` holds the title because that is what a title is FOR:
# slugs, outlines, section lookup and duck_blocks_diff all read that one field.
#
# The structure marks itself, so nothing has to declare the content derived: a
# single text child lives in `content` and produces NO children, so children
# ALONGSIDE non-empty content can only mean a flattening.
#
# Restricted to heading. Two copies of one fact is what hid the image-alt loss
# here for months; it is tolerable here only because neither reader gets a WRONG
# answer -- content-only loses the formatting, children-only loses nothing.
# ============================================================================

query III
SELECT b.element_type, b.level, b.content
FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Header","c":[1,["",[],[]],[{"t":"Strong","c":[{"t":"Str","c":"Bold"}]},{"t":"Space"},{"t":"Str","c":"title"}]]}]')) AS b);
----
heading	1	Bold title
bold	2	(empty)
text	3	Bold
space	2	 
text	2	title

# DISCRIMINATING: a PARAGRAPH with rich inlines must still have empty content.
# Without this, "headings keep both" is satisfied by dropping the content rule
# for every element, which is the change that would make every container carry a
# duplicate of its own text.
query II
SELECT b.element_type, b.content
FROM (SELECT unnest(pandoc_ast_to_blocks('[{"t":"Para","c":[{"t":"Str","c":"a"},{"t":"Space"},{"t":"Emph","c":[{"t":"Str","c":"b"}]}]}]')) AS b)
WHERE b.element_type = 'paragraph';
----
paragraph	(empty)

# The children stay authoritative: the exporter reads them and ignores the
# derived content, so the round trip is unaffected by carrying both.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Header","c":[2,["",[],[]],[{"t":"Strong","c":[{"t":"Str","c":"Bold"}]},{"t":"Space"},{"t":"Str","c":"title"}]]}]'))::VARCHAR;
----
[{"t":"Header","c":[2,["",[],[]],[{"t":"Strong","c":[{"t":"Str","c":"Bold"}]},{"t":"Space"},{"t":"Str","c":"title"}]]}]

# ============================================================================
# A NATIVE TABLE MUST EXPORT AS A REAL PANDOC TABLE.
#
# `content` for a table from any non-pandoc reader is the {headers, rows}
# projection -- an OBJECT. Pandoc's Table constructor takes a LIST, so splicing
# the projection into `c` produced a document real pandoc REFUSES:
#
#   JSON parse error: When parsing the constructor Table ... expected Array
#   but got Object
#
# Not the table degrading -- the whole export failing. duckeye's `-o md` and
# `-o pandoc` failed on ANY document containing a table, from any reader except
# a pandoc-sourced one.
#
# It survived every fixture here because a pandoc-sourced table carries the
# preserved pandoc_ast tuple and takes the other arm. The discrimination the
# native arm was missing is now keyed on SHAPE -- a tuple is an array, the
# projection is an object -- so both arms and both COPIES of the arm agree.
# ============================================================================

query I
SELECT json_type(json_extract(duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'table','content':'{"headers":["a","b"],"rows":[["1","2"]]}','level':1,'encoding':'json','attributes':MAP{},'element_order':0}::duck_block])::JSON, '$[0].c'));
----
ARRAY

# The cells survive, not just the shape.
query I
SELECT duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'table','content':'{"headers":["a"],"rows":[["1"]]}','level':1,'encoding':'json','attributes':MAP{},'element_order':0}::duck_block])::VARCHAR LIKE '%"Str","c":"a"%'
   AND duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'table','content':'{"headers":["a"],"rows":[["1"]]}','level':1,'encoding':'json','attributes':MAP{},'element_order':0}::duck_block])::VARCHAR LIKE '%"Str","c":"1"%';
----
true

# THE SECOND COPY: a table nested in a container went through its own arm, whose
# comment claimed every table stores a Pandoc tuple. Native tables do not.
query I
SELECT json_type(json_extract(duck_blocks_to_pandoc_blocks([
  {'kind':'block','element_type':'div','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'table','content':'{"headers":["a"],"rows":[["1"]]}','level':2,'encoding':'json','attributes':MAP{},'element_order':1}::duck_block])::JSON, '$[0].c[1][0].c'));
----
ARRAY

# DISCRIMINATING: a PANDOC-SOURCED table still round-trips through its preserved
# tuple byte-for-byte. Rebuilding both from the projection would satisfy the
# assertions above while silently discarding alignment, widths and cell blocks.
query I
SELECT duck_blocks_to_pandoc_blocks(pandoc_ast_to_blocks('[{"t":"Table","c":[["",[],[]],[null,[]],[[{"t":"AlignRight"},{"t":"ColWidthDefault"}]],[["",[],[]],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"h"}]}]]]]]],[[["",[],[]],0,[],[]]],[["",[],[]],[]]]}]'))::VARCHAR LIKE '%AlignRight%';
----
true
