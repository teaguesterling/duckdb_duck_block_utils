# name: test/sql/builders_v2.test
# description: test duck_block_utils extension - v2 builder functions (LIST return, config-first)
# group: [duck_block_utils]

require duck_block_utils

# ============================================================================
# db_heading Tests (v2: level first, returns LIST)
# ============================================================================

# Test db_heading returns a list
query I
SELECT typeof(db_heading(1, 'My Title'));
----
STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER)[]

# Test db_heading creates correct element_type
query I
SELECT db_heading(1, 'My Title')[1].element_type;
----
heading

# Test db_heading sets content for simple text
query I
SELECT db_heading(1, 'My Title')[1].content;
----
My Title

# Test db_heading sets heading_level in attributes (not level field)
query I
SELECT db_heading(2, 'My Title')[1].level;
----
1

# Test db_heading stores heading level in attributes
query I
SELECT db_heading(2, 'My Title')[1].attributes['heading_level'];
----
2

# Test db_heading with inline children - content is NULL
query I
SELECT db_heading(1, [db_text('Hello'), db_bold('World')])[1].content IS NULL;
----
true

# Test db_heading with inline children - returns flattened list
query I
SELECT len(db_heading(1, [db_text('Hello'), db_bold('World')]));
----
3

# Test db_heading children are at level 2
query I
SELECT db_heading(1, [db_text('Hello')])[2].level;
----
2

# ============================================================================
# db_paragraph Tests (v2: returns LIST)
# ============================================================================

# Test db_paragraph returns a list
query I
SELECT len(db_paragraph('Hello world'));
----
1

# Test db_paragraph creates paragraph block
query I
SELECT db_paragraph('Hello world')[1].element_type;
----
paragraph

# Test db_paragraph content for simple text
query I
SELECT db_paragraph('Hello world')[1].content;
----
Hello world

# Test db_paragraph level is 1 (top-level)
query I
SELECT db_paragraph('Hello world')[1].level;
----
1

# Test db_paragraph with inline children
query I
SELECT len(db_paragraph([db_text('Click '), db_link('https://example.com', 'here')]));
----
3

# Test db_paragraph with children - content is NULL
query I
SELECT db_paragraph([db_bold('Important')])[1].content IS NULL;
----
true

# Test db_paragraph children have correct levels
query I
SELECT db_paragraph([db_text('A'), db_text('B')])[2].level;
----
2

# ============================================================================
# db_paragraph with VARCHAR[] Tests (Issue #4)
# ============================================================================

# Test db_paragraph with string array - returns paragraph
query I
SELECT db_paragraph(['Hello ', 'world'])[1].element_type;
----
paragraph

# Test db_paragraph with string array - parent content is NULL
query I
SELECT db_paragraph(['Hello ', 'world'])[1].content IS NULL;
----
true

# Test db_paragraph with string array - correct list length
query I
SELECT len(db_paragraph(['A', 'B', 'C']));
----
4

# Test db_paragraph with string array - children are text type
query I
SELECT db_paragraph(['Hello'])[2].element_type;
----
text

# Test db_paragraph with string array - children are inline kind
query I
SELECT db_paragraph(['Hello'])[2].kind;
----
inline

# Test db_paragraph with string array - children have level 2
query I
SELECT db_paragraph(['Hello'])[2].level;
----
2

# Test db_paragraph with string array - children have correct content
query I
SELECT db_paragraph(['Hello', 'world'])[2].content;
----
Hello

# Test db_paragraph with string array - element_order set correctly
query III
SELECT db_paragraph(['A', 'B', 'C'])[2].element_order,
       db_paragraph(['A', 'B', 'C'])[3].element_order,
       db_paragraph(['A', 'B', 'C'])[4].element_order;
----
0	1	2

# Test db_paragraph with single string in array
query I
SELECT len(db_paragraph(['Only one']));
----
2

# Test db_paragraph with empty string array returns just parent
query I
SELECT len(db_paragraph([]::VARCHAR[]));
----
1

# ============================================================================
# db_code Tests (v2: language first when specified)
# ============================================================================

# Test db_code with language (language first)
query I
SELECT db_code('python', 'print(1)')[1].element_type;
----
code

query I
SELECT db_code('python', 'print(1)')[1].content;
----
print(1)

query I
SELECT db_code('python', 'print(1)')[1].attributes['language'];
----
python

# Test db_code without language (single arg)
query I
SELECT db_code('print(1)')[1].element_type;
----
code

query I
SELECT db_code('print(1)')[1].content;
----
print(1)

# ============================================================================
# db_blockquote Tests (v2: level first when specified)
# ============================================================================

# Test db_blockquote with level (level first)
query I
SELECT db_blockquote(2, 'Quote text')[1].element_type;
----
blockquote

query I
SELECT db_blockquote(2, 'Quote text')[1].level;
----
2

# Test db_blockquote single arg defaults level to 1
query I
SELECT db_blockquote('Quote text')[1].level;
----
1

# Test db_blockquote with children
query I
SELECT len(db_blockquote([db_text('Quoted '), db_bold('text')]));
----
3

# ============================================================================
# db_list_block Tests (v2: ordered first when specified)
# ============================================================================

# Test db_list_block unordered (default)
query I
SELECT db_list_block(['First', 'Second', 'Third'])[1].element_type;
----
list

query I
SELECT db_list_block(['First', 'Second', 'Third'])[1].encoding;
----
json

query I
SELECT db_list_block(['First', 'Second', 'Third'])[1].attributes['ordered'];
----
false

# Test db_list_block ordered (ordered first)
query I
SELECT db_list_block(true, ['First', 'Second'])[1].attributes['ordered'];
----
true

# Test db_list_block content is JSON array
query I
SELECT db_list_block(['A', 'B'])[1].content;
----
["A","B"]

# ============================================================================
# db_list_block with LIST(LIST(duck_block)) Tests (Issue #3)
# ============================================================================

# Test db_list_block with list items - returns list type
query I
SELECT db_list_block([db_list_item('First'), db_list_item('Second')])[1].element_type;
----
list

# Test db_list_block with list items - unordered by default
query I
SELECT db_list_block([db_list_item('First'), db_list_item('Second')])[1].attributes['ordered'];
----
false

# Test db_list_block with list items - ordered flag (ordered first)
query I
SELECT db_list_block(true, [db_list_item('First'), db_list_item('Second')])[1].attributes['ordered'];
----
true

# Test db_list_block with list items - parent content is NULL
query I
SELECT db_list_block([db_list_item('First')])[1].content IS NULL;
----
true

# Test db_list_block with list items - correct list length (1 parent + children)
query I
SELECT len(db_list_block([db_list_item('A'), db_list_item('B'), db_list_item('C')]));
----
4

# Test db_list_block with list items - children have level 2 (parent is level 1)
query I
SELECT db_list_block([db_list_item('First')])[2].level;
----
2

# Test db_list_block with list items - children element_order is set correctly
query III
SELECT db_list_block([db_list_item('A'), db_list_item('B'), db_list_item('C')])[2].element_order,
       db_list_block([db_list_item('A'), db_list_item('B'), db_list_item('C')])[3].element_order,
       db_list_block([db_list_item('A'), db_list_item('B'), db_list_item('C')])[4].element_order;
----
0	1	2

# Test db_list_block with rich list items containing inline content
query I
SELECT len(db_list_block([
    db_list_item([db_link('https://example.com', 'Link'), db_text(' description')])
]));
----
4

# Test db_list_block with rich items - nested children have correct levels
query I
SELECT db_list_block([db_list_item([db_bold('Bold text')])])[3].level;
----
3

# Test db_list_block with rich items - nested element_type preserved
query I
SELECT db_list_block([db_list_item([db_bold('Bold')])])[3].element_type;
----
bold

# Test db_list_block ordered with rich items
query I
SELECT len(db_list_block(true, [
    db_list_item(true, [db_text('First item')]),
    db_list_item(true, [db_text('Second item')])
]));
----
5

# Test db_list_block with list items - parent level is 1
query I
SELECT db_list_block([db_list_item('Test')])[1].level;
----
1

# Test db_list_block with list items - parent kind is block
query I
SELECT db_list_block([db_list_item('Test')])[1].kind;
----
block

# Test db_list_block with explicit ordered=false
query I
SELECT db_list_block(false, [db_list_item('A'), db_list_item('B')])[1].attributes['ordered'];
----
false

# Test db_list_block with single item
query I
SELECT len(db_list_block([db_list_item('Only one')]));
----
2

# Test db_list_block with empty list returns just the parent
query I
SELECT len(db_list_block(list_value()::duck_block[][]));
----
1

# Test db_list_block children preserve list_item element_type
query I
SELECT db_list_block([db_list_item('Item')])[2].element_type;
----
list_item

# ============================================================================
# db_list_item Tests (NEW in v2)
# ============================================================================

# Test db_list_item creates list_item block
query I
SELECT db_list_item('Item text')[1].element_type;
----
list_item

# Test db_list_item with text content
query I
SELECT db_list_item('Item text')[1].content;
----
Item text

# Test db_list_item unordered by default
query I
SELECT db_list_item('Item text')[1].attributes['ordered'];
----
false

# Test db_list_item ordered (ordered first)
query I
SELECT db_list_item(true, 'Item text')[1].attributes['ordered'];
----
true

# Test db_list_item with inline children
query I
SELECT len(db_list_item([db_link('https://github.com', 'GitHub'), db_text(' '), db_inline_image('badge.svg', 'CI')]));
----
4

# Test db_list_item children have correct levels
query I
SELECT db_list_item([db_text('content')])[2].level;
----
2

# ============================================================================
# db_hr Tests (v2: returns LIST)
# ============================================================================

# Test db_hr creates hr block in a list
query I
SELECT len(db_hr());
----
1

query I
SELECT db_hr()[1].element_type;
----
hr

query I
SELECT db_hr()[1].content;
----
(empty)

