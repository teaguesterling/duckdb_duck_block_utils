# Test duck_block_paragraph with string array - element_order set correctly
query III
SELECT duck_block_paragraph(['A', 'B', 'C'])[2].element_order,
       duck_block_paragraph(['A', 'B', 'C'])[3].element_order,
       duck_block_paragraph(['A', 'B', 'C'])[4].element_order;
----
0	1	2

