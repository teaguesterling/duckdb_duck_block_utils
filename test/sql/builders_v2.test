yaml

# ============================================================================
# db_image Tests (v2: returns LIST)
# ============================================================================

query I
SELECT db_image('/path/to/img.png', 'Alt text', 'Title')[1].element_type;
----
image

query I
SELECT db_image('/path/to/img.png', 'Alt text', 'Title')[1].attributes['src'];
----
/path/to/img.png

query I
SELECT db_image('/path/to/img.png', 'Alt text')[1].attributes['alt'];
----
Alt text

query I
SELECT db_image('/path/to/img.png')[1].attributes['src'];
----
/path/to/img.png

# ============================================================================
# db_raw Tests (v2: format first when specified)
# ============================================================================

query I
SELECT db_raw('html', '<div>HTML</div>')[1].element_type;
----
raw

query I
SELECT db_raw('html', '<div>HTML</div>')[1].content;
----
<div>HTML</div>

query I
SELECT db_raw('html', '<div>HTML</div>')[1].encoding;
----
html

# Test db_raw single arg defaults to html
query I
SELECT db_raw('<br>')[1].encoding;
----
html

# ============================================================================
# VARCHAR to duck_block Cast Tests (Issue #5)
# ============================================================================

# Test explicit cast creates text inline element
query I
SELECT ('hello'::duck_block).element_type;
----
text

# Test explicit cast creates inline kind
query I
SELECT ('hello'::duck_block).kind;
----
inline

# Test explicit cast preserves content
query I
SELECT ('hello world'::duck_block).content;
----
hello world

# Test explicit cast sets level to 1
query I
SELECT ('test'::duck_block).level;
----
1

# Test explicit cast sets encoding to text
query I
SELECT ('test'::duck_block).encoding;
----
text

# Test explicit cast sets element_order to 0
query I
SELECT ('test'::duck_block).element_order;
----
0

# Test cast with empty string
query I
SELECT (''::duck_block).content;
----
(empty)

# Test cast result can be used in list
query I
SELECT len([('a'::duck_block), ('b'::duck_block)]);
----
2

# ============================================================================
# db_div Tests (Issue #6) - Generic block container
# ============================================================================

# Test db_div creates div element_type
query I
SELECT db_div(db_paragraph('content'))[1].element_type;
----
div

# Test db_div creates block kind
query I
SELECT db_div(db_paragraph('content'))[1].kind;
----
block

# Test db_div parent content is NULL
query I
SELECT db_div(db_paragraph('content'))[1].content IS NULL;
----
true

# Test db_div with single child - correct length
query I
SELECT len(db_div(db_paragraph('content')));
----
2

# Test db_div children have level 2
query I
SELECT db_div(db_paragraph('content'))[2].level;
----
2

# Test db_div with id attribute
query I
SELECT db_div('my-id', db_paragraph('content'))[1].attributes['id'];
----
my-id

# Test db_div with id and class attributes
query II
SELECT db_div('my-id', 'my-class', db_paragraph('content'))[1].attributes['id'],
       db_div('my-id', 'my-class', db_paragraph('content'))[1].attributes['class'];
----
my-id	my-class

# Test db_div with nested list (composition)
query I
SELECT len(db_div([db_heading(1, 'Title'), db_paragraph('Text')]));
----
3

# Test db_div with id and nested list
query I
SELECT db_div('section-1', [db_heading(1, 'Title'), db_paragraph('Text')])[1].attributes['id'];
----
section-1

# Test db_div with id, class, and nested list
query I
SELECT len(db_div('my-id', 'container', [db_heading(1, 'A'), db_paragraph('B')]));
----
3

# Test db_div element_order on children
query II
SELECT db_div([db_paragraph('A'), db_paragraph('B')])[2].element_order,
       db_div([db_paragraph('A'), db_paragraph('B')])[3].element_order;
----
0	1

# Test db_div with NULL id
query I
SELECT db_div(NULL, db_paragraph('content'))[1].attributes['id'] IS NULL;
----
true

# Test db_div parent level is 1
query I
SELECT db_div(db_paragraph('test'))[1].level;
----
1

# ============================================================================
# Integration: Using v2 builders with manipulation functions
# ============================================================================

# Test filtering builder-created blocks (need to flatten first)
query I
SELECT len(db_blocks_filter(
    flatten([db_heading(1, 'Title'), db_paragraph('Text'), db_code('py', 'x=1')]),
    ['heading', 'code']
));
----
2

# Test merging builder-created blocks
query I
SELECT len(db_blocks_merge(
    db_heading(1, 'Title'),
    db_paragraph('Text')
));
----
2

# ============================================================================
# Nested Content Tests (v2 core feature)
# ============================================================================

# Test deeply nested content
query I
SELECT len(db_paragraph([
    db_text('Click '),
    db_bold([db_italic('here')]),
    db_text('!')
]));
----
5

# Test content is NULL when children exist (at every level)
query I
SELECT db_bold([db_text('text')])[1].content IS NULL;
----
true

# Test nested children get incremented levels
query I
SELECT db_paragraph([db_bold([db_text('nested')])])[2].level;
----
2

# Test element_order is preserved within children
query III
SELECT db_paragraph([db_text('A'), db_text('B'), db_text('C')])[2].element_order,
       db_paragraph([db_text('A'), db_text('B'), db_text('C')])[3].element_order,
       db_paragraph([db_text('A'), db_text('B'), db_text('C')])[4].element_order;
----
0	1	2

# ============================================================================
# db_assemble Tests (v2: takes LIST(LIST(duck_block)))
# ============================================================================

# Test db_assemble flattens list of lists
query I
SELECT len(db_assemble([
    db_heading(1, 'Title'),
    db_paragraph('Text'),
    db_hr()
]));
----
3

# Test db_assemble assigns sequential element_order
query III
SELECT db_assemble([db_heading(1, 'A'), db_paragraph('B'), db_hr()])[1].element_order,
       db_assemble([db_heading(1, 'A'), db_paragraph('B'), db_hr()])[2].element_order,
       db_assemble([db_heading(1, 'A'), db_paragraph('B'), db_hr()])[3].element_order;
----
0	1	2

# Test db_assemble with nested inline content
query I
SELECT len(db_assemble([
    db_heading(1, 'Title'),
    db_paragraph([db_text('Hello '), db_bold('world')])
]));
----
4

# Test db_assemble preserves child levels
query I
SELECT db_assemble([
    db_heading(1, 'Title'),
    db_paragraph([db_bold('Important')])
])[3].level;
----
2

# ============================================================================
# Complete Document Pattern
# ============================================================================

# Test building a complete document
query I
SELECT len(db_assemble([
    db_metadata('title: Test Doc'),
    db_heading(1, 'Introduction'),
    db_paragraph('Welcome to the guide.'),
    db_heading(2, 'Getting Started'),
    db_paragraph([
        db_text('First, '),
        db_link('https://example.com', 'install the extension'),
        db_text('.')
    ]),
    db_code('sql', 'LOAD duck_block_utils;'),
    db_hr()
]));
----
10
