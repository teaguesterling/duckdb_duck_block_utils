# name: test/sql/builders_v2.test
# description: test duck_block_utils extension - v2 builder functions (LIST return, config-first)
# group: [sql]

require duck_block_utils

# ============================================================================
# duck_block_heading Tests (v2: level first, returns LIST)
# ============================================================================

# Test duck_block_heading returns a list
query I
SELECT typeof(duck_block_heading(1, 'My Title'));
----
STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER)[]

# Test duck_block_heading creates correct element_type
query I
SELECT duck_block_heading(1, 'My Title')[1].element_type;
----
heading

# Test duck_block_heading sets content for simple text
query I
SELECT duck_block_heading(1, 'My Title')[1].content;
----
My Title

# Test duck_block_heading sets heading_level in attributes (not level field).
# `level` is NULL on a top-level block: it is structural nesting depth, and this
# heading is not nested. The assertion used to expect 1, contradicting its own
# comment and the spec, and disagreeing with pandoc_ast_to_blocks().
query I
SELECT duck_block_heading(2, 'My Title')[1].level IS NULL;
----
true

# Test duck_block_heading stores heading level in attributes
query I
SELECT duck_block_heading(2, 'My Title')[1].attributes['heading_level'];
----
2

# Test duck_block_heading with inline children - content is NULL
query I
SELECT duck_block_heading(1, [duck_block_text('Hello'), duck_block_bold('World')])[1].content IS NULL;
----
true

# Test duck_block_heading with inline children - returns flattened list
query I
SELECT len(duck_block_heading(1, [duck_block_text('Hello'), duck_block_bold('World')]));
----
3

# Test duck_block_heading children are at level 2
query I
SELECT duck_block_heading(1, [duck_block_text('Hello')])[2].level;
----
2

