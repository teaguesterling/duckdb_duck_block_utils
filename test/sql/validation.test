# name: test/sql/validation.test
# description: test duck_block_utils extension - validation functions
# group: [duck_block_utils]

require duck_block_utils

# ============================================================================
# db_blocks_validate Tests
# ============================================================================

# Test valid blocks pass validation
query I
SELECT db_blocks_validate([
    db_heading('Title', 1),
    db_paragraph('Text')
]).valid;
----
true

# Test valid blocks have empty errors
query I
SELECT len(db_blocks_validate([
    db_heading('Title', 1),
    db_paragraph('Text')
]).errors);
----
0

# Test empty list is valid
query I
SELECT db_blocks_validate([]).valid;
----
true

# Test NULL input is valid
query I
SELECT db_blocks_validate(NULL).valid;
----
true

# ============================================================================
# db_blocks_lint Tests
# ============================================================================

# Test lint with valid document (no warnings)
query I
SELECT len(db_blocks_lint([
    db_heading('Title', 1),
    db_heading('Section', 2),
    db_paragraph('Text')
]));
----
0

# Test lint detects heading level skip
query I
SELECT len(db_blocks_lint([
    db_heading('Title', 1),
    db_heading('Subsection', 3)
])) > 0;
----
true

# Test lint warning message contains heading skip info
query I
SELECT db_blocks_lint([
    db_heading('Title', 1),
    db_heading('Skip', 3)
])[1].message LIKE '%skip%';
----
true

# Test lint warning severity
query I
SELECT db_blocks_lint([
    db_heading('Title', 1),
    db_heading('Skip', 3)
])[1].severity;
----
warning

# Test lint detects code without language
query I
SELECT len(db_blocks_lint([db_code('x=1')])) > 0;
----
true

# Test empty list returns no warnings
query I
SELECT len(db_blocks_lint([]));
----
0

# ============================================================================
# db_blocks_structure Tests
# ============================================================================

# Test structure block count
query I
SELECT db_blocks_structure([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_paragraph('More')
]).block_count;
----
3

# Test structure heading count
query I
SELECT db_blocks_structure([
    db_heading('H1', 1),
    db_paragraph('Text'),
    db_heading('H2', 2)
]).heading_count;
----
2

# Test structure paragraph count
query I
SELECT db_blocks_structure([
    db_paragraph('P1'),
    db_paragraph('P2'),
    db_paragraph('P3')
]).paragraph_count;
----
3

# Test structure code block count
query I
SELECT db_blocks_structure([
    db_code('x=1', 'py'),
    db_code('echo hi', 'bash')
]).code_block_count;
----
2

# Test structure max heading level
query I
SELECT db_blocks_structure([
    db_heading('H1', 1),
    db_heading('H3', 3),
    db_heading('H2', 2)
]).max_heading_level;
----
3

# Test structure min heading level
query I
SELECT db_blocks_structure([
    db_heading('H2', 2),
    db_heading('H4', 4),
    db_heading('H3', 3)
]).min_heading_level;
----
2

# Test structure with no headings
query I
SELECT db_blocks_structure([db_paragraph('Text')]).min_heading_level;
----
0

# Test structure total content length
query I
SELECT db_blocks_structure([
    db_paragraph('Hello'),
    db_paragraph('World')
]).total_content_length;
----
10

# Test structure with empty list
query I
SELECT db_blocks_structure([]).block_count;
----
0

# Test structure inline count
query I
SELECT db_blocks_structure([
    db_text('Hello'),
    db_bold('World'),
    db_paragraph('Block')
]).inline_count;
----
2

# Test structure link count
query I
SELECT db_blocks_structure([
    db_link('Click', 'https://example.com'),
    db_link('Here', 'https://test.com'),
    db_paragraph('Text')
]).link_count;
----
2

# Test structure image count
query I
SELECT db_blocks_structure([
    db_inline_image('/img.png', 'Alt'),
    db_image('/photo.jpg', 'Photo', 'Title')
]).image_count;
----
2

# ============================================================================
# Integration Tests
# ============================================================================

# Test validation on assembled document
query I
SELECT db_blocks_validate(db_assemble([
    db_heading('Title', 1),
    db_paragraph('Intro'),
    db_heading('Section', 2),
    db_code('example', 'python')
])).valid;
----
true

# Test structure of assembled document
query I
SELECT db_blocks_structure(db_assemble([
    db_heading('Title', 1),
    db_paragraph('Intro'),
    db_heading('Section', 2),
    db_code('example', 'python')
])).heading_count;
----
2
