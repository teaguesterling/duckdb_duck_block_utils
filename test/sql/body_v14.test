# name: test/sql/body_v14.test
# description: spec 1.4 -- body is a SUBTREE property; duck_blocks_body applies it; the value-tree level contract
# group: [sql]

require duck_block_utils

query I
SELECT duck_block_spec_version();
----
1.4

# ---------------------------------------------------------------------------
# The 1.3 gap (panduck #54, 2026-09-14): Pandoc-derived readers emit metadata as a
# kind='value' container whose text lives in kind='inline' children. Per-row
# duck_block_is_body says the container is not body and then says its child text IS.
# The rule is a subtree property: a row is body only if it is block or inline, not
# metadata, AND no ancestor by level is a value or metadata row. duck_blocks_body
# applies it to a list. The panduck-shaped fixture, in element_order:
#   0 heading L1 | 1 paragraph L1 | 2 text L2 | 3 value/inlines{key=author} L1 |
#   4 text L2 "Test Author" | 5 value/string{key=title} L1 (childless) |
#   6 metadata/frontmatter blob L1 | 7 paragraph L1 | 8 text L2
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE fx AS SELECT [
  {'kind':'block','element_type':'heading','content':'H','level':1,'encoding':'text','attributes':MAP{'heading_level':'1'}::MAP(VARCHAR,VARCHAR),'element_order':0}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'','level':1,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':1}::duck_block,
  {'kind':'inline','element_type':'text','content':'Body one.','level':2,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':2}::duck_block,
  {'kind':'value','element_type':'inlines','content':'','level':1,'encoding':'text','attributes':MAP{'key':'author'}::MAP(VARCHAR,VARCHAR),'element_order':3}::duck_block,
  {'kind':'inline','element_type':'text','content':'Test Author','level':2,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':4}::duck_block,
  {'kind':'value','element_type':'string','content':'Audit Document','level':1,'encoding':'text','attributes':MAP{'key':'title'}::MAP(VARCHAR,VARCHAR),'element_order':5}::duck_block,
  {'kind':'block','element_type':'metadata','content':'draft: true','level':1,'encoding':'yaml','attributes':MAP{'role':'tailmatter'}::MAP(VARCHAR,VARCHAR),'element_order':6}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'','level':1,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':7}::duck_block,
  {'kind':'inline','element_type':'text','content':'Body two.','level':2,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':8}::duck_block
] AS bl;

# the fixture is valid as written (value leaves deeper than their root)
query I
SELECT duck_blocks_validate(bl).valid FROM fx;
----
true

# per-row predicate: unchanged from 1.3, and it says TRUE for the leaf under the value root.
# That is the necessary-not-sufficient case, kept on purpose so this test shows it.
query II
SELECT b.element_order, duck_block_is_body(b.kind, b.element_type) FROM (SELECT unnest(bl) AS b FROM fx) ORDER BY 1;
----
0	true
1	true
2	true
3	false
4	true
5	false
6	false
7	true
8	true

# the subtree rule: the value root AND its leaf go, the childless value goes, the
# metadata blob goes; body rows keep their element_order (a projection never renumbers)
query II
SELECT b.element_order, b.content FROM (SELECT unnest(duck_blocks_body(bl)) AS b FROM fx) ORDER BY 1;
----
0	H
1	(empty)
2	Body one.
7	(empty)
8	Body two.

# to_text, which already walked the tree, agrees with the projected list
query I
SELECT duck_blocks_to_text(bl) = duck_blocks_to_text(duck_blocks_body(bl)) FROM fx;
----
true

# a metadata string never reaches match text either way
query I
SELECT contains(duck_blocks_to_match_text(duck_blocks_body(bl)), 'Test Author') FROM fx;
----
false

# nested value tree: a map at L1 with a list at L2 and leaves at L3 is dropped whole,
# and the block that follows at L1 survives
query I
SELECT list_transform(duck_blocks_body([
  {'kind':'value','element_type':'map','content':'','level':1,'encoding':'text','attributes':MAP{'key':'tags'}::MAP(VARCHAR,VARCHAR),'element_order':0}::duck_block,
  {'kind':'value','element_type':'list','content':'','level':2,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':1}::duck_block,
  {'kind':'inline','element_type':'text','content':'a','level':3,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':2}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'kept','level':1,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':3}::duck_block
]), lambda b: b.content);
----
[kept]

# NULL in, NULL out; empty in, empty out
query II
SELECT duck_blocks_body(NULL) IS NULL, duck_blocks_body([]::duck_block[]);
----
true	[]

# ---------------------------------------------------------------------------
# The level contract (L6): a value tree's descendants sit STRICTLY deeper than their
# root. A leaf emitted at the root's own level would end the subtree early and leak as
# body. Validation names it.
# ---------------------------------------------------------------------------
query I
SELECT list_filter(duck_blocks_validate([
  {'kind':'block','element_type':'paragraph','content':'','level':1,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':0}::duck_block,
  {'kind':'inline','element_type':'text','content':'Body.','level':2,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':1}::duck_block,
  {'kind':'value','element_type':'inlines','content':'','level':2,'encoding':'text','attributes':MAP{'key':'author'}::MAP(VARCHAR,VARCHAR),'element_order':2}::duck_block,
  {'kind':'inline','element_type':'text','content':'Leaked Author','level':2,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':3}::duck_block
]).errors, lambda e: e.field = 'list')[1].message;
----
inline at 3 follows value root at 2 at the same level; a value tree's leaves must be deeper than their root

# and the same shape with the leaf one level deeper is valid
query I
SELECT duck_blocks_validate([
  {'kind':'block','element_type':'paragraph','content':'','level':1,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':0}::duck_block,
  {'kind':'inline','element_type':'text','content':'Body.','level':2,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':1}::duck_block,
  {'kind':'value','element_type':'inlines','content':'','level':2,'encoding':'text','attributes':MAP{'key':'author'}::MAP(VARCHAR,VARCHAR),'element_order':2}::duck_block,
  {'kind':'inline','element_type':'text','content':'Author','level':3,'encoding':'text','attributes':MAP{}::MAP(VARCHAR,VARCHAR),'element_order':3}::duck_block
]).valid;
----
true
