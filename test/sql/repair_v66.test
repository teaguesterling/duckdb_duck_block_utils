# name: test/sql/repair_v66.test
# description: spec 6.6 -- implicit parents, list-level validation, duck_blocks_repair, fragments in the exporter
# group: [sql]

require duck_block_utils

# ---------------------------------------------------------------------------
# 1. the implicit-parent table, from the vocabulary header
# ---------------------------------------------------------------------------
query I
SELECT duck_block_implicit_parent('list_item', 'block');
----
list

query I
SELECT duck_block_implicit_parent('caption', 'block');
----
figure

query I
SELECT duck_block_implicit_parent('text', 'inline');
----
plain

query I
SELECT duck_block_implicit_parent('bold', 'inline');
----
plain

query I
SELECT duck_block_implicit_parent('paragraph', 'block') IS NULL;
----
true

query I
SELECT duck_block_implicit_parent('metadata', 'value') IS NULL;
----
true

# ---------------------------------------------------------------------------
# 2. validation over the list (field = 'list')
# ---------------------------------------------------------------------------
statement ok
CREATE MACRO blk(t, c, l, o) AS struct_pack(kind := 'block', element_type := t, content := c, level := l,
    encoding := 'text', attributes := MAP{}::MAP(VARCHAR, VARCHAR), element_order := o);

statement ok
CREATE MACRO inl(t, c, l, o) AS struct_pack(kind := 'inline', element_type := t, content := c, level := l,
    encoding := 'text', attributes := MAP{}::MAP(VARCHAR, VARCHAR), element_order := o);

# L1: starts at 1
query I
SELECT list_transform(duck_blocks_validate([blk('paragraph','a',1,1), blk('paragraph','b',1,2)]::duck_block[]).errors,
                      lambda e: e.field || ': ' || e.message);
----
['list: element_order starts at 1; must start at 0']

# L1: gap
query I
SELECT list_transform(duck_blocks_validate([blk('paragraph','a',1,0), blk('paragraph','b',1,2)]::duck_block[]).errors,
                      lambda e: e.field || ': ' || e.message);
----
['list: element_order gap after 0']

# L2: shallowest element at 2
query I
SELECT list_transform(duck_blocks_validate([blk('paragraph','a',2,0), inl('text','a',3,1)]::duck_block[]).errors,
                      lambda e: e.field || ': ' || e.message);
----
['list: shallowest element is at level 2; top level is 1']

# L4: orphan list_item
query I
SELECT list_transform(duck_blocks_validate([blk('list_item','a',1,0)]::duck_block[]).errors,
                      lambda e: e.field || ': ' || e.message);
----
['list: list_item at 0 has no list ancestor']

# L4: caption without figure/table
query I
SELECT list_transform(duck_blocks_validate([blk('caption','c',1,0)]::duck_block[]).errors,
                      lambda e: e.field || ': ' || e.message);
----
['list: caption at 0 has no figure ancestor']

# L5: inline with no block or value above it
query I
SELECT list_transform(duck_blocks_validate([inl('text','a',1,0), inl('bold','b',1,1)]::duck_block[]).errors,
                      lambda e: e.field || ': ' || e.message);
----
['list: inline at 0 has no block or value parent', 'list: inline at 1 has no block or value parent']

# a well-formed document reports nothing at the list level
query I
SELECT duck_blocks_validate([blk('list','',1,0), blk('list_item','a',2,1), inl('text','a',3,2), blk('figure','',1,3), blk('caption','c',2,4)]::duck_block[]).valid;
----
true

# ---------------------------------------------------------------------------
# 3. duck_blocks_repair: deterministic fixes; structure first, numbering last
# ---------------------------------------------------------------------------
# an orphan list_item run becomes one list; levels shift; orders renumber
query I
SELECT list_transform(duck_blocks_repair([blk('list_item','a',1,5), blk('list_item','b',1,9)]::duck_block[]),
                      lambda x: x.element_type || '/' || x.level || '/' || x.element_order || '/' || coalesce(x.attributes['list_type'], ''));
----
[list/1/0/bullet, list_item/2/1/, list_item/2/2/]

# a bare inline run becomes one plain; the caption run becomes one figure
query I
SELECT list_transform(duck_blocks_repair([inl('text','prose ',1,0), inl('link','x',1,1), blk('caption','c',1,2)]::duck_block[]),
                      lambda x: x.element_type || '/' || x.level);
----
[plain/1, text/2, link/2, figure/1, caption/2]

# an orphan at level 2 with a descendant at 3: the wrapper takes level 1
query I
SELECT list_transform(duck_blocks_repair([blk('list_item','',2,0), inl('text','a',3,1)]::duck_block[]),
                      lambda x: x.element_type || '/' || x.level);
----
[list/1, list_item/2, text/3]

# L2: shallowest at 3 rebases to 1
query I
SELECT list_transform(duck_blocks_repair([blk('paragraph','a',3,0), inl('text','a',4,1), blk('paragraph','b',3,2)]::duck_block[]),
                      lambda x: x.element_type || '/' || x.level);
----
[paragraph/1, text/2, paragraph/1]

# L3: a jump 1 -> 3 collapses to 1 -> 2, and the subtree follows
query I
SELECT list_transform(duck_blocks_repair([blk('blockquote','',1,0), blk('paragraph','q',3,1), inl('text','q',4,2)]::duck_block[]),
                      lambda x: x.element_type || '/' || x.level);
----
[blockquote/1, paragraph/2, text/3]

# repaired output validates clean, and repair is idempotent
query II
WITH f AS (SELECT [blk('list_item','a',1,5), inl('text','a',2,7), blk('caption','c',1,9)]::duck_block[] AS b)
SELECT duck_blocks_validate(duck_blocks_repair(b)).valid, duck_blocks_repair(duck_blocks_repair(b)) = duck_blocks_repair(b) FROM f;
----
true	true

# repair never changes content, attributes or element_type of an existing element, and never removes one
query I
WITH f AS (SELECT [blk('list_item','keep me',1,5), inl('bold','and me',2,7)]::duck_block[] AS b)
SELECT list_transform(list_filter(duck_blocks_repair(b), lambda x: x.element_type <> 'list'), lambda x: x.element_type || ':' || x.content) FROM f;
----
['list_item:keep me', 'bold:and me']

# a per-element error is not repaired and is still reported
query I
SELECT list_transform(duck_blocks_validate(duck_blocks_repair([struct_pack(kind := 'block', element_type := '', content := 'x', level := 1,
    encoding := 'text', attributes := MAP{}::MAP(VARCHAR, VARCHAR), element_order := 0)]::duck_block[])).errors, lambda e: e.field);
----
[element_type]

# a well-formed document is unchanged
query I
WITH f AS (SELECT duck_blocks_assemble([duck_block_heading(1, 'T'), duck_block_list([duck_block_list_item('a')])]) AS b)
SELECT duck_blocks_repair(b) = b FROM f;
----
true

# NULL in, NULL out
query I
SELECT duck_blocks_repair(NULL) IS NULL;
----
true

# ---------------------------------------------------------------------------
# 4. the exporter applies the implicit parents instead of dropping fragments (#29 ex. 3)
# ---------------------------------------------------------------------------
query I
SELECT (duck_blocks_to_pandoc_ast([inl('text','prose with a ',1,0), inl('link','link',1,1)]::duck_block[])).blocks::VARCHAR LIKE '[{"t":"Plain","c":[%';
----
true

query I
SELECT (duck_blocks_to_pandoc_ast([blk('list_item','alpha',1,0), blk('list_item','beta',1,1)]::duck_block[])).blocks::VARCHAR LIKE '[{"t":"BulletList","c":[[{"t":"Plain"%';
----
true

# a whole document is unchanged by the repair pass
query I
WITH d AS (SELECT duck_blocks_assemble([duck_block_heading(1,'T'), duck_block_paragraph('p'), duck_block_list([duck_block_list_item('a')])]) AS b)
SELECT (duck_blocks_to_pandoc_ast(b)).blocks::VARCHAR LIKE '[{"t":"Header"%' AND (duck_blocks_to_pandoc_ast(b)).blocks::VARCHAR LIKE '%"BulletList"%' FROM d;
----
true
