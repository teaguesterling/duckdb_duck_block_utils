# name: test/sql/extraction.test
# description: test duck_block_utils extension - extraction functions
# group: [duck_block_utils]

require duck_block_utils

# ============================================================================
# db_blocks_to_text Tests
# ============================================================================

# Test basic text extraction - verify it contains expected content
query I
SELECT length(db_blocks_to_text([
    db_heading('Title', 1),
    db_paragraph('Hello world'),
    db_paragraph('Second paragraph')
])) > 0;
----
true

# Test text includes all blocks
query I
SELECT db_blocks_to_text([
    db_heading('Title', 1),
    db_paragraph('Hello world'),
    db_paragraph('Second paragraph')
]) LIKE '%Title%Hello world%Second paragraph%';
----
true

# Test with custom separator
query I
SELECT db_blocks_to_text([
    db_paragraph('Line 1'),
    db_paragraph('Line 2')
], ' | ');
----
Line 1 | Line 2

# Test that hr blocks are skipped
query I
SELECT db_blocks_to_text([
    db_paragraph('Before'),
    db_hr(),
    db_paragraph('After')
]) LIKE '%Before%After%';
----
true

# Test that raw blocks are skipped
query I
SELECT db_blocks_to_text([
    db_paragraph('Text'),
    db_raw('<div>html</div>')
]) = 'Text';
----
true

# Test empty result for empty list
query I
SELECT db_blocks_to_text([]) = '';
----
true

# ============================================================================
# db_blocks_headings Tests
# ============================================================================

# Test extracting headings
query I
SELECT len(db_blocks_headings([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_heading('Section 1', 2),
    db_paragraph('More text'),
    db_heading('Section 2', 2)
]));
----
3

# Test heading structure - level
query I
SELECT db_blocks_headings([db_heading('Title', 1)])[1].level;
----
1

# Test heading structure - title
query I
SELECT db_blocks_headings([db_heading('My Title', 2)])[1].title;
----
My Title

# Test heading structure - block_order
query I
SELECT db_blocks_headings(db_assemble([
    db_heading('First', 1),
    db_paragraph('Text'),
    db_heading('Second', 2)
]))[2].element_order;
----
2

# Test non-headings are excluded
query I
SELECT len(db_blocks_headings([
    db_paragraph('Text'),
    db_code('code', 'py'),
    db_hr()
]));
----
0

# ============================================================================
# db_blocks_code_blocks Tests
# ============================================================================

# Test extracting code blocks
query I
SELECT len(db_blocks_code_blocks([
    db_paragraph('Intro'),
    db_code('print(1)', 'python'),
    db_paragraph('More text'),
    db_code('echo "hi"', 'bash')
]));
----
2

# Test code block structure - language
query I
SELECT db_blocks_code_blocks([db_code('x=1', 'python')])[1].language;
----
python

# Test code block structure - content
query I
SELECT db_blocks_code_blocks([db_code('print("hello")', 'py')])[1].content;
----
print("hello")

# Test code without language
query I
SELECT db_blocks_code_blocks([db_code('plain code')])[1].language;
----
(empty)

# Test non-code blocks are excluded
query I
SELECT len(db_blocks_code_blocks([
    db_heading('Title', 1),
    db_paragraph('Text')
]));
----
0

# ============================================================================
# db_blocks_stats Tests
# ============================================================================

# Test stats aggregation
query I
SELECT len(db_blocks_stats([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_paragraph('More text'),
    db_code('x=1', 'py')
]));
----
3

# Test stats counts correctly
query I
SELECT db_blocks_stats([
    db_paragraph('A'),
    db_paragraph('BB'),
    db_paragraph('CCC')
])[1].count;
----
3

# Test total content length
query I
SELECT db_blocks_stats([
    db_paragraph('A'),
    db_paragraph('BB'),
    db_paragraph('CCC')
])[1].total_content_length;
----
6

# Test empty list returns empty stats
query I
SELECT len(db_blocks_stats([]));
----
0

# ============================================================================
# Integration Tests
# ============================================================================

# Test extracting headings from a complex document
query I
SELECT len(db_blocks_headings(db_assemble([
    db_metadata('title: Test'),
    db_heading('Introduction', 1),
    db_paragraph('Welcome'),
    db_heading('Chapter 1', 2),
    db_paragraph('Content'),
    db_heading('Chapter 2', 2),
    db_code('example', 'py')
])));
----
3

# Test text extraction from assembled document
query I
SELECT length(db_blocks_to_text(db_assemble([
    db_heading('Title', 1),
    db_paragraph('Hello'),
    db_paragraph('World')
]))) > 0;
----
true

# ============================================================================
# db_blocks_toc Tests
# ============================================================================

# Test TOC generation from headings
query I
SELECT len(db_blocks_toc([
    db_heading('Introduction', 1),
    db_paragraph('Text'),
    db_heading('Chapter 1', 2),
    db_heading('Section 1.1', 3),
    db_heading('Chapter 2', 2)
]));
----
4

# Test TOC entry structure - level
query I
SELECT db_blocks_toc([db_heading('Title', 1)])[1].level;
----
1

# Test TOC entry structure - title
query I
SELECT db_blocks_toc([db_heading('My Section', 2)])[1].title;
----
My Section

# Test TOC entry structure - indent (relative to min level)
query I
SELECT db_blocks_toc([
    db_heading('Chapter', 2),
    db_heading('Section', 3)
])[1].indent;
----
0

query I
SELECT db_blocks_toc([
    db_heading('Chapter', 2),
    db_heading('Section', 3)
])[2].indent;
----
1

# Test empty list returns empty TOC
query I
SELECT len(db_blocks_toc([]));
----
0

# Test TOC with only paragraphs returns empty
query I
SELECT len(db_blocks_toc([db_paragraph('Text'), db_paragraph('More')]));
----
0

# ============================================================================
# db_blocks_links Tests
# ============================================================================

# Test extracting links from inline link elements
query I
SELECT len(db_blocks_links([
    db_link('Click here', 'https://example.com'),
    db_paragraph('Text'),
    db_link('Another link', 'https://test.com')
]));
----
2

# Test link structure - href
query I
SELECT db_blocks_links([db_link('Click', 'https://example.com')])[1].href;
----
https://example.com

# Test link structure - text
query I
SELECT db_blocks_links([db_link('Click me', 'https://example.com')])[1].text;
----
Click me

# Test extracting images as links
query I
SELECT len(db_blocks_links([
    db_inline_image('/path/to/img.png', 'Alt text')
]));
----
1

# Test image link href is src
query I
SELECT db_blocks_links([db_inline_image('/img.png', 'Alt')])[1].href;
----
/img.png

# Test empty list returns no links
query I
SELECT len(db_blocks_links([]));
----
0

# Test paragraphs without links return empty
query I
SELECT len(db_blocks_links([db_paragraph('Just text'), db_heading('Title', 1)]));
----
0
