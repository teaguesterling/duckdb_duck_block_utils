# name: test/sql/doc_macros.test
# description: test duck_block_utils unified document and data profiling macros
# group: [sql]

require duck_block_utils

statement ok
INSTALL markdown;

statement ok
LOAD markdown;

statement ok
INSTALL json;

statement ok
LOAD json;

# ============================================================================
# The query macros are registered at LOAD, NOT behind a pragma.
#
# A macro created by a pragma is doubly unreachable from a sibling extension: it
# is invisible to the statement that loads this extension, and a macro cannot
# invoke a pragma. panduck could build on the C++ scalar duck_blocks_toc but not
# on these, so its doc_section and doc_sections_like could not exist at all.
#
# NOTE these run WITHOUT `PRAGMA duck_block_doc_macros` -- that is the assertion.
# ============================================================================

query I
SELECT count(*) > 0 FROM duck_blocks_toc_rows(parse_markdown_to_duck_blocks('# A' || chr(10) || chr(10) || '## B'));
----
true

query I
SELECT duck_blocks_get_section(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'body a' || chr(10) || chr(10) || '# B' || chr(10) || chr(10) || 'body b'), 'A')
  LIKE '%body a%';
----
true

query I
SELECT count(*) > 0 FROM duck_blocks_sections_like(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'findme'), 'findme');
----
true

# named parameters survive load-time registration
query I
SELECT duck_blocks_get_section(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'body a'), 'A', output_format := 'pandoc') LIKE '%pandoc-api-version%';
----
true

statement ok
PRAGMA duck_block_doc_macros;

# ============================================================================
# doc_toc / doc_section / doc_search -- these take BLOCKS now, not paths.
# Path->blocks routing moved to panduck (read_panduck_doc / panduck_read_blocks);
# this extension is utilities over the vocabulary and no longer reads files.
# ============================================================================

query I
SELECT count(*) > 0 FROM duck_blocks_toc_rows(parse_markdown_to_duck_blocks('# A' || chr(10) || chr(10) || '## B'));
----
true

query T
SELECT title FROM duck_blocks_toc_rows(parse_markdown_to_duck_blocks('# Overview' || chr(10) || chr(10) || 'body')) WHERE title = 'Overview';
----
Overview

query I
SELECT duck_blocks_get_section(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'body a' || chr(10) || chr(10) || '# B' || chr(10) || chr(10) || 'body b'), 'A')
  LIKE '%body a%';
----
true

# the slice stops at the next same-level heading
query I
SELECT duck_blocks_get_section(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'body a' || chr(10) || chr(10) || '# B' || chr(10) || chr(10) || 'body b'), 'A')
  LIKE '%body b%';
----
false

query I
SELECT count(*) > 0 FROM duck_blocks_sections_like(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'findme'), 'findme');
----
true

# doc_search honours output_format now -- the old inlined CASE silently fell
# back to text for every format except text and ansi
query I
SELECT content LIKE '%pandoc-api-version%' FROM duck_blocks_sections_like(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'findme'), 'findme', output_format := 'pandoc') LIMIT 1;
----
true

# and an unsupported one raises rather than quietly returning text
statement error
SELECT content FROM duck_blocks_sections_like(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'findme'), 'findme', output_format := 'md');
----
unsupported output_format

# ============================================================================
# profile_table
# ============================================================================

query I
SELECT count(*) FROM profile_table('SELECT 100 AS num, ''val'' AS str');
----
2

# ============================================================================
# doc_render is GONE. After md/html left, it was four direct calls behind a
# string parameter -- an indirection that bought a name and nothing else.
# ============================================================================

statement error
SELECT doc_render(duck_block_paragraph('x'), 'text');
----
Catalog Error

# the direct calls it wrapped are the API
query I
SELECT duck_blocks_to_text(duck_block_paragraph([duck_block_text('hello '), duck_block_bold('world')]));
----
hello world

query I
SELECT duck_blocks_render_ansi(duck_block_paragraph('T')) LIKE '%T%';
----
true

# the section macros keep output_format, with the CASE inlined
query I
SELECT duck_blocks_get_section(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'body a'), 'A', output_format := 'pandoc')
  LIKE '%pandoc-api-version%';
----
true

statement error
SELECT duck_blocks_get_section(parse_markdown_to_duck_blocks('# A'), 'A', output_format := 'md');
----
unsupported output_format

# ============================================================================
# Reader dispatch has MOVED TO PANDUCK. These must no longer exist here: this
# extension is utilities over the duck_block vocabulary and does not read files.
# Replacements: read_panduck_doc / panduck_read_blocks / panduck_can_read /
# panduck_supported_paths / panduck_select_blocks.
# ============================================================================

statement error
SELECT doc_to_blocks('README.md');
----
Catalog Error

statement error
SELECT doc_read('README.md');
----
Catalog Error

statement error
SELECT doc_is_supported('a.md');
----
Catalog Error

statement error
SELECT doc_supported_extensions();
----
Catalog Error

statement error
SELECT doc_select('README.md', 'x');
----
Catalog Error

# ...and the doc_* query macros are renamed to db_*, freeing the doc_ prefix
statement error
SELECT count(*) FROM doc_toc(duck_block_paragraph('x'));
----
Catalog Error

# ...the utilities remain
query I
SELECT count(*) FROM profile_table('SELECT 1 AS a');
----
1

query I
SELECT duck_block_ensure_extension('json');
----
true

# ============================================================================
# REGRESSION: duck_block_section is a BUILDER (six C++ overloads, title+level+children).
# Naming the section-slicing macro duck_block_section shadowed all six, so running the
# pragma broke the builder. The query macro is duck_blocks_get_section.
# ============================================================================

query I
SELECT duck_block_section('Title', 2)[1].element_type;
----
heading

query I
SELECT duck_block_section('Title', 2)[1].attributes['heading_level'];
----
2

# ...and the two coexist: builder and query macro, different names, both live
query I
SELECT duck_blocks_get_section(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'body a'), 'A') LIKE '%body a%';
----
true

# ============================================================================
# SEARCH FLATTENS WITH A SPACE; RENDERING KEEPS PARAGRAPH SEPARATION.
#
# duck_blocks_sections_like matched on duck_blocks_to_text() with its DEFAULT
# separator, which is a blank line -- so a phrase spanning a block boundary did not
# match:
#
#     to_text(b, ' ') ILIKE '%here second%'  ->  true
#     to_text(b)      ILIKE '%here second%'  ->  false
#
# Found by the duckeye session, who are DELETING their own section/search SQL to
# call these macros. Their search passed ' ' and this did not, so a naive swap would
# have silently lost every cross-block hit -- wrong answers, no error.
#
# A search predicate wants a flat text stream; a rendering wants paragraph
# separation. Different jobs, and only the predicate is flattened.
# ============================================================================

statement ok
PRAGMA duck_block_doc_macros;

statement ok
CREATE TEMP TABLE sepdoc AS SELECT pandoc_ast_to_blocks('[{"t":"Header","c":[1,["",[],[]],[{"t":"Str","c":"H"}]]},{"t":"Para","c":[{"t":"Str","c":"here"}]},{"t":"Para","c":[{"t":"Str","c":"second"}]}]') AS b;

# A phrase across a block boundary matches, and one inside a block still does.
query II
SELECT (SELECT count(*) FROM duck_blocks_sections_like((SELECT b FROM sepdoc), 'here second', 'text')),
       (SELECT count(*) FROM duck_blocks_sections_like((SELECT b FROM sepdoc), 'second', 'text'));
----
1	1

# DISCRIMINATING: the OUTPUT must still use the default separator. Flattening the
# rendering too would make every section come back as one run-on line, which would
# satisfy the assertion above perfectly.
query I
SELECT content LIKE '%' || chr(10) || '%' FROM duck_blocks_sections_like((SELECT b FROM sepdoc), 'here', 'text');
----
true

# ============================================================================
# THE PAGE AXIS, which exists so that pages are queryable WITHOUT being headings.
#
# duckeye synthesised `## Page N` headings for exactly one reason: a heading was
# the only thing that showed up in an outline. That put physical pagination into
# the semantic structure, where duck_blocks_toc_rows then listed pages as sections.
# These macros give pages their own surface so the outline can ignore them.
# ============================================================================

statement ok
CREATE TEMP TABLE pagedoc AS SELECT [
  {'kind':'block','element_type':'page_break','content':NULL,'level':1,'encoding':'text','attributes':MAP{'page_number':'1'},'element_order':0}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'alpha','level':1,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'page_break','content':NULL,'level':1,'encoding':'text','attributes':MAP{'page_number':'2'},'element_order':2}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'beta','level':1,'encoding':'text','attributes':MAP{},'element_order':3}::duck_block,
  {'kind':'block','element_type':'heading','content':'H','level':1,'encoding':'text','attributes':MAP{'heading_level':'1'},'element_order':4}::duck_block,
  {'kind':'block','element_type':'page_break','content':NULL,'level':1,'encoding':'text','attributes':MAP{'page_number':'3'},'element_order':5}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'gamma','level':1,'encoding':'text','attributes':MAP{},'element_order':6}::duck_block
] AS b;

query III
SELECT page_number, start_order, block_count FROM duck_blocks_page_rows((SELECT b FROM pagedoc));
----
1	0	2
2	2	3
3	5	2

# A range, which is what `duckeye -P 1-2` needs.
# The newlines are collapsed because a blank line ENDS a sqllogictest result block,
# so a multi-line value cannot be written literally here. Collapsing to a visible
# separator keeps the blank-line separation assertable rather than dropping it --
# `alpha|||beta` distinguishes correct output from `alphabeta` concatenation, which
# a words-survive assertion would not.
query I
SELECT replace(duck_blocks_get_pages((SELECT b FROM pagedoc), 1, 2), chr(10), '|');
----
alpha||beta||H

query I
SELECT replace(duck_blocks_get_pages((SELECT b FROM pagedoc), 3, 3), chr(10), '|');
----
gamma

# DISCRIMINATING, and the whole point of the type: the outline must contain the
# heading and NOT the three pages. An assertion that pages are listed somewhere
# would pass just as well if they were listed in the table of contents, which is
# the defect this replaces.
query I
SELECT count(*) FROM duck_blocks_toc_rows((SELECT b FROM pagedoc));
----
1

# A break with no page_number takes its ordinal position.
query II
SELECT page_number, start_order FROM duck_blocks_page_rows([
  {'kind':'block','element_type':'page_break','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'a','level':1,'encoding':'text','attributes':MAP{},'element_order':1}::duck_block,
  {'kind':'block','element_type':'page_break','content':NULL,'level':1,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block]);
----
1	0
2	2

# Content before the first break belongs to no page: listed with a NULL number so
# it is never invisible, and not selectable by number.
query II
SELECT page_number IS NULL, start_order FROM duck_blocks_page_rows([
  {'kind':'block','element_type':'paragraph','content':'preamble','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block,
  {'kind':'block','element_type':'page_break','content':NULL,'level':1,'encoding':'text','attributes':MAP{'page_number':'1'},'element_order':1}::duck_block,
  {'kind':'block','element_type':'paragraph','content':'p1','level':1,'encoding':'text','attributes':MAP{},'element_order':2}::duck_block])
ORDER BY start_order;
----
true	0
false	1

# A document with NO page_break has no pages -- zero rows, not one implicit page.
# "No page information" is a different fact from "one page", and inventing the
# second would be structure the source never carried.
query I
SELECT count(*) FROM duck_blocks_page_rows([
  {'kind':'block','element_type':'paragraph','content':'only','level':1,'encoding':'text','attributes':MAP{},'element_order':0}::duck_block]);
----
0
