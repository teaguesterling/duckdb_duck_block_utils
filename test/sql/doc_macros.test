# name: test/sql/doc_macros.test
# description: test duck_block_utils unified document and data profiling macros
# group: [sql]

require duck_block_utils

statement ok
INSTALL markdown;

statement ok
LOAD markdown;

statement ok
INSTALL json;

statement ok
LOAD json;

statement ok
PRAGMA duck_block_doc_macros;

# ============================================================================
# doc_toc / doc_section / doc_search -- these take BLOCKS now, not paths.
# Path->blocks routing moved to panduck (read_panduck_doc / panduck_read_blocks);
# this extension is utilities over the vocabulary and no longer reads files.
# ============================================================================

query I
SELECT count(*) > 0 FROM doc_toc(parse_markdown_to_duck_blocks('# A' || chr(10) || chr(10) || '## B'));
----
true

query T
SELECT title FROM doc_toc(parse_markdown_to_duck_blocks('# Overview' || chr(10) || chr(10) || 'body')) WHERE title = 'Overview';
----
Overview

query I
SELECT doc_section(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'body a' || chr(10) || chr(10) || '# B' || chr(10) || chr(10) || 'body b'), 'A')
  LIKE '%body a%';
----
true

# the slice stops at the next same-level heading
query I
SELECT doc_section(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'body a' || chr(10) || chr(10) || '# B' || chr(10) || chr(10) || 'body b'), 'A')
  LIKE '%body b%';
----
false

query I
SELECT count(*) > 0 FROM doc_search(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'findme'), 'findme');
----
true

# doc_search honours output_format now -- the old inlined CASE silently fell
# back to text for md/html/blocks/pandoc
query I
SELECT content LIKE '%<%' FROM doc_search(parse_markdown_to_duck_blocks(
  '# A' || chr(10) || chr(10) || 'findme'), 'findme', output_format := 'html') LIMIT 1;
----
true

# ============================================================================
# profile_table
# ============================================================================

query I
SELECT count(*) FROM profile_table('SELECT 100 AS num, ''val'' AS str');
----
2

# ============================================================================
# doc_render -- one output path, format-specific writers delegated
# md lives in duckdb_markdown, html in webbed. This extension owns only text,
# ansi, blocks and pandoc.
# ============================================================================

query I
SELECT doc_render(parse_markdown_to_duck_blocks('# T'), 'text') LIKE '%T%';
----
true

# md returns MARKDOWN, not pandoc AST JSON as it used to
query I
SELECT doc_render(parse_markdown_to_duck_blocks('# Title'), 'md') LIKE '#%Title%';
----
true

query I
SELECT doc_render(parse_markdown_to_duck_blocks('# Title'), 'md') LIKE '%pandoc-api-version%';
----
false

query I
SELECT doc_render(parse_markdown_to_duck_blocks('# Title'), 'html') LIKE '%<h1%';
----
true

query I
SELECT doc_render(parse_markdown_to_duck_blocks('# Title'), 'pandoc') LIKE '%pandoc-api-version%';
----
true

query I
SELECT doc_render(parse_markdown_to_duck_blocks('# T'), 'ansi') LIKE '%T%';
----
true

statement error
SELECT doc_render(parse_markdown_to_duck_blocks('# T'), 'nonsense');
----
unsupported output_format

# ============================================================================
# Reader dispatch has MOVED TO PANDUCK. These must no longer exist here: this
# extension is utilities over the duck_block vocabulary and does not read files.
# Replacements: read_panduck_doc / panduck_read_blocks / panduck_can_read /
# panduck_supported_paths / panduck_select_blocks.
# ============================================================================

statement error
SELECT doc_to_blocks('README.md');
----
Catalog Error

statement error
SELECT doc_read('README.md');
----
Catalog Error

statement error
SELECT doc_is_supported('a.md');
----
Catalog Error

statement error
SELECT doc_supported_extensions();
----
Catalog Error

statement error
SELECT doc_select('README.md', 'x');
----
Catalog Error

# ...the utilities remain
query I
SELECT count(*) FROM profile_table('SELECT 1 AS a');
----
1

query I
SELECT db_ensure_extension('json');
----
true
