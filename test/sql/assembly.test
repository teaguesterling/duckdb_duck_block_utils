# name: test/sql/assembly.test
# description: test duck_block_utils extension - assembly functions
# group: [duck_block_utils]

require duck_block_utils

# ============================================================================
# db_assemble Tests
# ============================================================================

# Test db_assemble assigns sequential block_order
query I
SELECT db_assemble([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_code('x=1', 'py')
])[1].element_order;
----
0

query I
SELECT db_assemble([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_code('x=1', 'py')
])[2].element_order;
----
1

query I
SELECT db_assemble([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_code('x=1', 'py')
])[3].element_order;
----
2

# Test db_assemble returns same number of blocks
query I
SELECT len(db_assemble([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_code('x=1', 'py')
]));
----
3

# ============================================================================
# db_document Tests (alias for db_assemble)
# ============================================================================

query I
SELECT len(db_document([
    db_heading('Title', 1),
    db_paragraph('Text')
]));
----
2

query I
SELECT db_document([
    db_heading('Title', 1),
    db_paragraph('Text')
])[2].element_order;
----
1

# ============================================================================
# db_section Tests
# ============================================================================

# Test db_section creates heading + children
query I
SELECT len(db_section('Introduction', 2, [
    db_paragraph('First paragraph'),
    db_paragraph('Second paragraph')
]));
----
3

# Test db_section first block is heading
query I
SELECT db_section('Introduction', 2, [db_paragraph('Text')])[1].element_type;
----
heading

query I
SELECT db_section('Introduction', 2, [db_paragraph('Text')])[1].content;
----
Introduction

# Test db_section heading has level in attributes (not level field)
query I
SELECT db_section('Introduction', 2, [db_paragraph('Text')])[1].level IS NULL;
----
true

query I
SELECT db_section('Introduction', 2, [db_paragraph('Text')])[1].attributes['heading_level'];
----
2

# Test db_section children follow heading
query I
SELECT db_section('Introduction', 2, [db_paragraph('First')])[2].element_type;
----
paragraph

query I
SELECT db_section('Introduction', 2, [db_paragraph('First')])[2].content;
----
First

# Test db_section assigns sequential block_order
query I
SELECT db_section('Title', 2, [db_paragraph('A'), db_paragraph('B')])[1].element_order;
----
0

query I
SELECT db_section('Title', 2, [db_paragraph('A'), db_paragraph('B')])[2].element_order;
----
1

query I
SELECT db_section('Title', 2, [db_paragraph('A'), db_paragraph('B')])[3].element_order;
----
2

# Test db_section with no children (2-arg version)
query I
SELECT len(db_section('Just a Heading', 3));
----
1

query I
SELECT db_section('Just a Heading', 3)[1].element_type;
----
heading

# ============================================================================
# db_rebase_levels Tests
# ============================================================================

# Test db_rebase_levels increases heading levels (stored in attributes)
query I
SELECT db_rebase_levels([db_heading('Title', 1)], 1)[1].attributes['heading_level'];
----
2

query I
SELECT db_rebase_levels([db_heading('Title', 2)], 2)[1].attributes['heading_level'];
----
4

# Test db_rebase_levels decreases heading levels
query I
SELECT db_rebase_levels([db_heading('Title', 3)], -1)[1].attributes['heading_level'];
----
2

# Test db_rebase_levels clamps to minimum level 1
query I
SELECT db_rebase_levels([db_heading('Title', 1)], -5)[1].attributes['heading_level'];
----
1

# Test db_rebase_levels clamps to maximum level 6
query I
SELECT db_rebase_levels([db_heading('Title', 5)], 10)[1].attributes['heading_level'];
----
6

# Test db_rebase_levels doesn't affect non-heading blocks
query I
SELECT db_rebase_levels([db_paragraph('Text')], 1)[1].element_type;
----
paragraph

query I
SELECT db_rebase_levels([db_paragraph('Text')], 1)[1].level IS NULL;
----
true

# Test db_rebase_levels with mixed blocks
query I
SELECT len(db_rebase_levels([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_heading('Subtitle', 2)
], 1));
----
3

query I
SELECT db_rebase_levels([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_heading('Subtitle', 2)
], 1)[1].attributes['heading_level'];
----
2

query I
SELECT db_rebase_levels([
    db_heading('Title', 1),
    db_paragraph('Text'),
    db_heading('Subtitle', 2)
], 1)[3].attributes['heading_level'];
----
3

# ============================================================================
# db_concat Tests
# ============================================================================

# Test db_concat combines lists
query I
SELECT len(db_concat(
    [db_heading('A', 1)],
    [db_paragraph('B')]
));
----
2

# Test db_concat preserves original block_order (unlike merge)
query I
SELECT db_concat(
    [db_heading('A', 1)],
    [db_paragraph('B')]
)[1].element_order;
----
0

query I
SELECT db_concat(
    [db_heading('A', 1)],
    [db_paragraph('B')]
)[2].element_order;
----
0

# ============================================================================
# Integration: Building complex documents
# ============================================================================

# Test building a complete document
query I
SELECT len(db_assemble([
    db_metadata('title: My Document'),
    db_heading('Introduction', 1),
    db_paragraph('Welcome to the document.'),
    db_heading('Getting Started', 2),
    db_code('npm install', 'bash'),
    db_paragraph('Now you are ready.'),
    db_hr()
]));
----
7

# Test nested sections with assemble
query I
SELECT len(db_assemble(
    db_concat(
        db_section('Chapter 1', 1, [db_paragraph('Content 1')]),
        db_section('Chapter 2', 1, [db_paragraph('Content 2')])
    )
));
----
4

# Verify structure: heading, para, heading, para
query I
SELECT db_assemble(
    db_concat(
        db_section('Chapter 1', 1, [db_paragraph('Content 1')]),
        db_section('Chapter 2', 1, [db_paragraph('Content 2')])
    )
)[1].element_type;
----
heading

query I
SELECT db_assemble(
    db_concat(
        db_section('Chapter 1', 1, [db_paragraph('Content 1')]),
        db_section('Chapter 2', 1, [db_paragraph('Content 2')])
    )
)[2].element_type;
----
paragraph

query I
SELECT db_assemble(
    db_concat(
        db_section('Chapter 1', 1, [db_paragraph('Content 1')]),
        db_section('Chapter 2', 1, [db_paragraph('Content 2')])
    )
)[3].element_type;
----
heading

# ============================================================================
# Backward Compatibility Tests - reading heading level from level field
# ============================================================================

# Test db_rebase_levels reads from level field when heading_level attribute is not set
# Using duck_block to create a heading with level in the level field (old format)
query I
SELECT db_rebase_levels([
    duck_block('heading', 'Old Format', 2, 'text', MAP{}, 0)
], 1)[1].attributes['heading_level'];
----
3

# Test db_blocks_headings reads from level field when heading_level attribute is not set
query I
SELECT db_blocks_headings([
    duck_block('heading', 'Old Format', 3, 'text', MAP{}, 0)
])[1].level;
----
3

# Test db_blocks_headings prefers heading_level attribute over level field
query I
SELECT db_blocks_headings([
    duck_block('heading', 'New Format', 99, 'text', MAP{'heading_level': '2'}, 0)
])[1].level;
----
2

# ============================================================================
# Integration: Building complex documents
# ============================================================================

# Test rebasing levels in a document merge
query I
SELECT len(db_assemble(
    db_concat(
        [db_heading('Main Doc', 1)],
        db_rebase_levels(
            [db_heading('Subdoc Title', 1), db_paragraph('Subdoc content')],
            1
        )
    )
));
----
3

query I
SELECT db_assemble(
    db_concat(
        [db_heading('Main Doc', 1)],
        db_rebase_levels(
            [db_heading('Subdoc Title', 1), db_paragraph('Subdoc content')],
            1
        )
    )
)[1].attributes['heading_level'];
----
1

query I
SELECT db_assemble(
    db_concat(
        [db_heading('Main Doc', 1)],
        db_rebase_levels(
            [db_heading('Subdoc Title', 1), db_paragraph('Subdoc content')],
            1
        )
    )
)[2].attributes['heading_level'];
----
2
