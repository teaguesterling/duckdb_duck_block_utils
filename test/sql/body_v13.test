# name: test/sql/body_v13.test
# description: spec 1.3 -- the body predicate; metadata is never body, whatever its kind
# group: [sql]

require duck_block_utils

query I
SELECT duck_block_spec_version();
----
1.4

# ---------------------------------------------------------------------------
# 1. the predicate, from the vocabulary header. Over a NON-constant vector: a constant
#    NULL argument is folded away before the function runs, so `f(NULL, 'x')` alone
#    passes against any implementation.
# ---------------------------------------------------------------------------
query III
SELECT k, t, duck_block_is_body(k, t)
FROM (VALUES ('block','paragraph'), ('block','metadata'), ('value','string'), ('inline','text'),
             ('block','raw'), ('block','hr'), ('value','metadata'), (NULL,'paragraph'), ('block',NULL)) v(k, t)
ORDER BY k NULLS FIRST, t NULLS FIRST;
----
NULL	paragraph	NULL
block	NULL	NULL
block	hr	true
block	metadata	false
block	paragraph	true
block	raw	true
inline	text	true
value	metadata	false
value	string	false

# ---------------------------------------------------------------------------
# 2. to_text applies it: a frontmatter blob is in the list and out of the text.
#    The measured leak (2026-09-11) was "title: Secret\n\nH\n\nBody." from exactly this list.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE fm AS SELECT list_concat([
  {'kind':'block','element_type':'metadata','content':'title: Secret','level':1,'encoding':'yaml',
   'attributes':MAP{'role':'frontmatter'}::MAP(VARCHAR,VARCHAR),'element_order':0}::duck_block,
  duck_block_heading('H', 1)], duck_block_paragraph('Body.')) AS bl;

# the blob is still IN the list: to_text drops it from the rendering, not from the data
query I
SELECT list_count(list_filter(bl, lambda b: b.element_type = 'metadata')) FROM fm;
----
1

query II
SELECT duck_blocks_to_match_text(bl), contains(duck_blocks_to_text(bl), 'Secret') FROM fm;
----
H Body.	false

# tailmatter and a kind='value' entry: same answer, both homes are out
query I
SELECT duck_blocks_to_match_text(list_concat(bl, [
  {'kind':'block','element_type':'metadata','content':'k: v','level':1,'encoding':'yaml',
   'attributes':MAP{'role':'tailmatter'}::MAP(VARCHAR,VARCHAR),'element_order':3}::duck_block,
  {'kind':'value','element_type':'string','content':'Author A','level':1,'encoding':'text',
   'attributes':MAP{'key':'author'}::MAP(VARCHAR,VARCHAR),'element_order':4}::duck_block])) FROM fm;
----
H Body.

# negative control: the same TEXT in a paragraph still renders, so the fix keys on the
# element, not on what the content looks like
query I
SELECT duck_blocks_to_match_text(duck_block_paragraph('title: Secret'));
----
title: Secret

# a document that is ONLY a blob (role='document', a .yaml read whole) has no body text
query I
SELECT duck_blocks_to_text([
  {'kind':'block','element_type':'metadata','content':'a: 1','level':1,'encoding':'yaml',
   'attributes':MAP{'role':'document'}::MAP(VARCHAR,VARCHAR),'element_order':0}::duck_block]);
----
(empty)
