# name: test/sql/compact.test
# description: the compact duck_blocks line format -- duck_blocks_to_compact, duck_blocks_from_compact, read_compact_blocks
# group: [sql]

require duck_block_utils

require json

# ---------------------------------------------------------------------------------------
# WHY THIS FORMAT EXISTS, and the rules each section below holds it to.
#
# One JSON object per line, one line per element, in element_order order. Short field
# names (t c l e a m), short type codes, and NULL or default fields left out. Measured on
# 16 panduck fixtures it is 0.52 of pandoc JSON raw and 0.91 with zstd, against 1.68 and
# 1.37 for `COPY ... (FORMAT json)` of the same rows. Design: duckdb_panduck
# docs/superpowers/specs/2026-11-19-compact-blocks-line-format-design.md.
#
#   t  kind + element_type, as one type code     always
#   c  content                                   when not NULL ("" is written)
#   l  level                                     always
#   e  encoding                                  when not 'text'; 'json' is "j"
#   a  known attribute keys, one-letter codes    when the element has one
#   m  every other attribute key, unchanged      when the element has one
#
# element_order is NOT written: the line number, from 0, is the order.
#
# THE FIRST LINE IS A HEADER, not an element: {"@":"<table version>"}. The type and
# attribute code tables are versioned with duck_block_utils, and the header names the
# version of the TABLE a file was written with -- a constant in
# vendor/duck_block_compact.hpp, the duck_block_utils release that last changed the
# tables. It is not the running build's version: panduck writes the same format from the
# vendored header and cannot know that, and both writers must stamp the same thing. A line with "@" and no "t" is a header wherever it
# appears, so concatenated files still read.
#
# TYPE CODES FOLLOW A CONVENTION: a block is UPPERCASE, an inline is lowercase, a value is
# a symbol. A type that is both a block and an inline uses the same letter in both cases
# (C block code, c inline code). Every type in the spec 1.4 vocabulary has a code.

# compact_header(): the exact header this build writes. compact_body(s): the lines after
# the header, with newlines shown as \n, for the exact-output tests below.
statement ok
CREATE MACRO compact_header() AS '{"@":"4.2.0"}' || chr(10);

statement ok
CREATE MACRO compact_body(s) AS replace(s[length(compact_header()) + 1:], chr(10), '\n');

# ---------------------------------------------------------------------------------------
# THE HEADER. It is the first line, it is one JSON object whose only key is "@", and its
# value is the table version.
query II
SELECT starts_with(duck_blocks_to_compact([]::duck_block[]), compact_header()),
       json_keys(rtrim(compact_header(), chr(10)));
----
true	[@]

# ---------------------------------------------------------------------------------------
# THE LINE, exactly. These are the examples in the design note.
query I
SELECT compact_body(duck_blocks_to_compact([
  {'kind':'block','element_type':'heading','content':'Heading Two','level':1,'encoding':'text',
   'attributes':MAP{'heading_level':'2','id':'heading-two'},'element_order':0},
  {'kind':'block','element_type':'paragraph','content':'','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':1},
  {'kind':'inline','element_type':'text','content':'plain','level':2,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':2},
  {'kind':'inline','element_type':'image','content':NULL,'level':3,'encoding':'text',
   'attributes':MAP{'align':'center','src':'cat.png','width':'200px'},'element_order':3}]::duck_block[]));
----
{"t":"H","c":"Heading Two","l":1,"a":{"h":"2","i":"heading-two"}}\n{"t":"P","c":"","l":1}\n{"t":"t","c":"plain","l":2}\n{"t":"g","l":3,"a":{"u":"cat.png"},"m":{"align":"center","width":"200px"}}\n

# Every line ends with a newline, including the last, so files concatenate.
query I
SELECT duck_blocks_to_compact([{'kind':'block','element_type':'hr','content':NULL,'level':1,
  'encoding':'text','attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[])
  = compact_header() || '{"t":"R","l":1}' || chr(10);
----
true

# An empty document is the header alone. It, and the empty string, read back as an
# empty list.
query III
SELECT duck_blocks_to_compact([]::duck_block[]) = compact_header(),
       len(duck_blocks_from_compact(compact_header())), len(duck_blocks_from_compact(''));
----
true	0	0

# ---------------------------------------------------------------------------------------
# NULL CONTENT AND "" STAY DISTINCT. 131 of 1,475 measured rows have NULL content and 232
# have "", so a format that merged them would change real documents.
query III
SELECT b.element_order, b.content IS NULL, b.content
FROM (SELECT unnest(duck_blocks_from_compact(duck_blocks_to_compact([
  {'kind':'block','element_type':'paragraph','content':NULL,'level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0},
  {'kind':'block','element_type':'paragraph','content':'','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':1}]::duck_block[]))) AS b)
ORDER BY 1;
----
0	true	NULL
1	false	(empty)

# ---------------------------------------------------------------------------------------
# CONTENT THAT JSON MUST ESCAPE: a newline (a code block keeps its trailing one), a tab,
# quotes, a backslash, and text outside ASCII. Each line must stay ONE line.
statement ok
CREATE TABLE hard AS SELECT [
  {'kind':'block','element_type':'code','content':'line one' || chr(10) || 'line "two"' || chr(9) || 'tab \ end' || chr(10),
   'level':1,'encoding':'text','attributes':MAP{'language':'py'},'element_order':0},
  {'kind':'inline','element_type':'text','content':'école Ünd — 日本 🦆','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':1}]::duck_block[] AS blocks;

query I
SELECT len(string_split(rtrim(duck_blocks_to_compact(blocks), chr(10)), chr(10))) FROM hard;
----
3

query I
SELECT duck_blocks_from_compact(duck_blocks_to_compact(blocks)) = blocks FROM hard;
----
true

# ---------------------------------------------------------------------------------------
# ENCODING. 'text' is left out, 'json' is "j", and any other encoding is written as it is.
# "t" and "j" are reserved as codes, so an encoding literally named one of them is refused.
query I
SELECT compact_body(duck_blocks_to_compact([
  {'kind':'block','element_type':'table','content':'{"headers":["a"],"rows":[["1"]]}','level':1,'encoding':'json',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0},
  {'kind':'block','element_type':'metadata','content':'a: 1','level':1,'encoding':'yaml',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':1}]::duck_block[]));
----
{"t":"T","c":"{\"headers\":[\"a\"],\"rows\":[[\"1\"]]}","l":1,"e":"j"}\n{"t":"M","c":"a: 1","l":1,"e":"yaml"}\n

statement error
SELECT duck_blocks_to_compact([{'kind':'block','element_type':'raw','content':'x','level':1,
  'encoding':'j','attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[]);
----
reserved

# ---------------------------------------------------------------------------------------
# A TYPE WITH NO CODE is written as kind:element_type and reads back unchanged: here an
# inline caption (panduck emits one; the vocabulary has caption as a block only), and an
# element_type that itself holds a colon.
query I
SELECT compact_body(duck_blocks_to_compact([{'kind':'inline','element_type':'caption','content':'Cap','level':1,
  'encoding':'text','attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[]));
----
{"t":"inline:caption","c":"Cap","l":1}\n

query I
SELECT duck_blocks_from_compact(duck_blocks_to_compact(blocks)) = blocks
FROM (SELECT [
  {'kind':'inline','element_type':'caption','content':'Cap','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0},
  {'kind':'block','element_type':'x:custom','content':NULL,'level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':1}]::duck_block[] AS blocks);
----
true

# A code with no colon that is not in the table is refused, not guessed at.
statement error
SELECT duck_blocks_from_compact('{"t":"zz","l":1}' || chr(10));
----
unknown type code

# Case carries the kind: C is a block code, c is inline code.
query II
SELECT b[1].kind || ':' || b[1].element_type, b[2].kind || ':' || b[2].element_type
FROM (SELECT duck_blocks_from_compact('{"t":"C","l":1}' || chr(10) || '{"t":"c","l":2}' || chr(10)) AS b);
----
block:code	inline:code

# EVERY TYPE IN THE VOCABULARY HAS A CODE: all 21 block, 21 inline and 8 value types are
# written without the kind:element_type escape, and all of them read back unchanged.
# Two types sharing a code would fail the round trip.
statement ok
CREATE TABLE every_type AS
SELECT list({'kind': k, 'element_type': t, 'content': NULL, 'level': 1, 'encoding': 'text',
             'attributes': MAP{}::MAP(VARCHAR, VARCHAR), 'element_order': (n - 1)::INTEGER} ORDER BY n)::duck_block[] AS blocks
FROM (SELECT k, t, row_number() OVER () AS n FROM (VALUES
  ('block','document'),('block','heading'),('block','paragraph'),('block','plain'),('block','code'),
  ('block','blockquote'),('block','list'),('block','list_item'),('block','deflist'),('block','lineblock'),
  ('block','table'),('block','hr'),('block','page_break'),('block','metadata'),('block','image'),
  ('block','raw'),('block','div'),('block','section'),('block','figure'),('block','caption'),
  ('block','generic'),
  ('inline','text'),('inline','space'),('inline','softbreak'),('inline','linebreak'),('inline','code'),
  ('inline','math'),('inline','raw'),('inline','bold'),('inline','italic'),('inline','strikethrough'),
  ('inline','superscript'),('inline','subscript'),('inline','smallcaps'),('inline','underline'),
  ('inline','link'),('inline','image'),('inline','quoted'),('inline','span'),('inline','cite'),
  ('inline','note'),('inline','generic'),
  ('value','string'),('value','bool'),('value','list'),('value','map'),('value','inlines'),
  ('value','blocks'),('value','version'),('value','generic')) v(k, t));

query II
SELECT len(blocks), duck_blocks_from_compact(duck_blocks_to_compact(blocks)) = blocks
FROM every_type;
----
50	true

# The codes themselves, in that order: blocks, then inlines, then values. None is a
# kind:element_type escape.
query I
SELECT string_agg(json_extract_string(line, '$.t'), ' ' ORDER BY n)
FROM (SELECT unnest(string_split(rtrim(duck_blocks_to_compact(blocks), chr(10)), chr(10))[2:]) AS line,
             generate_subscripts(string_split(rtrim(duck_blocks_to_compact(blocks), chr(10)), chr(10))[2:], 1) AS n
      FROM every_type);
----
O H P N C Q L I E B T R K M G W D S F A X t s j r c m w b i k u d z l a g q p e f x $ ? [ { ~ # @ *

# ---------------------------------------------------------------------------------------
# ATTRIBUTES. Known keys go in `a` under their codes; every other key goes in `m`
# unchanged. The two fields are separate, so an unknown key can never collide with a
# code -- even an unknown key that IS a code letter, such as "c" (the code for class).
query I
SELECT compact_body(duck_blocks_to_compact([{'kind':'inline','element_type':'span','content':NULL,'level':1,
  'encoding':'text','attributes':MAP{'c':'unknown-c','class':'note','lang':'fr'},'element_order':0}]::duck_block[]));
----
{"t":"p","l":1,"a":{"c":"note"},"m":{"c":"unknown-c","lang":"fr"}}\n

query I
SELECT duck_blocks_from_compact(duck_blocks_to_compact(blocks)) = blocks
FROM (SELECT [{'kind':'inline','element_type':'span','content':NULL,'level':1,'encoding':'text',
  'attributes':MAP{'c':'unknown-c','class':'note','lang':'fr'},'element_order':0}]::duck_block[] AS blocks);
----
true

# All 21 known keys round-trip through their codes, and every one of them goes in `a`:
# the line has no `m` field. (`m` inside `a` is template_name's code.)
query I
SELECT duck_blocks_from_compact(duck_blocks_to_compact(blocks)) = blocks
FROM (SELECT [{'kind':'block','element_type':'div','content':NULL,'level':1,'encoding':'text',
  'attributes':MAP{'alt':'1','class':'2','execution_count':'3','format':'4','heading_level':'5',
                   'href':'6','id':'7','key':'8','language':'9','link_type':'10','list_type':'11',
                   'number_delim':'12','number_style':'13','ordered':'14','pandoc_ast':'15',
                   'role':'16','source_type':'17','src':'18','start':'19','template_name':'20',
                   'title':'21'},'element_order':0}]::duck_block[] AS blocks);
----
true

query I
SELECT compact_body(duck_blocks_to_compact([{'kind':'block','element_type':'div','content':NULL,'level':1,'encoding':'text',
  'attributes':MAP{'alt':'1','class':'2','execution_count':'3','format':'4','heading_level':'5',
                   'href':'6','id':'7','key':'8','language':'9','link_type':'10','list_type':'11',
                   'number_delim':'12','number_style':'13','ordered':'14','pandoc_ast':'15',
                   'role':'16','source_type':'17','src':'18','start':'19','template_name':'20',
                   'title':'21'},'element_order':0}]::duck_block[])) AS line;
----
{"t":"D","l":1,"a":{"a":"1","c":"2","x":"3","f":"4","h":"5","w":"6","i":"7","k":"8","g":"9","l":"10","t":"11","d":"12","y":"13","o":"14","p":"15","r":"16","s":"17","u":"18","n":"19","m":"20","e":"21"}}\n

# ---------------------------------------------------------------------------------------
# WHAT V1 DOES NOT CARRY is refused, not written as a default: a NULL level, encoding,
# attributes map, or attribute value. None of 1,475 measured rows has one.
statement error
SELECT duck_blocks_to_compact([{'kind':'block','element_type':'paragraph','content':'x','level':NULL,
  'encoding':'text','attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[]);
----
NULL level

statement error
SELECT duck_blocks_to_compact([{'kind':'block','element_type':'paragraph','content':'x','level':1,
  'encoding':NULL,'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[]);
----
NULL encoding

statement error
SELECT duck_blocks_to_compact([{'kind':'block','element_type':'paragraph','content':'x','level':1,
  'encoding':'text','attributes':NULL::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[]);
----
NULL attributes

statement error
SELECT duck_blocks_to_compact([{'kind':'block','element_type':'paragraph','content':'x','level':1,
  'encoding':'text','attributes':MAP{'lang':NULL::VARCHAR},'element_order':0}]::duck_block[]);
----
NULL attribute value

# The refusals live in branches that a valid element never takes. A valid element must
# not trip them (an error() in an untaken CASE branch must not fire).
query I
SELECT len(duck_blocks_to_compact([{'kind':'block','element_type':'paragraph','content':'x','level':1,
  'encoding':'text','attributes':MAP{'lang':'fr'},'element_order':0}]::duck_block[])) > 0;
----
true

# An attribute code the reader does not know is REFUSED, like an unknown type code. A
# newer duck_block_utils may add codes; an older reader that dropped the field would lose
# the attribute with no error, so it stops instead.
statement error
SELECT duck_blocks_from_compact('{"t":"P","c":"x","l":1,"a":{"q":"from-a-newer-table","i":"id1"}}' || chr(10));
----
unknown attribute code

# A line without "l" is refused on read.
statement error
SELECT duck_blocks_from_compact('{"t":"P","c":"x"}' || chr(10));
----
missing level

# ---------------------------------------------------------------------------------------
# ORDER. The writer sorts by element_order; the reader numbers lines 0, 1, 2 ... So gaps
# in the input (read_pandoc_blocks leaves them, duckdb_panduck#206) come back dense, and
# an input given out of order comes back in order.
query II
SELECT b.element_order, b.content
FROM (SELECT unnest(duck_blocks_from_compact(duck_blocks_to_compact([
  {'kind':'block','element_type':'paragraph','content':'third','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':9},
  {'kind':'block','element_type':'paragraph','content':'first','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0},
  {'kind':'block','element_type':'paragraph','content':'second','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':3}]::duck_block[]))) AS b);
----
0	first
1	second
2	third

# ---------------------------------------------------------------------------------------
# REAL DOCUMENTS. Three of the 16 measured fixtures, as `COPY ... (FORMAT json)` wrote them
# from duckdb_panduck's readers: an RST file, an EPUB whose headings nest in sections (so a
# heading's level and its heading_level differ), and a notebook. Each round-trips exactly,
# and each file has one line per element plus the header.
statement ok
CREATE TABLE fixtures AS
SELECT parse_filename(filename) AS name,
       list(struct_pack(kind, element_type, content, level, encoding, attributes, element_order)
            ORDER BY element_order)::duck_block[] AS blocks
FROM read_json('test/fixtures/compact/*.blocks.jsonl', format := 'newline_delimited', filename := true,
  columns := {kind: 'VARCHAR', element_type: 'VARCHAR', content: 'VARCHAR', level: 'INTEGER',
              encoding: 'VARCHAR', attributes: 'MAP(VARCHAR, VARCHAR)', element_order: 'INTEGER'})
GROUP BY filename;

query IIII
SELECT name, len(blocks),
       len(string_split(rtrim(duck_blocks_to_compact(blocks), chr(10)), chr(10))),
       duck_blocks_from_compact(duck_blocks_to_compact(blocks)) = blocks
FROM fixtures ORDER BY name;
----
constructs.rst.blocks.jsonl	49	50	true
notebook.ipynb.blocks.jsonl	18	19	true
pandoc.epub.blocks.jsonl	24	25	true

# The output is a conforming duck_block list.
query II
SELECT name, (duck_blocks_validate(duck_blocks_from_compact(duck_blocks_to_compact(blocks)))).valid
FROM fixtures ORDER BY name;
----
constructs.rst.blocks.jsonl	true
notebook.ipynb.blocks.jsonl	true
pandoc.epub.blocks.jsonl	true

# ---------------------------------------------------------------------------------------
# A FILE. Written with COPY, read with read_compact_blocks. The reader numbers lines
# itself, so the order cannot depend on how DuckDB schedules the scan: 4,000 elements are
# read with 8 threads.
statement ok
SET threads = 8;

statement ok
CREATE TABLE big AS
SELECT list({'kind':'block','element_type':'paragraph','content':'p' || i::VARCHAR,'level':1,'encoding':'text',
             'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':i::INTEGER} ORDER BY i)::duck_block[] AS blocks
FROM range(4000) t(i);

statement ok
COPY (SELECT duck_blocks_to_compact(blocks) FROM big)
TO '{TEST_DIR}/big.compact.jsonl' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query III
SELECT count(*), count(*) FILTER (WHERE content = 'p' || element_order::VARCHAR), max(element_order)
FROM read_compact_blocks('{TEST_DIR}/big.compact.jsonl');
----
4000	4000	3999

# The rows are the seven canonical fields and then `filename` (spec 6.4), so list(b)
# binds as a duck_block list.
query I
SELECT list(b ORDER BY b.element_order)::duck_block[] = (SELECT blocks FROM big)
FROM (SELECT kind, element_type, content, level, encoding, attributes, element_order
      FROM read_compact_blocks('{TEST_DIR}/big.compact.jsonl')) b;
----
true

query I
SELECT column_name FROM (DESCRIBE SELECT * FROM read_compact_blocks('{TEST_DIR}/big.compact.jsonl'));
----
kind
element_type
content
level
encoding
attributes
element_order
filename

# ---------------------------------------------------------------------------------------
# A GLOB reads each file on its own: element_order restarts at 0 in every file, and the
# rows come grouped by filename.
statement ok
COPY (SELECT rtrim(duck_blocks_to_compact([
  {'kind':'block','element_type':'paragraph','content':'a0','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0},
  {'kind':'block','element_type':'paragraph','content':'a1','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':1}]::duck_block[]), chr(10)))
TO '{TEST_DIR}/glob_a.compact.jsonl' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement ok
COPY (SELECT rtrim(duck_blocks_to_compact([
  {'kind':'block','element_type':'paragraph','content':'b0','level':1,'encoding':'text',
   'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[]), chr(10)))
TO '{TEST_DIR}/glob_b.compact.jsonl' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query III
SELECT parse_filename(filename), element_order, content
FROM read_compact_blocks('{TEST_DIR}/glob_*.compact.jsonl');
----
glob_a.compact.jsonl	0	a0
glob_a.compact.jsonl	1	a1
glob_b.compact.jsonl	0	b0

# CONCATENATED output reads as one document: the second header is skipped, and the
# numbering runs on across it.
query I
SELECT array_to_string(list_transform(duck_blocks_from_compact(
  duck_blocks_to_compact([{'kind':'block','element_type':'paragraph','content':'one','level':1,'encoding':'text',
    'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[])
  || duck_blocks_to_compact([{'kind':'block','element_type':'paragraph','content':'two','level':1,'encoding':'text',
    'attributes':MAP{}::MAP(VARCHAR, VARCHAR),'element_order':0}]::duck_block[])),
  lambda b: b.element_order || ':' || b.content), ' ');
----
0:one 1:two

# ---------------------------------------------------------------------------------------
# ATTRIBUTE KEYS COME BACK SORTED. `a` and `m` are two objects, so the format cannot keep
# the source's key order across them; the reader sorts instead. DuckDB compares MAPs in
# key order (MAP{'b':'1','a':'2'} = MAP{'a':'2','b':'1'} is false), so an element whose
# map was NOT sorted reads back as the sorted map, not as itself.
query II
SELECT b.attributes::VARCHAR,
       b.attributes = MAP{'class':'x', 'lang':'fr', 'zeta':'1'}
FROM (SELECT unnest(duck_blocks_from_compact(duck_blocks_to_compact([
  {'kind':'inline','element_type':'span','content':NULL,'level':1,'encoding':'text',
   'attributes':MAP{'zeta':'1', 'class':'x', 'lang':'fr'},'element_order':0}]::duck_block[]))) AS b);
----
{class=x, lang=fr, zeta=1}	true

# ---------------------------------------------------------------------------------------
# A BUILDER'S BLOCK IS WRITABLE. The legacy duck_block_heading(content, level) returned a
# NULL level, so the writer refused it (#87).
query I
SELECT duck_blocks_to_compact([duck_block_heading('Intro', 1)]) = compact_header() || '{"t":"H","c":"Intro","l":1,"a":{"h":"1"}}' || chr(10);
----
true

# ---------------------------------------------------------------------------------------
# SCALE. The reader must STREAM: its cost grows with the file, not with the square of it.
# The first reader was a scalar macro whose body was a subquery; given a column (as
# read_compact_blocks gave it read_text's content), DuckDB ran it as a correlated
# subquery. Measured: 3,888 elements took 2.2 s, and 15,552 elements ran out of memory
# at 16 GB. No reader may hold more than a small multiple of the file in memory, so
# these run under a 500 MB limit. The document is the three fixtures repeated, so it has
# attributes on most elements -- the 4,000-paragraph test above has none and passed.
statement ok
CREATE TABLE scale AS
SELECT list(struct_pack(kind, element_type, content, level, encoding, attributes,
                        element_order := o::INTEGER) ORDER BY o)::duck_block[] AS blocks
FROM (SELECT f.*, row_number() OVER (ORDER BY r.range, f.name, f.element_order) - 1 AS o
      FROM (SELECT parse_filename(filename) AS name, *
            FROM read_json('test/fixtures/compact/*.blocks.jsonl', format := 'newline_delimited', filename := true,
              columns := {kind: 'VARCHAR', element_type: 'VARCHAR', content: 'VARCHAR', level: 'INTEGER',
                          encoding: 'VARCHAR', attributes: 'MAP(VARCHAR, VARCHAR)', element_order: 'INTEGER'})) f,
           range(170) r);

statement ok
COPY (SELECT rtrim(duck_blocks_to_compact(blocks), chr(10)) FROM scale)
TO '{TEST_DIR}/scale.compact.jsonl' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement ok
CREATE TABLE scale_text AS SELECT duck_blocks_to_compact(blocks) AS c FROM scale;

statement ok
SET memory_limit = '500MB';

query II
SELECT count(*), list(b ORDER BY b.element_order)::duck_block[] = (SELECT blocks FROM scale)
FROM (SELECT kind, element_type, content, level, encoding, attributes, element_order
      FROM read_compact_blocks('{TEST_DIR}/scale.compact.jsonl')) b;
----
15470	true

# The scalar reader on a COLUMN, the shape that was correlated.
query II
SELECT len(duck_blocks_from_compact(c)), duck_blocks_from_compact(c) = (SELECT blocks FROM scale) FROM scale_text;
----
15470	true

# The writer on a column, at the same size.
query I
SELECT duck_blocks_to_compact(blocks) = (SELECT c FROM scale_text) FROM scale;
----
true

statement ok
RESET memory_limit;

# ---------------------------------------------------------------------------------------
# A GLOB AT SCALE keeps each file's own order. Each file restarts at 0 and its rows come
# back in file order -- checked by content, which records each element's true position.
statement ok
COPY (SELECT rtrim(duck_blocks_to_compact(list({'kind':'block','element_type':'paragraph','content':'big_a:' || i::VARCHAR,
  'level':1,'encoding':'text','attributes':MAP{'id':'a' || i::VARCHAR},'element_order':i::INTEGER} ORDER BY i)::duck_block[]), chr(10))
  FROM range(30000) t(i))
TO '{TEST_DIR}/big_a.compact.jsonl' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement ok
COPY (SELECT rtrim(duck_blocks_to_compact(list({'kind':'block','element_type':'paragraph','content':'big_b:' || i::VARCHAR,
  'level':1,'encoding':'text','attributes':MAP{'id':'b' || i::VARCHAR},'element_order':i::INTEGER} ORDER BY i)::duck_block[]), chr(10))
  FROM range(20000) t(i))
TO '{TEST_DIR}/big_b.compact.jsonl' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement ok
SET threads = 8;

query II
SELECT count(*),
       count(*) FILTER (WHERE content <> split_part(parse_filename(filename), '.', 1) || ':' || element_order::VARCHAR)
FROM read_compact_blocks('{TEST_DIR}/big_*.compact.jsonl');
----
50000	0

# ---------------------------------------------------------------------------------------
# ORDER RESTS ON preserve_insertion_order. read_compact_blocks numbers lines in the order
# DuckDB's scan returns them, which is file order only while preserve_insertion_order is
# on (the default). With it off, the reader refuses rather than misnumber.
statement ok
SET preserve_insertion_order = false;

statement error
SELECT count(*) FROM read_compact_blocks('{TEST_DIR}/big_a.compact.jsonl');
----
preserve_insertion_order

statement ok
RESET preserve_insertion_order;

# ---------------------------------------------------------------------------------------
# THE GOLDEN CORPUS (test/fixtures/compact/golden). Every implementation of the format
# must agree on it: these SQL macros, and the C++ codec in vendor/duck_block_compact.hpp
# that duckdb_panduck vendors. duck_block_utils never calls the C++ codec, so these files
# are what ties the two together; panduck's tests read the same files.
#
# Each <name>.dblocks reads to exactly the rows in <name>.expected.jsonl, and those rows
# write back to the .dblocks byte for byte.
statement ok
CREATE TABLE golden AS
SELECT split_part(parse_filename(filename), '.expected', 1) AS name,
       list(struct_pack(kind, element_type, content, level, encoding, attributes, element_order)
            ORDER BY element_order)::duck_block[] AS blocks
FROM read_json(['test/fixtures/compact/golden/constructs.rst.expected.jsonl',
                'test/fixtures/compact/golden/every_type.expected.jsonl',
                'test/fixtures/compact/golden/hard.expected.jsonl',
                'test/fixtures/compact/golden/notebook.ipynb.expected.jsonl',
                'test/fixtures/compact/golden/pandoc.epub.expected.jsonl'], format := 'newline_delimited', filename := true,
  columns := {kind: 'VARCHAR', element_type: 'VARCHAR', content: 'VARCHAR', level: 'INTEGER',
              encoding: 'VARCHAR', attributes: 'MAP(VARCHAR, VARCHAR)', element_order: 'INTEGER'})
GROUP BY filename;

# read_compact_blocks takes literal paths only (read_json does), so all five files are
# read in one call and matched to their expected rows by name.
statement ok
CREATE TABLE golden_read AS
SELECT split_part(parse_filename(filename), '.dblocks', 1) AS name,
       list(struct_pack(kind, element_type, content, level, encoding, attributes, element_order)
            ORDER BY element_order)::duck_block[] AS blocks
FROM read_compact_blocks(['test/fixtures/compact/golden/constructs.rst.dblocks',
                          'test/fixtures/compact/golden/every_type.dblocks',
                          'test/fixtures/compact/golden/hard.dblocks',
                          'test/fixtures/compact/golden/notebook.ipynb.dblocks',
                          'test/fixtures/compact/golden/pandoc.epub.dblocks'])
GROUP BY filename;

statement ok
CREATE TABLE golden_text AS
SELECT split_part(parse_filename(filename), '.dblocks', 1) AS name, content
FROM read_text(['test/fixtures/compact/golden/constructs.rst.dblocks',
                'test/fixtures/compact/golden/every_type.dblocks',
                'test/fixtures/compact/golden/hard.dblocks',
                'test/fixtures/compact/golden/notebook.ipynb.dblocks',
                'test/fixtures/compact/golden/pandoc.epub.dblocks']);

query IIII
SELECT g.name, len(g.blocks), r.blocks = g.blocks, duck_blocks_to_compact(g.blocks) = t.content
FROM golden g JOIN golden_read r USING (name) JOIN golden_text t USING (name) ORDER BY 1;
----
constructs.rst	49	true	true
every_type	50	true	true
hard	10	true	true
notebook.ipynb	18	true	true
pandoc.epub	24	true	true

# A file whose maps were NOT key-sorted when written reads to SORTED rows, so it is only
# read: writing the rows back gives the sorted order, not these bytes.
query I
SELECT (SELECT list(struct_pack(kind, element_type, content, level, encoding, attributes, element_order)
                    ORDER BY element_order)::duck_block[]
        FROM read_compact_blocks('test/fixtures/compact/golden/read_only_unsorted_keys.dblocks'))
     = (SELECT list(struct_pack(kind, element_type, content, level, encoding, attributes, element_order)
                    ORDER BY element_order)::duck_block[]
        FROM read_json('test/fixtures/compact/golden/read_only_unsorted_keys.expected.jsonl', format := 'newline_delimited',
          columns := {kind: 'VARCHAR', element_type: 'VARCHAR', content: 'VARCHAR', level: 'INTEGER',
                      encoding: 'VARCHAR', attributes: 'MAP(VARCHAR, VARCHAR)', element_order: 'INTEGER'}));
----
true

query I
SELECT string_agg(element_order || ':' || content, ' ' ORDER BY element_order)
FROM read_compact_blocks('test/fixtures/compact/golden/concat.dblocks');
----
0:one 1:two

